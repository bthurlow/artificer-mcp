{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/minimax/hailuo-2.3/pro/text-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/minimax/hailuo-2.3/pro/text-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/minimax/hailuo-2.3/pro/text-to-video",
