  "info": {
    "title": "Queue OpenAPI for fal-ai/inworld-tts",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/inworld-tts queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/inworld-tts",
      "category": "text-to-speech",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9207aa/h8_GEg6YVVRdB1ne848S5_0f9db25aa60c48e692aa3193466d0c7c.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/inworld-tts",
