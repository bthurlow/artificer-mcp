        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "sample_rate_hertz": {
            "title": "Sample Rate Hertz",
            "description": "The sample rate in Hz for the output audio.",
            "enum": [
              8000,
              16000,
              24000,
              32000,
              40000,
              48000
            ],
            "type": "integer",
            "default": 48000
          },
          "text": {
            "title": "Text",
            "description": "The text to synthesize into speech. Maximum 2000 characters.",
            "type": "string",
            "examples": [
              "Hello! This is a demo of Inworld's TTS."
            ],
            "maxLength": 2000
          },
