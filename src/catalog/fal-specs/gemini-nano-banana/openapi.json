      "playgroundUrl": "https://fal.ai/models/fal-ai/nano-banana-2",
      "documentationUrl": "https://fal.ai/models/fal-ai/nano-banana-2/api",
      "about": "Gemini 3.1 Flash Image is a text-to-image model that generates images from text descriptions."
    }
  },
  "components": {
