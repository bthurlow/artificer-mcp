          "sync_mode",
          "system_prompt",
          "resolution",
          "limit_generations",
          "enable_web_search",
          "enable_image_search"
        ],
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "NanoBanana2TextToImageInput"
