          "description"
        ],
        "title": "MaiImage25ProTextToImageOutput",
        "properties": {
          "images": {
            "description": "The generated images.",
            "type": "array",
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "The description of the generated images."
          }
        }
      },
      "ImageFile": {
        "required": [
