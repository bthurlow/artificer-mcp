        ],
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "num_images",
          "aspect_ratio",
          "output_format",
          "sync_mode"
        ],
        "properties": {
          "output_format": {
            "title": "Output Format",
            "description": "The format of the generated image.",
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png"
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "type": "string",
            "description": "The aspect ratio of the generated image. Use \"auto\" to let the model decide based on the prompt.",
            "enum": [
              "auto",
              "1:1",
              "4:3",
              "3:4",
              "16:9",
              "9:16",
              "3:2",
              "2:3"
            ],
            "default": "auto"
          },
          "num_images": {
            "title": "Number of Images",
            "minimum": 1,
            "type": "integer",
            "maximum": 4,
            "description": "The number of images to generate.",
            "default": 1
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false
          },
          "prompt": {
            "title": "Prompt",
            "description": "The text prompt to generate an image from.",
            "examples": [
              "A photorealistic concept-art poster of a university campus at sunset, cinematic lighting, a banner reading \"LOUISVILLE\" in bold serif type."
            ],
            "maxLength": 5000,
            "minLength": 3,
            "type": "string"
          }
        }
      },
