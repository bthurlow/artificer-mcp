      "endpointId": "microsoft/mai-image-2.5-pro",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa418a3/FMiWrcYSkRy51M57u7TtL.jpg",
      "playgroundUrl": "https://fal.ai/models/microsoft/mai-image-2.5-pro",
      "documentationUrl": "https://fal.ai/models/microsoft/mai-image-2.5-pro/api",
      "about": "Generate an image from a text prompt with MAI-Image-2.5 Pro."
    }
  },
