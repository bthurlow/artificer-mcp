{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for google/gemini-omni-flash/v1.1/reference-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the google/gemini-omni-flash/v1.1/reference-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "google/gemini-omni-flash/v1.1/reference-to-video",
      "category": "image-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa7d03a/HppeV9Qlias-2csW09e9s.jpg",
      "playgroundUrl": "https://fal.ai/models/google/gemini-omni-flash/v1.1/reference-to-video",
      "documentationUrl": "https://fal.ai/models/google/gemini-omni-flash/v1.1/reference-to-video/api",
      "about": "Reference To Video"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "GeminiOmniFlashV11ReferenceToVideoInput": {
        "title": "Omni11FlashReferenceToVideoInput",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "title": "Prompt",
            "description": "The text prompt describing the video. Reference media is sent in list order before the prompt.",
            "examples": [
              "A cat inspired by <IMAGE_REF_0> walks through the setting in <VIDEO_REF_0>."
            ],
            "type": "string",
            "maxLength": 20000
          },
          "reference_video_urls": {
            "items": {
              "type": "string"
            },
            "title": "Reference Video URLs",
            "description": "URLs of up to three reference videos. Each video must be at most three seconds long.",
            "type": "array",
            "maxItems": 3
          },
          "duration": {
            "title": "Duration",
            "maximum": 10,
            "description": "The duration of the generated video, in seconds.",
            "default": 8,
            "type": "integer",
            "minimum": 3
          },
          "aspect_ratio": {
            "enum": [
              "16:9",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "default": "16:9",
            "description": "The aspect ratio of the generated video.",
            "type": "string"
          },
          "resolution": {
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k"
            ],
            "title": "Resolution",
            "default": "720p",
            "description": "The resolution of the generated video.",
            "type": "string"
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "title": "Image URLs",
            "description": "URLs of reference images to incorporate into the video.",
            "type": "array",
            "maxItems": 10
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_urls",
          "reference_video_urls",
          "aspect_ratio",
          "resolution",
          "duration"
        ]
      },
      "GeminiOmniFlashV11ReferenceToVideoOutput": {
        "title": "VideoOutput",
        "required": [
          "video"
        ],
        "properties": {
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video."
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "File": {
        "title": "File",
        "type": "object",
        "properties": {
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/google/gemini-omni-flash/v1.1/reference-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/google/gemini-omni-flash/v1.1/reference-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/google/gemini-omni-flash/v1.1/reference-to-video": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmniFlashV11ReferenceToVideoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/google/gemini-omni-flash/v1.1/reference-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeminiOmniFlashV11ReferenceToVideoOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
