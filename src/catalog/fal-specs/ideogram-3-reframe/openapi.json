{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ideogram/v3/reframe",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ideogram/v3/reframe queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ideogram/v3/reframe",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91b5/UMfZEO-26SBc2j_rn6AiG_pNsWS6uZ.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ideogram/v3/reframe",
      "documentationUrl": "https://fal.ai/models/fal-ai/ideogram/v3/reframe/api",
      "about": "Ideogram V3 Reframe"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "IdeogramV3ReframeInput": {
        "x-fal-order-properties": [
          "image_urls",
          "rendering_speed",
          "color_palette",
          "style_codes",
          "style",
          "num_images",
          "seed",
          "sync_mode",
          "style_preset",
          "image_url",
          "image_size",
          "enable_safety_checker"
        ],
        "properties": {
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for the random number generator"
          },
          "image_size": {
            "description": "The resolution for the reframed output image",
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              }
            ],
            "examples": [
              "square_hd"
            ]
          },
          "style_preset": {
            "title": "Style Preset",
            "anyOf": [
              {
                "enum": [
                  "80S_ILLUSTRATION",
                  "90S_NOSTALGIA",
                  "ABSTRACT_ORGANIC",
                  "ANALOG_NOSTALGIA",
                  "ART_BRUT",
                  "ART_DECO",
                  "ART_POSTER",
                  "AURA",
                  "AVANT_GARDE",
                  "BAUHAUS",
                  "BLUEPRINT",
                  "BLURRY_MOTION",
                  "BRIGHT_ART",
                  "C4D_CARTOON",
                  "CHILDRENS_BOOK",
                  "COLLAGE",
                  "COLORING_BOOK_I",
                  "COLORING_BOOK_II",
                  "CUBISM",
                  "DARK_AURA",
                  "DOODLE",
                  "DOUBLE_EXPOSURE",
                  "DRAMATIC_CINEMA",
                  "EDITORIAL",
                  "EMOTIONAL_MINIMAL",
                  "ETHEREAL_PARTY",
                  "EXPIRED_FILM",
                  "FLAT_ART",
                  "FLAT_VECTOR",
                  "FOREST_REVERIE",
                  "GEO_MINIMALIST",
                  "GLASS_PRISM",
                  "GOLDEN_HOUR",
                  "GRAFFITI_I",
                  "GRAFFITI_II",
                  "HALFTONE_PRINT",
                  "HIGH_CONTRAST",
                  "HIPPIE_ERA",
                  "ICONIC",
                  "JAPANDI_FUSION",
                  "JAZZY",
                  "LONG_EXPOSURE",
                  "MAGAZINE_EDITORIAL",
                  "MINIMAL_ILLUSTRATION",
                  "MIXED_MEDIA",
                  "MONOCHROME",
                  "NIGHTLIFE",
                  "OIL_PAINTING",
                  "OLD_CARTOONS",
                  "PAINT_GESTURE",
                  "POP_ART",
                  "RETRO_ETCHING",
                  "RIVIERA_POP",
                  "SPOTLIGHT_80S",
                  "STYLIZED_RED",
                  "SURREAL_COLLAGE",
                  "TRAVEL_POSTER",
                  "VINTAGE_GEO",
                  "VINTAGE_POSTER",
                  "WATERCOLOR",
                  "WEIRD",
                  "WOODBLOCK_PRINT"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Style preset for generation. The chosen style preset will guide the generation."
          },
          "sync_mode": {
            "title": "Sync Mode",
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history."
          },
          "rendering_speed": {
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "title": "Rendering Speed",
            "default": "BALANCED",
            "type": "string",
            "description": "The rendering speed to use."
          },
          "num_images": {
            "title": "Num Images",
            "maximum": 8,
            "default": 1,
            "minimum": 1,
            "type": "integer",
            "description": "Number of images to generate."
          },
          "color_palette": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ColorPalette"
              },
              {
                "type": "null"
              }
            ],
            "description": "A color palette for generation, must EITHER be specified via one of the presets (name) or explicitly via hexadecimal representations of the color with optional weights (members)"
          },
          "style_codes": {
            "title": "Style Codes",
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A list of 8 character hexadecimal codes representing the style of the image. Cannot be used in conjunction with style_reference_images or style"
          },
          "style": {
            "title": "Style",
            "anyOf": [
              {
                "enum": [
                  "AUTO",
                  "GENERAL",
                  "REALISTIC",
                  "DESIGN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The style type to generate with. Cannot be used with style_codes."
          },
          "image_urls": {
            "title": "Image Urls",
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A set of images to use as style references (maximum total size 10MB across all style references). The images should be in JPEG, PNG or WebP format"
          },
          "image_url": {
            "description": "The image URL to reframe",
            "title": "Image URL",
            "type": "string",
            "examples": [
              "https://v3.fal.media/files/lion/0qJs_qW8nz0wYsXhFa6Tk.png"
            ]
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean",
            "description": "Authorized callers may set false to request relaxed screening."
          }
        },
        "required": [
          "image_url",
          "image_size"
        ],
        "type": "object",
        "title": "ReframeImageInputV3"
      },
      "IdeogramV3ReframeOutput": {
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "properties": {
          "seed": {
            "description": "Seed used for the random number generator",
            "title": "Seed",
            "type": "integer",
            "examples": [
              123456
            ]
          },
          "images": {
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array",
            "examples": [
              [
                {
                  "url": "https://v3.fal.media/files/zebra/LVW4AhVs3sCxsVKdg3EfT_image.png"
                }
              ]
            ]
          }
        },
        "required": [
          "images",
          "seed"
        ],
        "type": "object",
        "title": "ReframeOutputV3"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "title": "Width",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer",
            "description": "The width of the generated image."
          },
          "height": {
            "title": "Height",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer",
            "description": "The height of the generated image."
          }
        },
        "type": "object",
        "title": "ImageSize"
      },
      "ColorPalette": {
        "x-fal-order-properties": [
          "members",
          "name"
        ],
        "properties": {
          "name": {
            "title": "Name",
            "anyOf": [
              {
                "enum": [
                  "EMBER",
                  "FRESH",
                  "JUNGLE",
                  "MAGIC",
                  "MELON",
                  "MOSAIC",
                  "PASTEL",
                  "ULTRAMARINE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A color palette preset value"
          },
          "members": {
            "title": "Members",
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ColorPaletteMember"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "A list of color palette members that define the color palette"
          }
        },
        "type": "object",
        "title": "ColorPalette"
      },
      "File": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "File"
      },
      "ColorPaletteMember": {
        "x-fal-order-properties": [
          "rgb",
          "color_weight"
        ],
        "properties": {
          "color_weight": {
            "title": "Color Weight",
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0.05,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 0.5,
            "description": "The weight of the color in the color palette"
          },
          "rgb": {
            "$ref": "#/components/schemas/RGBColor",
            "description": "RGB color value for the palette member"
          }
        },
        "required": [
          "rgb"
        ],
        "type": "object",
        "title": "ColorPaletteMember"
      },
      "RGBColor": {
        "x-fal-order-properties": [
          "r",
          "g",
          "b"
        ],
        "properties": {
          "b": {
            "title": "B",
            "maximum": 255,
            "default": 0,
            "minimum": 0,
            "type": "integer",
            "description": "Blue color value"
          },
          "g": {
            "title": "G",
            "maximum": 255,
            "default": 0,
            "minimum": 0,
            "type": "integer",
            "description": "Green color value"
          },
          "r": {
            "title": "R",
            "maximum": 255,
            "default": 0,
            "minimum": 0,
            "type": "integer",
            "description": "Red color value"
          }
        },
        "type": "object",
        "title": "RGBColor"
      }
    }
  },
  "paths": {
    "/fal-ai/ideogram/v3/reframe/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/ideogram/v3/reframe/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/ideogram/v3/reframe": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeogramV3ReframeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/ideogram/v3/reframe/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeogramV3ReframeOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
