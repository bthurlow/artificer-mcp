{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2/klein/9b/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2/klein/9b/edit queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2/klein/9b/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8a7f50/X8ffS5h55gcigsNZoNC7O_52e6b383ac214d2abe0a2e023f03de88.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit/api",
      "about": "Image editing with FLUX.2 [klein] 9B distilled model. Fast 4-step editing."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2Klein9bEditInput": {
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "num_inference_steps",
          "image_size",
          "num_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_urls"
        ],
        "properties": {
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI. Output is not stored when this is True.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          },
          "prompt": {
            "description": "The prompt to edit the image.",
            "type": "string",
            "examples": [
              "Turn this into a realistic image"
            ],
            "title": "Prompt"
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker"
          },
          "num_inference_steps": {
            "minimum": 4,
            "description": "The number of inference steps to perform.",
            "maximum": 8,
            "type": "integer",
            "default": 4,
            "title": "Number of Inference Steps"
          },
          "num_images": {
            "minimum": 1,
            "description": "The number of images to generate.",
            "maximum": 4,
            "type": "integer",
            "default": 1,
            "title": "Number of Images"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The seed to use for the generation. If not provided, a random seed will be used.",
            "title": "Seed"
          },
          "image_urls": {
            "description": "The URLs of the images for editing. A maximum of 4 images are allowed.",
            "type": "array",
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8a69d5/kkXxFfj1QeVtw35kxy5Py_1a7e3511-bd2c-46be-923a-8e6be2496f12.png"
              ]
            ],
            "title": "Image URLs",
            "items": {
              "type": "string"
            }
          },
          "image_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the generated image. If not provided, uses the input image size.",
            "examples": [
              {
                "width": 2016,
                "height": 1152
              }
            ],
            "title": "Image Size"
          },
          "output_format": {
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "type": "string",
            "default": "png",
            "title": "Output Format"
          }
        },
        "type": "object",
        "required": [
          "prompt",
          "image_urls"
        ],
        "title": "KleinDistilledEditInput"
      },
      "Flux2Klein9bEditOutput": {
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer",
            "title": "Seed"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "type": "string",
            "title": "Prompt"
          },
          "has_nsfw_concepts": {
            "description": "Whether the generated images contain NSFW concepts.",
            "type": "array",
            "items": {
              "type": "boolean"
            },
            "title": "Has Nsfw Concepts"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings"
          },
          "images": {
            "description": "The generated images",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "title": "KleinT2IOutput"
      },
      "ImageSize": {
        "properties": {
          "width": {
            "title": "Width",
            "default": 512,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The width of the generated image."
          },
          "height": {
            "title": "Height",
            "default": 512,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The height of the generated image."
          }
        },
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "ImageFile": {
        "required": [
          "url"
        ],
        "title": "ImageFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          }
        }
      }
    }
  },
  "paths": {
