{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2/klein/9b/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2/klein/9b/edit queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2/klein/9b/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8a7f50/X8ffS5h55gcigsNZoNC7O_52e6b383ac214d2abe0a2e023f03de88.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit/api",
      "about": "Image editing with FLUX.2 [klein] 9B distilled model. Fast 4-step editing."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2Klein9bEditInput": {
        "title": "KleinDistilledEditInput",
        "required": [
          "prompt",
          "image_urls"
        ],
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "num_inference_steps",
          "image_size",
          "num_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_urls"
        ],
        "properties": {
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "default": true,
            "type": "boolean"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI. Output is not stored when this is True.",
            "default": false,
            "type": "boolean"
          },
          "num_inference_steps": {
            "title": "Number of Inference Steps",
            "minimum": 4,
            "maximum": 8,
            "default": 4,
            "description": "The number of inference steps to perform.",
            "type": "integer"
          },
          "num_images": {
            "title": "Number of Images",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "The number of images to generate.",
            "type": "integer"
          },
          "seed": {
            "title": "Seed",
            "description": "The seed to use for the generation. If not provided, a random seed will be used.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "description": "The URLs of the images for editing. A maximum of 4 images are allowed.",
            "title": "Image URLs",
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8a69d5/kkXxFfj1QeVtw35kxy5Py_1a7e3511-bd2c-46be-923a-8e6be2496f12.png"
              ]
            ],
            "type": "array"
          },
          "image_size": {
            "title": "Image Size",
            "description": "The size of the generated image. If not provided, uses the input image size.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              {
                "height": 1152,
                "width": 2016
              }
            ]
          },
          "output_format": {
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png",
            "description": "The format of the generated image.",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The prompt to edit the image.",
            "examples": [
              "Turn this into a realistic image"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Flux2Klein9bEditOutput": {
        "title": "KleinT2IOutput",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts",
            "type": "array"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "description": "The generated images",
            "title": "Images",
            "type": "array"
          },
          "timings": {
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "seed": {
            "title": "Seed",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The prompt used for generating the image.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ImageSize": {
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "title": "Height",
            "description": "The height of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "description": "The width of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ImageFile": {
        "title": "ImageFile",
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "title": "Height",
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "paths": {
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Flux2Klein9bEditInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flux2Klein9bEditOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
