{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2/klein/9b/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2/klein/9b/edit queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2/klein/9b/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8a7f50/X8ffS5h55gcigsNZoNC7O_52e6b383ac214d2abe0a2e023f03de88.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/edit/api",
      "about": "Image editing with FLUX.2 [klein] 9B distilled model. Fast 4-step editing."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2Klein9bEditInput": {
        "required": [
          "prompt",
          "image_urls"
        ],
        "properties": {
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "default": true,
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "num_inference_steps": {
            "description": "The number of inference steps to perform.",
            "default": 4,
            "title": "Number of Inference Steps",
            "minimum": 4,
            "type": "integer",
            "maximum": 8
          },
          "image_urls": {
            "description": "The URLs of the images for editing. A maximum of 4 images are allowed.",
            "title": "Image URLs",
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8a69d5/kkXxFfj1QeVtw35kxy5Py_1a7e3511-bd2c-46be-923a-8e6be2496f12.png"
              ]
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "num_images": {
            "description": "The number of images to generate.",
            "default": 1,
            "title": "Number of Images",
            "minimum": 1,
            "type": "integer",
            "maximum": 4
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI. Output is not stored when this is True.",
            "default": false,
            "title": "Sync Mode",
            "type": "boolean"
          },
          "image_size": {
            "description": "The size of the generated image. If not provided, uses the input image size.",
            "examples": [
              {
                "width": 2016,
                "height": 1152
              }
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Size"
          },
          "output_format": {
            "description": "The format of the generated image.",
            "default": "png",
            "title": "Output Format",
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          },
          "prompt": {
            "description": "The prompt to edit the image.",
            "title": "Prompt",
            "examples": [
              "Turn this into a realistic image"
            ],
            "type": "string"
          },
          "seed": {
            "description": "The seed to use for the generation. If not provided, a random seed will be used.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "KleinDistilledEditInput",
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "num_inference_steps",
          "image_size",
          "num_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_urls"
        ],
        "type": "object"
      },
      "Flux2Klein9bEditOutput": {
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "has_nsfw_concepts": {
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts",
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "title": "Prompt",
            "type": "string"
          },
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "title": "Seed",
            "type": "integer"
          },
          "images": {
            "description": "The generated images",
            "title": "Images",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          }
        },
        "title": "KleinT2IOutput",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 512,
            "description": "The width of the generated image.",
            "title": "Width",
            "maximum": 14142
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 512,
            "description": "The height of the generated image.",
            "title": "Height",
            "maximum": 14142
          }
        },
        "title": "ImageSize"
      },
      "ImageFile": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "description": "The width of the image",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "height": {
            "description": "The height of the image",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ImageFile"
      }
    }
  },
  "paths": {
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Flux2Klein9bEditInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/klein/9b/edit/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flux2Klein9bEditOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
