{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for topaz/upscale/image/creative",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the topaz/upscale/image/creative queue.",
    "x-fal-metadata": {
      "endpointId": "topaz/upscale/image/creative",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5f513/Og4D-4MnoSPwUpoHem_jr.jpg",
      "playgroundUrl": "https://fal.ai/models/topaz/upscale/image/creative",
      "documentationUrl": "https://fal.ai/models/topaz/upscale/image/creative/api",
      "about": "# Topaz Creative Image Upscale (Bloom)\n\nCreative upscaling that transforms AI-generated images while adding\ndetail.\n\n## Models\n- **Bloom** — creative upscaling for AI-generated images.\n- **Bloom Realism** — realistic detail enhancement for AI images."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "UpscaleImageCreativeInput": {
        "x-fal-order-properties": [
          "image_url",
          "model",
          "upscale_factor",
          "autoprompt",
          "creativity",
          "color_preservation",
          "crop_to_fill",
          "output_format",
          "enable_safety_checker"
        ],
        "type": "object",
        "required": [
          "image_url"
        ],
        "properties": {
          "color_preservation": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preserve the source image's colors in the output. Applies to Bloom 2 only.",
            "title": "Color Preservation"
          },
          "output_format": {
            "default": "jpeg",
            "type": "string",
            "description": "Output format of the upscaled image.",
            "enum": [
              "jpeg",
              "png"
            ],
            "title": "Output Format"
          },
          "upscale_factor": {
            "type": "number",
            "description": "Factor to upscale the image by (e.g. 2.0 doubles width and height)",
            "maximum": 4,
            "default": 2,
            "minimum": 1,
            "title": "Upscale Factor"
          },
          "creativity": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer",
                "maximum": 9
              },
              {
                "type": "null"
              }
            ],
            "description": "Creativity level (1-9). Higher values produce more creative/hallucinated details. Applies to Bloom 2 only.",
            "title": "Creativity"
          },
          "autoprompt": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Enable automatic prompt generation. Applies to Bloom 2 only; Topaz defaults it to true when omitted.",
            "title": "Autoprompt"
          },
          "enable_safety_checker": {
            "default": true,
            "type": "boolean",
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker"
          },
          "model": {
            "default": "Bloom 2",
            "type": "string",
            "description": "Creative (Bloom) upscaling model. Bloom 2 is the latest and most capable; Bloom creatively upscales and transforms AI-generated images; Bloom Realism biases the added detail toward photorealism.",
            "enum": [
              "Bloom 2",
              "Bloom",
              "Bloom Realism"
            ],
            "title": "Model"
          },
          "image_url": {
            "minLength": 1,
            "description": "Url of the image to be upscaled",
            "type": "string",
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/codeformer/codeformer_poor_1.jpeg"
            ],
            "title": "Image Url"
          },
          "crop_to_fill": {
            "default": false,
            "type": "boolean",
            "title": "Crop To Fill"
          }
        },
        "title": "ImageCreativeUpscaleRequest"
      },
      "UpscaleImageCreativeOutput": {
        "x-fal-order-properties": [
          "image"
        ],
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "description": "The upscaled image.",
            "$ref": "#/components/schemas/File"
          }
        },
        "title": "ImageUpscaleOutput"
      },
      "File": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          }
        },
        "title": "File"
      }
    }
  },
  "paths": {
    "/topaz/upscale/image/creative/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/creative/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/creative": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpscaleImageCreativeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/creative/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpscaleImageCreativeOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
