{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/krea-2/turbo",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/krea-2/turbo queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/krea-2/turbo",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9ec8c9/8GzWPYzjnpIp9l_nVysti_51daab936c734a849698a7fee8718d5e.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/krea-2/turbo",
      "documentationUrl": "https://fal.ai/models/fal-ai/krea-2/turbo/api",
      "about": "Generate an image with the distilled Krea 2 turbo checkpoint."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Krea2TurboInput": {
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "image_size",
          "num_images",
          "acceleration",
          "enable_prompt_expansion",
          "sync_mode",
          "enable_safety_checker",
          "output_format"
        ],
        "required": [
          "prompt"
        ],
        "properties": {
          "enable_prompt_expansion": {
            "description": "If true, the prompt is expanded with an LLM into a more detailed image-generation prompt for higher quality results. On failure, the original prompt is used unchanged.",
            "type": "boolean",
            "default": false,
            "title": "Enable Prompt Expansion"
          },
          "seed": {
            "description": "Random seed for reproducible generation. Image *i* uses `seed + i`.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "image_size": {
            "description": "The size of the generated image.",
            "default": "square_hd",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "title": "Image Size"
          },
          "num_images": {
            "maximum": 4,
            "minimum": 1,
            "description": "The number of images to generate.",
            "type": "integer",
            "default": 1,
            "title": "Number of Images"
          },
          "enable_safety_checker": {
            "description": "If true, the output safety checker is enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker"
          },
          "output_format": {
            "description": "The format of the generated image. Default value: \"png\".",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ],
            "title": "Output Format",
            "default": "png"
          },
          "prompt": {
            "minLength": 1,
            "description": "Base text description of the image to generate.",
            "type": "string",
            "title": "Prompt",
            "maxLength": 5000,
            "examples": [
              "a vintage travel poster for Mars"
            ]
          },
          "acceleration": {
            "description": "The acceleration level to use for the image generation.",
            "type": "string",
            "enum": [
              "none",
              "regular"
            ],
            "title": "Acceleration",
            "default": "none"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          }
        },
        "type": "object",
        "title": "Krea2Input"
      },
      "Krea2TurboOutput": {
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt",
          "actual_prompt"
        ],
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "images": {
            "description": "The generated images.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images"
          },
          "actual_prompt": {
            "description": "The final prompt after expansion, if prompt expansion was enabled.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Prompt"
          },
          "seed": {
            "description": "The seed used to generate the image(s).",
            "type": "integer",
            "title": "Seed",
            "examples": [
              12345
            ]
          },
          "prompt": {
            "description": "The prompt used for generation.",
            "type": "string",
            "title": "Prompt"
          },
          "has_nsfw_concepts": {
            "description": "Whether each generated image contains NSFW concepts.",
            "type": "array",
            "items": {
              "type": "boolean"
            },
            "title": "Has Nsfw Concepts"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Timing information for the request, in seconds.",
            "type": "object",
            "title": "Timings"
          }
        },
        "type": "object",
        "title": "Krea2Output"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "maximum": 14142,
            "description": "The height of the generated image.",
            "type": "integer",
            "default": 512,
            "title": "Height",
            "exclusiveMinimum": 0
          },
          "width": {
            "maximum": 14142,
            "description": "The width of the generated image.",
            "type": "integer",
            "default": 512,
            "title": "Width",
            "exclusiveMinimum": 0
          }
        },
        "type": "object",
        "title": "ImageSize"
      },
      "ImageFile": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "height": {
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "width": {
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "type": "object",
        "title": "ImageFile"
      }
    }
  },
  "paths": {
    "/fal-ai/krea-2/turbo/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/krea-2/turbo/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/krea-2/turbo": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Krea2TurboInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/krea-2/turbo/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Krea2TurboOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
