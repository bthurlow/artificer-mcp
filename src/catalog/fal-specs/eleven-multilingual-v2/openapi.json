{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/elevenlabs/tts/multilingual-v2",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/elevenlabs/tts/multilingual-v2 queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/elevenlabs/tts/multilingual-v2",
      "category": "text-to-audio",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91b4/QzoZAeoc-h1TLhttOaE7K_jZHvV4ZG.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/elevenlabs/tts/multilingual-v2",
      "documentationUrl": "https://fal.ai/models/fal-ai/elevenlabs/tts/multilingual-v2/api",
      "about": "ElevenLabs Multilingual v2 model for text-to-speech generation.\n\nExcels in stability, language diversity, and accent accuracy.\nSupports 29 languages with high-quality, natural-sounding voices."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "ElevenlabsTtsMultilingualV2Input": {
        "properties": {
          "apply_text_normalization": {
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "description": "This parameter controls text normalization with three modes: 'auto', 'on', and 'off'. When set to 'auto', the system will automatically decide whether to apply text normalization (e.g., spelling out numbers). With 'on', text normalization will always be applied, while with 'off', it will be skipped.",
            "default": "auto",
            "type": "string",
            "title": "Apply Text Normalization"
          },
          "timestamps": {
            "description": "Whether to return timestamps for each word in the generated speech",
            "default": false,
            "type": "boolean",
            "title": "Timestamps"
          },
          "style": {
            "title": "Style",
            "description": "Style exaggeration (0-1)",
            "maximum": 1,
            "default": 0,
            "type": "number",
            "minimum": 0
          },
          "stability": {
            "title": "Stability",
            "description": "Voice stability (0-1)",
            "maximum": 1,
            "default": 0.5,
            "type": "number",
            "minimum": 0
          },
          "text": {
            "minLength": 1,
            "description": "The text to convert to speech",
            "examples": [
              "Hello! This is a test of the text to speech system, powered by ElevenLabs. How does it sound?"
            ],
            "type": "string",
            "title": "Text"
          },
          "language_code": {
            "title": "Language Code",
            "description": "Language code (ISO 639-1) used to enforce a language for the model. An error will be returned if language code is not supported by the model.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_text": {
            "title": "Previous Text",
            "description": "The text that came before the text of the current request. Can be used to improve the speech's continuity when concatenating together multiple generations or to influence the speech's continuity in the current generation.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "similarity_boost": {
            "title": "Similarity Boost",
            "description": "Similarity boost (0-1)",
            "maximum": 1,
            "default": 0.75,
            "type": "number",
            "minimum": 0
          },
          "speed": {
            "title": "Speed",
            "description": "Speech speed (0.7-1.2). Values below 1.0 slow down the speech, above 1.0 speed it up. Extreme values may affect quality.",
            "maximum": 1.2,
            "default": 1,
            "type": "number",
            "minimum": 0.7
          },
          "next_text": {
            "title": "Next Text",
            "description": "The text that comes after the text of the current request. Can be used to improve the speech's continuity when concatenating together multiple generations or to influence the speech's continuity in the current generation.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voice": {
            "description": "The voice to use for speech generation",
            "default": "Rachel",
            "examples": [
              "Aria",
              "Roger",
              "Sarah",
              "Laura",
              "Charlie",
              "George",
              "Callum",
              "River",
              "Liam",
              "Charlotte",
              "Alice",
              "Matilda",
              "Will",
              "Jessica",
              "Eric",
              "Chris",
              "Brian",
              "Daniel",
              "Lily",
              "Bill"
            ],
            "type": "string",
            "title": "Voice"
          }
        },
        "x-fal-order-properties": [
          "text",
          "voice",
          "stability",
          "similarity_boost",
          "style",
          "speed",
          "timestamps",
          "previous_text",
          "next_text",
          "language_code",
          "apply_text_normalization"
        ],
        "required": [
          "text"
        ],
        "type": "object",
        "title": "TextToSpeechRequest"
      },
      "ElevenlabsTtsMultilingualV2Output": {
        "properties": {
          "timestamps": {
            "title": "Timestamps",
            "description": "Timestamps for each word in the generated speech. Only returned if `timestamps` is set to True in the request.",
            "anyOf": [
              {
                "type": "array",
                "items": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "audio": {
            "description": "The generated audio file",
            "$ref": "#/components/schemas/File",
            "examples": [
              {
                "url": "https://v3.fal.media/files/zebra/zJL_oRY8h5RWwjoK1w7tx_output.mp3"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "audio",
          "timestamps"
        ],
        "required": [
          "audio"
        ],
        "type": "object",
        "title": "TTSOutput"
      },
      "File": {
        "properties": {
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ],
        "type": "object",
        "title": "File"
      }
    }
  },
  "paths": {
    "/fal-ai/elevenlabs/tts/multilingual-v2/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/multilingual-v2/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/multilingual-v2": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElevenlabsTtsMultilingualV2Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/multilingual-v2/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElevenlabsTtsMultilingualV2Output"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
