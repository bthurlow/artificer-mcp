            "title": "Sync Mode",
            "default": false,
            "type": "boolean",
            "description": "If true, returns the image directly in the response (increases latency)."
          },
          "instruction": {
            "title": "Instruction",
            "examples": [
              "Uncross her arms and place the serum bottle in her right hand raised beside her face, label toward the camera."
