{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-22b/distilled/text-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-22b/distilled/text-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-22b/distilled/text-to-video",
      "category": "text-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9289be/bEbjXj3FMaublu4e4WsLD__tmp_b006-ice--samurai-helm.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/text-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/text-to-video/api",
      "about": "Generate a video from a text prompt using distilled LoRA."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx2322bDistilledTextToVideoInput": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "LTX23DistilledTextToVideoInput",
        "properties": {
          "camera_lora_scale": {
            "minimum": 0,
            "description": "The scale of the camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "maximum": 1,
            "type": "number",
            "default": 1,
            "title": "Camera LoRA Scale"
          },
          "prompt": {
            "examples": [
              "A cowboy walking through a dusty town at high noon, camera following from behind, cinematic depth, realistic lighting, western mood, 4K film grain."
            ],
            "description": "The prompt to generate the video from.",
            "type": "string",
            "title": "Prompt"
          },
          "video_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "description": "The size of the generated video.",
            "default": "landscape_16_9",
            "title": "Video Size"
          },
          "seed": {
            "description": "The seed for the random number generator.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "negative_prompt": {
            "description": "The negative prompt to generate the video from.",
            "type": "string",
            "default": "news broadcast, 3d animation, computer graphics, pc game, console game, video game, cartoon, childish, watermark, logo, text, on screen text, subtitles, titles, signature, slowmo, static",
            "title": "Negative Prompt"
          },
          "enable_safety_checker": {
            "description": "Whether to enable the safety checker.",
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker"
          },
          "distill_lora_second_pass_scale": {
            "minimum": 0,
            "description": "The scale of the distill LoRA to use for the second and subsequent passes.",
            "maximum": 1,
            "type": "number",
            "default": 0.5,
            "title": "Distill Lora Second Pass Scale"
          },
          "camera_lora": {
            "examples": [
              "none"
            ],
            "description": "The camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "type": "string",
            "default": "none",
            "enum": [
              "dolly_in",
              "dolly_out",
              "dolly_left",
              "dolly_right",
              "jib_up",
              "jib_down",
              "static",
              "none"
            ],
            "title": "Camera LoRA"
          },
          "acceleration": {
            "examples": [
              "none"
            ],
            "description": "The acceleration level to use.",
            "type": "string",
            "default": "none",
            "enum": [
              "none",
              "regular",
              "high",
              "full"
            ],
            "title": "Acceleration"
          },
          "video_output_type": {
            "description": "The output type of the generated video.",
            "type": "string",
            "default": "X264 (.mp4)",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
            ],
            "title": "Video Output Type"
          },
          "generate_audio": {
            "type": "boolean",
            "description": "Whether to generate audio for the video.",
            "default": true,
            "title": "Generate Audio"
          },
          "video_write_mode": {
            "description": "The write mode of the generated video.",
            "type": "string",
            "default": "balanced",
            "enum": [
              "fast",
              "balanced",
              "small"
            ],
            "title": "Video Write Mode"
          },
          "enable_prompt_expansion": {
            "description": "Whether to enable prompt expansion.",
            "type": "boolean",
            "default": true,
            "title": "Enable Prompt Expansion"
          },
          "num_frames": {
            "minimum": 9,
            "description": "The number of frames to generate.",
            "maximum": 481,
            "type": "integer",
            "default": 121,
            "title": "Number of Frames"
          },
          "video_quality": {
            "description": "The quality of the generated video.",
            "type": "string",
            "default": "high",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "title": "Video Quality"
          },
          "scheduler": {
            "examples": [
              "ltx2"
            ],
            "description": "The scheduler to use.",
            "type": "string",
            "default": "ltx2",
            "enum": [
              "ltx2",
              "linear_quadratic",
              "beta"
            ],
            "title": "Scheduler"
          },
          "use_multiscale": {
            "type": "boolean",
            "description": "Whether to use multi-scale generation. If True, the model will generate the video at a smaller scale first, then use the smaller video to guide the generation of a video at or above your requested size. This results in better coherence and details.",
            "default": true,
            "title": "Use Multi-Scale"
          },
          "fps": {
            "minimum": 1,
            "description": "The frames per second of the generated video.",
            "maximum": 60,
            "type": "number",
            "default": 24,
            "title": "FPS"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "num_frames",
          "video_size",
          "generate_audio",
          "use_multiscale",
          "fps",
          "scheduler",
          "acceleration",
          "camera_lora",
          "camera_lora_scale",
          "negative_prompt",
          "seed",
          "enable_prompt_expansion",
          "enable_safety_checker",
          "video_output_type",
          "video_quality",
          "video_write_mode",
          "sync_mode",
          "distill_lora_second_pass_scale"
        ]
      },
      "Ltx2322bDistilledTextToVideoOutput": {
        "type": "object",
        "required": [
          "video",
          "seed",
          "prompt"
        ],
        "title": "LTX23TextToVideoOutput",
        "properties": {
          "video": {
            "examples": [
              {
                "duration": 6.44,
                "content_type": "video/mp4",
                "url": "https://v3b.fal.media/files/b/0a8824b1/sdm0KfmenrlywesfzY1Y1_if6euPp1.mp4",
                "num_frames": 161,
                "file_name": "sdm0KfmenrlywesfzY1Y1_if6euPp1.mp4",
                "width": 1248,
                "height": 704,
                "fps": 25
              }
            ],
            "description": "The generated video.",
            "$ref": "#/components/schemas/VideoFile"
          },
          "seed": {
            "examples": [
              149063119
            ],
            "description": "The seed used for the random number generator.",
            "type": "integer",
            "title": "Seed"
          },
          "prompt": {
            "examples": [
              "A cowboy walking through a dusty town at high noon, camera following from behind, cinematic depth, realistic lighting, western mood, 4K film grain."
            ],
            "description": "The prompt used for the generation.",
            "type": "string",
            "title": "Prompt"
          }
        },
        "x-fal-order-properties": [
          "video",
          "seed",
          "prompt"
        ]
      },
      "ImageSize": {
        "type": "object",
        "title": "ImageSize",
        "properties": {
          "height": {
            "exclusiveMinimum": 0,
            "description": "The height of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "default": 512,
            "title": "Height"
          },
          "width": {
            "exclusiveMinimum": 0,
            "description": "The width of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "default": 512,
            "title": "Width"
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "VideoFile": {
        "type": "object",
        "required": [
          "url"
        ],
        "title": "VideoFile",
        "properties": {
          "duration": {
            "description": "The duration of the video",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "num_frames": {
            "description": "The number of frames in the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Num Frames"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "width": {
            "description": "The width of the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "description": "The height of the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "fps": {
            "description": "The FPS of the video",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
