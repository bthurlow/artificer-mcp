                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ]
          },
          "video_write_mode": {
            "description": "The write mode of the generated video.",
            "title": "Video Write Mode",
            "type": "string",
            "default": "balanced",
            "enum": [
              "fast",
              "balanced",
              "small"
            ]
          }
