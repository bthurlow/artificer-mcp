{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for alibaba/qwen-image-3/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the alibaba/qwen-image-3/edit queue.",
    "x-fal-metadata": {
      "endpointId": "alibaba/qwen-image-3/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa32168/Sh5wWmoqniWOUsvLNk1Qu.jpg",
      "playgroundUrl": "https://fal.ai/models/alibaba/qwen-image-3/edit",
      "documentationUrl": "https://fal.ai/models/alibaba/qwen-image-3/edit/api",
      "about": "Edit images using Qwen Image 3 Pro."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "QwenImage3EditInput": {
        "required": [
          "prompt",
          "image_urls"
        ],
        "properties": {
          "image_urls": {
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8bf01f/TUehdcnBygWa1-SnEbp3K_image_123.png"
              ]
            ],
            "description": "Reference images for editing (1-3 images required). Order matters: reference as 'image 1', 'image 2', 'image 3' in prompt. Resolution: 384-2048px each dimension. Max size: 10MB each. Formats: JPEG, JPG, PNG (no alpha), WEBP.",
            "type": "array",
            "title": "Image Urls",
            "items": {
              "type": "string"
            }
          },
          "image_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Size",
            "description": "The size of the generated image. If not provided, the model determines the resolution automatically. Total number of pixels must be between 512x512 and 2048x2048."
          },
          "negative_prompt": {
            "examples": [
              "low resolution, error, worst quality, low quality, deformed"
            ],
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Negative Prompt",
            "description": "Content to avoid in the generated image. Max 500 characters."
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker",
            "description": "Enable content moderation for input and output. Disabling it requires account authorization; unauthorized requests are always checked."
          },
          "prompt": {
            "maxLength": 5000,
            "examples": [
              "Change the wolves into extremely realistic small puppies of different colors."
            ],
            "type": "string",
            "minLength": 1,
            "title": "Prompt",
            "description": "Text prompt describing the desired edit. Supports Chinese and English. Max 5000 characters."
          },
          "enable_prompt_expansion": {
            "default": true,
            "title": "Enable Prompt Expansion",
            "type": "boolean",
            "description": "Enable automatic LLM prompt rewriting for better results."
          },
          "output_format": {
            "type": "string",
            "default": "png",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "title": "Output Format",
            "description": "The format of the generated image."
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed for reproducibility (0-2147483647)."
          },
          "sync_mode": {
            "type": "boolean",
            "default": false,
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history."
          },
          "num_images": {
            "description": "The number of images to generate.",
            "minimum": 1,
            "type": "integer",
            "default": 1,
            "title": "Num Images",
            "maximum": 6
          }
        },
        "type": "object",
        "title": "QwenImage3EditInput",
        "x-fal-order-properties": [
          "prompt",
          "negative_prompt",
          "image_size",
          "enable_prompt_expansion",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "num_images",
          "output_format",
          "image_urls"
        ],
        "description": "Input for Qwen Image 3 image editing with reference images."
      },
      "QwenImage3EditOutput": {
        "required": [
          "images",
          "seed"
        ],
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "title": "QwenImage3EditOutput",
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8bf01f/5ZVeoOz6DtJUq6-f4SIsc_WawZPkPJ.png"
                }
              ]
            ],
            "description": "Generated images.",
            "type": "array",
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "seed": {
            "examples": [
              42
            ],
            "type": "integer",
            "title": "Seed",
            "description": "The seed used for generation."
          }
        }
      },
      "ImageSize": {
        "type": "object",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "title": "ImageSize",
        "properties": {
          "width": {
            "maximum": 14142,
            "type": "integer",
            "default": 512,
            "title": "Width",
            "exclusiveMinimum": 0,
            "description": "The width of the generated image."
          },
          "height": {
            "maximum": 14142,
            "type": "integer",
            "default": 512,
            "title": "Height",
            "exclusiveMinimum": 0,
            "description": "The height of the generated image."
          }
        }
      },
      "File": {
        "required": [
          "url"
        ],
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "title": "File",
        "properties": {
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          }
        }
      }
    }
  },
  "paths": {
    "/alibaba/qwen-image-3/edit/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/alibaba/qwen-image-3/edit/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alibaba/qwen-image-3/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QwenImage3EditInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/alibaba/qwen-image-3/edit/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QwenImage3EditOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
