{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for meta/muse-image/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the meta/muse-image/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "meta/muse-image/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa743db/nScihj1tWzLbmaEA3mKE2.jpg",
      "playgroundUrl": "https://fal.ai/models/meta/muse-image/text-to-image",
      "documentationUrl": "https://fal.ai/models/meta/muse-image/text-to-image/api",
      "about": "Generate"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "MuseImageTextToImageInput": {
        "properties": {
          "num_images": {
            "minimum": 1,
            "title": "Num Images",
            "description": "The number of images to generate.",
            "maximum": 10,
            "type": "integer",
            "default": 1
          },
          "output_format": {
            "title": "Output Format",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "type": "string",
            "default": "webp"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the image is returned as a data URI and is not persisted in the request history.",
            "type": "boolean",
            "default": false
          },
          "prompt": {
            "title": "Prompt",
            "description": "The text prompt used to generate or edit the image.",
            "minLength": 1,
            "type": "string",
            "examples": [
              "A cinematic editorial portrait in soft window light with crisp typography"
            ]
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "description": "Any custom output aspect ratio as \"width:height\", for example \"16:9\", \"5:4\", or \"1920:1200\". Common presets are \"21:9\", \"16:9\", \"4:3\", \"3:2\", \"1:1\", \"2:3\", \"3:4\", \"9:16\", \"9:21\". The ratio must be between 1:16 and 16:1, the range Muse supports. Only the ratio is used: Muse renders it at its own fixed resolution of roughly 2.5 megapixels, so \"1920:1200\" and \"960:600\" both return the same 1920x1200 image. If omitted, Muse chooses the output dimensions automatically.",
            "anyOf": [
              {
                "pattern": "^[1-9][0-9]{0,4}:[1-9][0-9]{0,4}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "16:9"
            ]
          }
        },
        "title": "MuseImageInput",
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "num_images",
          "output_format",
          "sync_mode"
        ],
        "type": "object",
        "required": [
          "prompt"
        ]
      },
      "MuseImageTextToImageOutput": {
        "properties": {
          "images": {
            "title": "Images",
            "description": "The generated or edited images.",
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          }
        },
        "title": "MuseImageOutput",
        "x-fal-order-properties": [
          "images"
        ],
        "type": "object",
        "required": [
          "images"
        ]
      },
      "Image": {
        "title": "Image",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image in pixels.",
            "examples": [
              1024
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image in pixels.",
            "examples": [
              1024
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ]
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          }
        },
        "type": "object",
        "description": "Represents an image file.",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/meta/muse-image/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/meta/muse-image/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/meta/muse-image/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MuseImageTextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/meta/muse-image/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuseImageTextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
