{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for blackforestlabs/flux-video-upscale",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the blackforestlabs/flux-video-upscale queue.",
    "x-fal-metadata": {
      "endpointId": "blackforestlabs/flux-video-upscale",
      "category": "video-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa7182f/Frq0vrwqyitVDqknXCE-t.jpg",
      "playgroundUrl": "https://fal.ai/models/blackforestlabs/flux-video-upscale",
      "documentationUrl": "https://fal.ai/models/blackforestlabs/flux-video-upscale/api",
      "about": "Upscale"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "FluxVideoUpscaleInput": {
        "properties": {
          "creativity": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "title": "Creativity",
            "description": "Use 0 for a source-faithful upscale or 1 for creative detail enhancement.",
            "default": 1
          },
          "safety_tolerance": {
            "minimum": 0,
            "maximum": 4,
            "title": "Safety Tolerance",
            "type": "integer",
            "description": "Moderation strictness. Lower values are stricter.",
            "default": 2
          },
          "upscale_factor": {
            "minimum": 1.5,
            "maximum": 3,
            "title": "Upscale Factor",
            "type": "number",
            "description": "Output scaling factor. The source aspect ratio is preserved.",
            "default": 2
          },
          "video_url": {
            "type": "string",
            "title": "Video Url",
            "examples": [
              "https://v3b.fal.media/files/b/0a93a27d/-iFpecUCsSdwXVMevsZa3_output_5s_448x256.mp4"
            ],
            "description": "URL of the MP4 video to upscale. The video must be at most 20 seconds and 50 MB."
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "Optional description used to guide creative detail enhancement."
          }
        },
        "type": "object",
        "required": [
          "video_url"
        ],
        "title": "FluxVideoUpscaleInput",
        "x-fal-order-properties": [
          "video_url",
          "upscale_factor",
          "creativity",
          "prompt",
          "safety_tolerance"
        ]
      },
      "FluxVideoUpscaleOutput": {
        "properties": {
          "video": {
            "description": "The upscaled MP4 video.",
            "$ref": "#/components/schemas/File"
          }
        },
        "type": "object",
        "required": [
          "video"
        ],
        "title": "FluxVideoUpscaleOutput",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "File": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "File",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      }
    }
  },
  "paths": {
    "/blackforestlabs/flux-video-upscale/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/blackforestlabs/flux-video-upscale/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/blackforestlabs/flux-video-upscale": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FluxVideoUpscaleInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/blackforestlabs/flux-video-upscale/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FluxVideoUpscaleOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
