{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/z-image/turbo/tiling",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/z-image/turbo/tiling queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/z-image/turbo/tiling",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a927a27/SYJj76y2BxFpBc6ySx7uj_5d9c07ca565e4fe6bdef800c186c176b.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/z-image/turbo/tiling",
      "documentationUrl": "https://fal.ai/models/fal-ai/z-image/turbo/tiling/api",
      "about": "Generate seamlessly tileable textures using Z-Image Turbo."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "ZImageTurboTilingInput": {
        "title": "ZImageTurboTilingInput",
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_inference_steps",
          "seed",
          "sync_mode",
          "num_images",
          "enable_safety_checker",
          "output_format",
          "acceleration",
          "enable_prompt_expansion",
          "image_url",
          "mask_image_url",
          "strength",
          "tile_size",
          "tile_stride",
          "tiling_mode"
        ],
        "properties": {
          "enable_safety_checker": {
            "type": "boolean",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "title": "Enable Safety Checker",
            "default": true
          },
          "image_size": {
            "description": "The size of the generated image. Use 'auto' to match the input image size (or 1024x1024 if no image).",
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ],
                "type": "string"
              }
            ],
            "default": "square_hd"
          },
          "enable_prompt_expansion": {
            "type": "boolean",
            "description": "Whether to enable prompt expansion. Note: this will increase the price by 0.0025 credits per request.",
            "title": "Enable Prompt Expansion",
            "default": false
          },
          "tile_stride": {
            "type": "integer",
            "multipleOf": 2,
            "description": "Tile stride in latent space. Must be even (divisible by 2). Automatically capped to half the effective tile size. (32 = 256px, 64 = 512px, 128 = 1024px).",
            "maximum": 128,
            "title": "Tile Stride",
            "minimum": 16,
            "default": 64
          },
          "output_format": {
            "type": "string",
            "description": "The format of the generated image.",
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png"
          },
          "seed": {
            "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same image every time.\n        ",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "tile_size": {
            "type": "integer",
            "multipleOf": 2,
            "description": "Tile size in latent space. Must be even (divisible by 2) for patchification. Automatically capped to the generated image dimensions on tiled axes. (64 = 512px, 128 = 1024px, 256 = 2048px).",
            "maximum": 256,
            "title": "Tile Size",
            "minimum": 32,
            "default": 128
          },
          "image_url": {
            "description": "URL of an image for image-to-image or inpainting. When provided without mask_image_url, performs image-to-image; with mask_image_url, performs inpainting.",
            "title": "Image URL",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "examples": [
              "A hyper-realistic, high-resolution 4k texture of an ancient weathered brick wall heavily overgrown with lush green moss and soft lichens. The bricks are aged, featuring deep earthy tones, natural cracks, and gritty textures. Vibrant emerald moss fills the mortar lines and spills over the rough surfaces of the stones. Uniform, flat cinematic lighting ensures no harsh shadows, highlighting the intricate organic details and damp stone surfaces. The composition is a perfectly balanced overhead view, showcasing a rich tapestry of botanical growth and masonry craftsmanship with professional clarity and hyper-detailed grit."
            ],
            "description": "The prompt to generate an image from.",
            "title": "Prompt",
            "type": "string"
          },
          "num_inference_steps": {
            "type": "integer",
            "description": "The number of inference steps to perform.",
            "maximum": 8,
            "title": "Number of Inference Steps",
            "minimum": 1,
            "default": 8
          },
          "acceleration": {
            "type": "string",
            "description": "The acceleration level to use.",
            "title": "Acceleration",
            "enum": [
              "none",
              "regular",
              "high"
            ],
            "default": "regular"
          },
          "mask_image_url": {
            "description": "URL of a mask image for inpainting. White regions are regenerated, black regions are preserved. Requires image_url.",
            "title": "Mask Image URL",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "tiling_mode": {
            "enum": [
              "both",
              "horizontal",
              "vertical"
            ],
            "description": "Tiling direction: 'both' (omnidirectional), 'horizontal' (left-right only), 'vertical' (top-bottom only).",
            "type": "string",
            "title": "Tiling Mode",
            "default": "both"
          },
          "num_images": {
            "type": "integer",
            "description": "The number of images to generate.",
            "maximum": 4,
            "title": "Number of Images",
            "minimum": 1,
            "default": 1
          },
          "sync_mode": {
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "default": false
          },
          "strength": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How much to transform the input image. Only used when image_url is provided.",
            "maximum": 1,
            "title": "Strength",
            "default": 0.6
          }
        },
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "ZImageTurboTilingOutput": {
        "title": "ZImageTurboTilingOutput",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "seed": {
            "description": "Seed of the generated Image. It will be the same value of the one passed in the input or the randomly generated that was used in case none was passed.",
            "title": "Seed",
            "type": "integer"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "title": "Prompt",
            "type": "string"
          },
          "has_nsfw_concepts": {
            "description": "Whether the generated images contain NSFW concepts.",
            "items": {
              "type": "boolean"
            },
            "title": "Has Nsfw Concepts",
            "type": "array"
          },
          "images": {
            "examples": [
              [
                {
                  "content_type": "image/png",
                  "url": "https://v3b.fal.media/files/b/0a9276c3/6KxxMb0bPmfNLH3DqcuSf_qRUe8cIL.png",
                  "width": 2048,
                  "height": 2048
                }
              ]
            ],
            "description": "The generated image files info.",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images",
            "type": "array"
          },
          "timings": {
            "description": "The timings of the generation process.",
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          }
        },
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "The width of the generated image.",
            "maximum": 14142,
            "title": "Width",
            "default": 512
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "The height of the generated image.",
            "maximum": 14142,
            "title": "Height",
            "default": 512
          }
        },
        "title": "ImageSize",
        "type": "object"
      },
      "ImageFile": {
        "title": "ImageFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "description": "The width of the image",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "description": "The height of the image",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    }
