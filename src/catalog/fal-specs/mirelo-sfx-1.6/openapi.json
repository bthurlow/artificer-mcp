{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for mirelo-ai/sfx1.6/text-to-audio",
    "version": "1.0.0",
    "description": "Generate ambient sounds for any text prompt. Now you can turn any SFX into a natural loop for ambient soundscapes.",
    "x-fal-metadata": {
      "endpointId": "mirelo-ai/sfx1.6/text-to-audio",
      "category": "text-to-audio",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9a49f4/j_CsUhacSWsqc9KyZ6X5G_6e551c71998c4f9697cee6bc6f22554d.jpg",
      "playgroundUrl": "https://fal.ai/models/mirelo-ai/sfx1.6/text-to-audio",
      "documentationUrl": "https://fal.ai/models/mirelo-ai/sfx1.6/text-to-audio/api",
      "about": "Text To Audio"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Sfx16TextToAudioInput": {
        "title": "TextToAudioInput",
        "properties": {
          "ambience": {
            "description": "When true, generate a seamlessly loopable ambience tile (room tone, rain, drones, etc.). When false, generate a generic text-conditioned SFX of `duration` seconds.",
            "default": false,
            "title": "Ambience",
            "type": "boolean"
          },
          "seed": {
            "description": "Seed for generation. -1 or None for random.",
            "anyOf": [
              {
                "minimum": -1,
                "maximum": 18446744073709552000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "num_samples": {
            "description": "Number of variations to generate.",
            "default": 2,
            "title": "Num Samples",
            "minimum": 1,
            "type": "integer",
            "maximum": 4
          },
          "text_prompt": {
            "minLength": 4,
            "description": "Text prompt for the generated audio.",
            "title": "Text Prompt",
            "type": "string",
            "examples": [
              "city ambience"
            ]
          },
          "double_output": {
            "description": "Only used when ambience=true: concatenate the loop with itself for a 2x-length output.",
            "default": false,
            "title": "Double Output",
            "type": "boolean"
          },
          "duration": {
            "description": "Duration of the generated audio in seconds. The minimum is 0.1s for ordinary sound effects and 1s when ambience=true.",
            "default": 10,
            "title": "Duration",
            "minimum": 0.1,
            "type": "number",
            "maximum": 60
          },
          "upload_audio_format": {
            "description": "Audio format for the returned files.",
            "default": "wav",
            "title": "Upload Audio Format",
            "enum": [
              "wav",
              "mp3",
              "aac",
              "flac"
            ],
            "type": "string"
          }
        },
        "x-fal-order-properties": [
          "text_prompt",
          "duration",
          "ambience",
          "double_output",
          "num_samples",
          "seed",
          "upload_audio_format"
        ],
        "required": [
          "text_prompt"
        ],
        "type": "object"
      },
      "Sfx16TextToAudioOutput": {
        "title": "TextToAudioOutput",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string",
            "pattern": "^sfx-[0-9]+\\.[0-9]+$"
          },
          "audio": {
            "description": "Generated SFX audio from a text prompt.",
            "title": "Audio",
            "items": {
              "$ref": "#/components/schemas/Audio"
            },
            "type": "array",
            "examples": [
              [
                {
                  "content_type": "audio/wav",
                  "file_name": "text_to_audio_1.wav",
                  "url": "https://v3b.fal.media/files/b/kangaroo/text_to_audio_example.wav"
                }
              ]
            ]
          }
        },
        "x-fal-order-properties": [
          "model",
          "audio"
        ],
        "required": [
          "model",
          "audio"
        ],
        "type": "object"
      },
      "Audio": {
        "type": "object",
        "title": "Audio",
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/mirelo-ai/sfx1.6/text-to-audio/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/mirelo-ai/sfx1.6/text-to-audio/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mirelo-ai/sfx1.6/text-to-audio": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Sfx16TextToAudioInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/mirelo-ai/sfx1.6/text-to-audio/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sfx16TextToAudioOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
