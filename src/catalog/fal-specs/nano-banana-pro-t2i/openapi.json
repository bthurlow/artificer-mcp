    "title": "Queue OpenAPI for fal-ai/nano-banana-pro",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/nano-banana-pro queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/nano-banana-pro",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8691ce/SR0_u1zPJbx8jCIO6bJR0_8c83f0d66bbd48f3b55f825117941f84.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/nano-banana-pro",
      "documentationUrl": "https://fal.ai/models/fal-ai/nano-banana-pro/api",
      "about": "Gemini 3 Pro Image is a text-to-image model that generates images from text descriptions."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "NanoBananaProInput": {
        "properties": {
          "top_p": {
            "description": "Nucleus sampling probability. Omit to use the provider default of 0.95. Explicit values use a direct Google or Vertex API.",
            "title": "Top P",
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "description": "Ordered text, original images, PDF or UTF-8 text documents appended to the current prompt. Uses a native provider. Images count toward the total 14-reference limit.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/GeminiTextPart"
                },
                {
                  "$ref": "#/components/schemas/GeminiImagePart"
                },
                {
                  "$ref": "#/components/schemas/GeminiDocumentPart"
                },
                {
                  "$ref": "#/components/schemas/GeminiSignaturePart"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "signature": "#/components/schemas/GeminiSignaturePart",
                  "text": "#/components/schemas/GeminiTextPart",
                  "document": "#/components/schemas/GeminiDocumentPart",
                  "image": "#/components/schemas/GeminiImagePart"
                }
              }
            },
            "title": "Context",
            "type": "array"
          },
          "output_format": {
            "type": "string",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "title": "Output Format",
            "default": "png"
          },
          "enable_web_search": {
            "type": "boolean",
            "description": "Enable web search for the image generation task. This will allow the model to use the latest information from the web to generate the image.",
            "title": "Enable Web Search",
            "default": false
          },
          "seed": {
            "description": "The seed for the random number generator.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "examples": [
              "An action shot of a black lab swimming in an inground suburban swimming pool. The camera is placed meticulously on the water line, dividing the image in half, revealing both the dogs head above water holding a tennis ball in it's mouth, and it's paws paddling underwater."
            ],
            "maxLength": 50000,
            "description": "The text prompt to generate an image from.",
            "minLength": 3,
            "title": "Prompt",
            "type": "string"
          },
          "temperature": {
            "description": "Sampling temperature. Omit to use the provider default of 1. Explicit values use a direct Google or Vertex API.",
            "title": "Temperature",
            "anyOf": [
              {
                "maximum": 2,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "thinking_level": {
            "description": "Thinking effort. Pro Image supports only high; omit to retain its provider default. An explicit level requests summaries unless include_thoughts overrides it. Thinking cannot be disabled.",
            "title": "Thinking Level",
            "anyOf": [
              {
                "type": "string",
                "const": "high"
              },
              {
                "type": "null"
              }
            ]
          },
          "aspect_ratio": {
            "description": "The aspect ratio of the generated image.",
            "title": "Aspect Ratio",
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "3:2",
                  "4:3",
                  "5:4",
                  "1:1",
                  "4:5",
                  "3:4",
                  "2:3",
                  "9:16",
                  "4:1",
                  "1:4",
                  "8:1",
                  "1:8"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "1:1"
          },
          "history": {
            "description": "Previous native user/model turns. Replay a returned conversation's messages unchanged, including thought signatures; the current prompt is appended as a new user turn.",
            "items": {
              "$ref": "#/components/schemas/GeminiMessage"
            },
            "title": "History",
            "type": "array"
          },
          "limit_generations": {
            "type": "boolean",
            "description": "Experimental parameter to limit the number of generations from each round of prompting to 1. Set to `True` to to disregard any instructions in the prompt regarding the number of images to generate.",
            "title": "Limit Generations",
            "default": true
          },
          "return_history": {
            "type": "boolean",
            "description": "Return reusable native conversations with original image parts and provider thought signatures. Uses a native provider. Each generated conversation is independent; send its messages as history for the next turn.",
            "title": "Return History",
            "default": false
          },
          "max_output_tokens": {
            "description": "Maximum output tokens for the generation. Omit to retain the provider default. Explicit values use a direct Google or Vertex API.",
            "title": "Max Output Tokens",
            "anyOf": [
              {
                "maximum": 32768,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "safety_tolerance": {
            "type": "string",
            "description": "The safety tolerance level for content moderation. 1 is the most strict (blocks most content), 6 is the least strict.",
            "title": "Safety Tolerance",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "default": "4"
          },
          "resolution": {
            "type": "string",
            "description": "The resolution of the image to generate.",
            "title": "Resolution",
            "enum": [
              "1K",
              "2K",
              "4K"
            ],
            "default": "1K"
          },
          "num_images": {
            "default": 1,
            "description": "The number of images to generate.",
            "maximum": 4,
            "minimum": 1,
            "title": "Number of Images",
            "type": "integer"
          },
          "include_thoughts": {
            "description": "Whether to include thought summaries. Omit to preserve the existing behavior: an explicit thinking_level requests summaries. Set limit_generations=false to return summary text in description. This does not disable thinking or return intermediate thought images.",
            "title": "Include Thoughts",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "sync_mode": {
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "default": false
          },
          "system_prompt": {
            "type": "string",
            "description": "Optional system instruction that steers the model's persona and output style across the request. Leave blank to omit; when provided, it is sent as the system instruction to Gemini (or as a system message on OpenAI-compatible providers).",
            "maxLength": 50000,
            "title": "System Prompt",
            "default": ""
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "history",
          "context",
          "return_history",
          "thinking_level",
          "include_thoughts",
          "temperature",
          "top_p",
          "max_output_tokens",
          "num_images",
          "seed",
          "aspect_ratio",
          "output_format",
          "safety_tolerance",
          "sync_mode",
          "system_prompt",
          "resolution",
          "limit_generations",
          "enable_web_search"
        ],
