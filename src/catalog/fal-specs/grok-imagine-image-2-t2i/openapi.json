{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for xai/grok-imagine-image/v2.0/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the xai/grok-imagine-image/v2.0/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "xai/grok-imagine-image/v2.0/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa53f80/jz23bpxsEx0-ROlZEErD0.jpg",
      "playgroundUrl": "https://fal.ai/models/xai/grok-imagine-image/v2.0/text-to-image",
      "documentationUrl": "https://fal.ai/models/xai/grok-imagine-image/v2.0/text-to-image/api",
      "about": "Generate an image using Grok Imagine Image 2.0."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "GrokImagineImageV20TextToImageInput": {
        "properties": {
          "quality": {
            "title": "Quality",
            "type": "string",
            "description": "Quality level of the generated image. `auto` lets xAI choose; it currently uses `low` for generation.",
            "enum": [
              "low",
              "medium",
              "auto"
            ],
            "default": "medium"
          },
          "prompt": {
            "type": "string",
            "description": "Text description of the desired image.",
            "title": "Prompt",
            "maxLength": 8000,
            "examples": [
              "Abstract human silhouette, golden particles ready to burst outward representing joy, data visualization style, emotional expression through particles, artistic scientific"
            ]
          },
          "image_passthrough": {
            "type": "boolean",
            "description": "Send edit references and return provider images without resizing or re-encoding, preserving transparency and metadata. The returned native format may differ from output_format.",
            "default": false,
            "title": "Image Passthrough"
          },
          "output_format": {
            "type": "string",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "jpeg",
            "title": "Output Format"
          },
          "resolution": {
            "title": "Resolution",
            "type": "string",
            "description": "Resolution of the generated image: 1k, 1.5k, or 2k.",
            "enum": [
              "1k",
              "1.5k",
              "2k"
            ],
            "default": "1k"
          },
          "num_images": {
            "minimum": 1,
            "description": "Number of images to generate.",
            "type": "integer",
            "title": "Number of Images",
            "default": 1,
            "maximum": 10
          },
          "sync_mode": {
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "default": false
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Aspect ratio of the generated image. Use auto to let the provider choose.",
            "enum": [
              "2:1",
              "20:9",
              "19.5:9",
              "16:9",
              "4:3",
              "3:2",
              "1:1",
              "2:3",
              "3:4",
              "9:16",
              "9:19.5",
              "9:20",
              "1:2",
              "auto",
              "21:9",
              "5:2"
            ],
            "default": "1:1",
            "title": "Aspect Ratio"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "default": true
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "num_images",
          "aspect_ratio",
          "resolution",
          "output_format",
          "sync_mode",
          "enable_safety_checker",
          "image_passthrough",
          "quality"
        ],
        "title": "XAIImageV2Input",
        "required": [
          "prompt"
        ]
      },
      "GrokImagineImageV20TextToImageOutput": {
        "properties": {
          "revised_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The enhanced prompt that was used to generate the image.",
            "title": "Revised Prompt"
          },
          "images": {
            "type": "array",
            "description": "The URL of the generated image.",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8b90b7/9avg_nKJmcVinjQHJR_Ja.jpg"
                }
              ]
            ]
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "images",
          "revised_prompt"
        ],
        "title": "XAIImageOutput",
        "required": [
          "images"
        ]
      },
      "ImageFile": {
        "properties": {
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image",
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image",
            "title": "Height"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "title": "ImageFile",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/xai/grok-imagine-image/v2.0/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-image/v2.0/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-image/v2.0/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrokImagineImageV20TextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-image/v2.0/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrokImagineImageV20TextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
