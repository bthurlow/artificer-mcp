      "LoRAWeight": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "URL or path to the LoRA weights."
          },
          "weight_name": {
            "title": "Weight Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the LoRA weight. Only used if `path` is a HuggingFace repository, and is only required when the repository contains multiple LoRA weights."
          },
          "scale": {
            "maximum": 4,
            "title": "Scale",
            "type": "number",
            "description": "Scale of the LoRA weight. This is a multiplier applied to the LoRA weight when loading it.",
            "minimum": 0,
            "default": 1
          }
        },
        "title": "LoRAWeight",
        "required": [
          "path"
        ],
        "x-fal-order-properties": [
          "path",
          "weight_name",
          "scale"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "file_size": {
            "examples": [
              4404019
