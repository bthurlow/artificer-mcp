        "type": "object",
        "properties": {
          "prompt": {
            "examples": [
              "The astronaut gets up and walks away"
            ],
            "type": "string",
            "title": "Prompt",
            "description": "The prompt used for generation."
          },
          "video": {
            "examples": [
              {
                "url": "https://storage.googleapis.com/falserverless/example_outputs/ltxv-image-to-video-output.mp4"
