            "maximum": 1441,
            "type": "integer"
          },
          "first_pass_num_inference_steps": {
            "default": 8,
            "minimum": 2,
            "title": "Number of Inference Steps",
            "description": "Number of inference steps during the first pass.",
            "examples": [
              8
            ],
            "maximum": 12,
            "type": "integer"
          },
