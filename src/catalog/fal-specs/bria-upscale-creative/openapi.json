{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bria/upscale/creative",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bria/upscale/creative queue.",
    "x-fal-metadata": {
      "endpointId": "bria/upscale/creative",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8f7bca/m78uzt7MEVkgCcaEux179_4ef74caf0e414da78bd587bde2272ee2.jpg",
      "playgroundUrl": "https://fal.ai/models/bria/upscale/creative",
      "documentationUrl": "https://fal.ai/models/bria/upscale/creative/api",
      "about": "Generate Image"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "UpscaleCreativeInput": {
        "properties": {
          "sync_mode": {
            "title": "Sync Mode",
            "type": "boolean",
            "default": false,
            "description": "If true, returns the image directly in the response (increases latency)."
          },
          "image_url": {
            "type": "string",
            "default": "https://bria-datasets.s3.us-east-1.amazonaws.com/upscale/wild-west.png",
            "title": "Image Url"
          },
          "seed": {
            "title": "Seed",
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 5555,
            "description": "Random seed for reproducibility."
          },
          "preserve_alpha": {
            "title": "Preserve Alpha",
            "type": "boolean",
            "default": true,
            "description": "Preserve alpha channel from input image."
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "seed",
          "preserve_alpha",
          "sync_mode"
        ],
        "title": "Input"
      },
      "UpscaleCreativeOutput": {}
    }
  },
  "paths": {
    "/bria/upscale/creative/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/upscale/creative/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bria/upscale/creative": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpscaleCreativeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/upscale/creative/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpscaleCreativeOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
