      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BytedanceOmnihumanV15Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
