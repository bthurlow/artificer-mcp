  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "HidreamO1ImageEditInput": {
        "title": "HiDreamO1ImageEditInput",
        "required": [
          "prompt",
          "reference_image_urls"
        ],
        "x-fal-order-properties": [
          "prompt",
          "reference_image_urls",
          "image_size",
          "num_inference_steps",
          "guidance_scale",
          "seed",
          "num_images",
          "output_format",
          "sync_mode",
          "enable_safety_checker",
          "keep_original_aspect"
        ],
        "properties": {
          "image_size": {
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              }
            ],
            "description": "Requested output image size. Reference-image outputs use the nearest model-supported resolution up to about 2048x2048 pixels.",
            "default": {
              "height": 2048,
              "width": 2048
            }
          },
          "guidance_scale": {
            "title": "Guidance Scale",
            "default": 5,
            "maximum": 20,
            "description": "Classifier-free guidance scale. The full model uses 5.0 by default.",
            "minimum": 0,
            "type": "number"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false,
            "type": "boolean"
          },
          "output_format": {
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "description": "The format of the generated image.",
            "default": "png",
            "type": "string"
          },
          "keep_original_aspect": {
            "title": "Keep Original Aspect",
            "description": "When exactly one reference image is provided, preserve its aspect ratio for the output image.",
            "default": false,
            "type": "boolean"
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "Enable the safety checker on generated images.",
            "default": true,
            "type": "boolean"
          },
          "prompt": {
            "title": "Prompt",
            "examples": [
              "A cinematic product photo of a ceramic mug on a marble counter, soft window light, shallow depth of field."
            ],
            "minLength": 1,
            "description": "Text prompt for image generation, editing, or subject-driven personalization.",
            "type": "string"
          },
          "num_inference_steps": {
            "title": "Num Inference Steps",
            "default": 50,
            "maximum": 50,
            "description": "Number of denoising steps.",
            "minimum": 1,
            "type": "integer"
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducible generation."
          },
          "num_images": {
            "title": "Num Images",
            "default": 1,
            "maximum": 4,
            "description": "Number of images to generate.",
            "minimum": 1,
            "type": "integer"
          },
          "reference_image_urls": {
            "title": "Reference Image Urls",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/model_tests/hidream/woman.png"
              ]
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Reference images for image editing or subject-driven personalization.",
            "type": "array"
          }
        },
        "type": "object"
      },
      "HidreamO1ImageEditOutput": {
        "title": "HiDreamO1ImageOutput",
        "required": [
          "images",
          "seed",
          "has_nsfw_concepts",
          "prompt",
          "timings"
        ],
        "x-fal-order-properties": [
          "images",
          "seed",
          "has_nsfw_concepts",
          "prompt",
          "timings"
        ],
        "properties": {
          "prompt": {
            "title": "Prompt",
            "description": "The prompt used for generation.",
            "type": "string"
          },
          "images": {
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "description": "Generated images.",
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "description": "The seed used for generation.",
            "type": "integer"
          },
          "timings": {
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Generation timings.",
            "type": "object"
          },
          "has_nsfw_concepts": {
            "title": "Has Nsfw Concepts",
            "items": {
              "type": "boolean"
            },
            "description": "Whether each generated image was flagged by the safety checker.",
            "type": "array"
          }
        },
        "type": "object"
      },
      "ImageSize": {
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "title": "Height",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The height of the generated image.",
            "default": 512,
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The width of the generated image.",
            "default": 512,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ImageFile": {
        "title": "ImageFile",
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "content_type": {
            "title": "Content Type",
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file."
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "file_name": {
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "file_size": {
            "title": "File Size",
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes."
          },
          "height": {
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image"
          },
          "width": {
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image"
          }
        },
        "type": "object"
      }
    }
