{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for topaz/denoise/image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the topaz/denoise/image queue.",
    "x-fal-metadata": {
      "endpointId": "topaz/denoise/image",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5f57d/o7bBPRADnl9iXyGs6pukA.jpg",
      "playgroundUrl": "https://fal.ai/models/topaz/denoise/image",
      "documentationUrl": "https://fal.ai/models/topaz/denoise/image/api",
      "about": "# Topaz Image Denoise\n\nDedicated noise reduction that keeps the source resolution.\n\n## Models\n- **Normal** — general-purpose noise reduction.\n- **Strong** — stronger denoising with detail preservation.\n- **Extreme** — maximum noise removal for very noisy sources.\n- **Denoise Max** — Topaz's highest-quality generative denoising\nwith intelligent detail recovery."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "DenoiseImageInput": {
        "title": "ImageDenoiseRequest",
        "x-fal-order-properties": [
          "image_url",
          "output_format",
          "model",
          "enable_safety_checker"
        ],
        "required": [
          "image_url"
        ],
        "properties": {
          "enable_safety_checker": {
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean"
          },
          "output_format": {
            "description": "Output format of the processed image.",
            "title": "Output Format",
            "default": "jpeg",
            "enum": [
              "jpeg",
              "png"
            ],
            "type": "string"
          },
          "image_url": {
            "description": "Url of the image to process",
            "title": "Image Url",
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/codeformer/codeformer_poor_1.jpeg"
            ],
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "description": "Denoise model. Normal is general-purpose; Strong and Extreme remove progressively more noise; Denoise Max is Topaz's highest-quality generative denoiser.",
            "title": "Model",
            "default": "Normal",
            "enum": [
              "Normal",
              "Strong",
              "Extreme",
              "Denoise Max"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "DenoiseImageOutput": {
        "title": "ImageUpscaleOutput",
        "x-fal-order-properties": [
          "image"
        ],
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "description": "The upscaled image.",
            "$ref": "#/components/schemas/File"
          }
        },
        "type": "object"
      },
      "File": {
        "title": "File",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "required": [
          "url"
        ],
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "paths": {
    "/topaz/denoise/image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/denoise/image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/topaz/denoise/image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DenoiseImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/denoise/image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DenoiseImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
