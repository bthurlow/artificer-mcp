{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/recraft/v4.1/text-to-vector",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/recraft/v4.1/text-to-vector queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/recraft/v4.1/text-to-vector",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9a2971/-tcT4xrw7bYtB1fwxaBg0_966bd9af562a4c5da33ce11dd7e610c9.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/recraft/v4.1/text-to-vector",
      "documentationUrl": "https://fal.ai/models/fal-ai/recraft/v4.1/text-to-vector/api",
      "about": "Recraft V4 1 Vector"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "RecraftV41TextToVectorInput": {
        "properties": {
          "colors": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RGBColor"
            },
            "description": "An array of preferable colors",
            "type": "array",
            "title": "Colors"
          },
          "background_color": {
            "description": "The preferable background color of the generated images.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/RGBColor"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string",
            "examples": [
              "a cute character fox with cool clothes, 3d flat color, design"
            ],
            "title": "Prompt"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "type": "boolean",
            "title": "Enable Safety Checker"
          },
          "image_size": {
            "default": "square_hd",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "examples": [
              "landscape_16_9"
            ],
            "title": "Image Size"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "colors",
          "background_color",
          "enable_safety_checker"
        ],
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "RecraftV4VectorTextToImageInput"
      },
      "RecraftV41TextToVectorOutput": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "type": "array",
            "examples": [
              [
                {
                  "file_size": 1722022,
                  "content_type": "image/svg+xml",
                  "file_name": "image.svg",
                  "url": "https://v3b.fal.media/files/b/0a8ee4fd/sw8YD36iblpO64JeQZEDt_image.svg"
                }
              ]
            ],
            "title": "Images"
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "type": "object",
        "required": [
          "images"
        ],
        "title": "RecraftV4VectorTextToImageOutput"
      },
      "RGBColor": {
        "properties": {
          "r": {
            "default": 0,
            "description": "Red color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "R"
          },
          "g": {
            "default": 0,
            "description": "Green color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "G"
          },
          "b": {
            "default": 0,
            "description": "Blue color value",
            "minimum": 0,
            "maximum": 255,
            "type": "integer",
            "title": "B"
          }
        },
        "x-fal-order-properties": [
          "r",
          "g",
          "b"
        ],
        "type": "object",
        "title": "RGBColor"
      },
      "ImageSize": {
        "properties": {
          "width": {
            "default": 512,
            "description": "The width of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Width"
          },
          "height": {
            "default": 512,
            "description": "The height of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Height"
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageSize"
      },
      "File": {
        "properties": {
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object",
        "required": [
          "url"
        ],
        "title": "File"
      }
    }
  },
  "paths": {
    "/fal-ai/recraft/v4.1/text-to-vector/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-vector/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-vector": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecraftV41TextToVectorInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-vector/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecraftV41TextToVectorOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
