                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bria/fibo-edit-1.5/virtual-try-on": {
      "post": {
        "requestBody": {
          "required": true,
