{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bria/fibo-edit-1.5/virtual-try-on",
    "version": "1.0.0",
    "description": "Bria Virtual Try-On uses FIBO-Edit-1.5 to visualize garments and accessories on a person. The endpoint accepts a person image and one to three garment or accessory reference images for outfit changes in a single generation.\n\nAn optional instruction adds direction to the built-in try-on instruction, specifying which garments to replace, how to layer them, and which items should stay unchanged. The output keeps the person image's aspect ratio unless an explicit aspect ratio is selected. A seed controls reproducibility, and sync mode can return the image directly in the response.\n\nUse cases include apparel e-commerce listings, digital lookbooks, seasonal catalogs, virtual fitting rooms, and social commerce creative.",
    "x-fal-metadata": {
      "endpointId": "bria/fibo-edit-1.5/virtual-try-on",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aaace34/m1K534dU518WX0hCH5qrc.jpg",
      "playgroundUrl": "https://fal.ai/models/bria/fibo-edit-1.5/virtual-try-on",
      "documentationUrl": "https://fal.ai/models/bria/fibo-edit-1.5/virtual-try-on/api",
      "about": "Virtual Try On"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "FiboEdit15VirtualTryOnInput": {
        "title": "VirtualTryOnInputModel",
        "x-fal-order-properties": [
          "person_image_url",
          "garment_image_urls",
          "instruction",
          "aspect_ratio",
          "seed",
          "sync_mode"
        ],
        "required": [
          "person_image_url",
          "garment_image_urls"
        ],
        "properties": {
          "person_image_url": {
            "title": "Person Image Url",
            "description": "Photo of the person who will wear the garments. Their identity, face, hair, body shape, pose and the background are preserved.",
            "examples": [
              "https://labs-assets.bria.ai/fal-examples/fibo-edit-1.5/virtual-try-on/person.jpg"
            ],
            "type": "string"
          },
          "seed": {
            "title": "Seed",
            "description": "Random seed. The same seed with the same inputs returns the same image.",
            "default": 5555,
            "type": "integer"
          },
          "garment_image_urls": {
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Garment Image Urls",
            "description": "One to three garment or accessory images. They are worn together and layered, each replacing the corresponding item the person currently wears. Fabric, color, texture, pattern and print placement, closures and proportions are reproduced as given.",
            "examples": [
              [
                "https://labs-assets.bria.ai/fal-examples/fibo-edit-1.5/virtual-try-on/garment-1.jpg",
                "https://labs-assets.bria.ai/fal-examples/fibo-edit-1.5/virtual-try-on/garment-2.jpg"
              ]
            ],
            "type": "array"
          },
          "instruction": {
            "title": "Instruction",
            "description": "Optional. A complete try-on instruction already runs; this is appended to it. Use it to say what layers over what, or which items stay untouched.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "He wears the navy blazer over the white t-shirt he already has, and the grey tailored trousers instead of his jeans; his sneakers stay unchanged."
            ]
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "description": "Output aspect ratio. Left unset, the output keeps the ratio of the person image.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "4:5",
                  "5:4",
                  "9:16",
                  "16:9"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "Return the image inline in the response instead of as a hosted URL. Adds latency.",
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "FiboEdit15VirtualTryOnOutput": {
        "title": "FiboEditOutputModel",
        "x-fal-order-properties": [
          "image",
          "images",
          "structured_instruction"
        ],
        "required": [
          "image",
          "structured_instruction"
        ],
        "properties": {
          "structured_instruction": {
            "title": "Structured Instruction",
            "description": "The structured instruction the model ran, expanded from the built-in instruction plus anything passed in `instruction`. Returned so you can see how the brief was interpreted.",
            "additionalProperties": true,
            "type": "object"
          },
          "images": {
            "title": "Images",
            "description": "Single-element list holding the same image, kept for callers of the earlier Fibo Edit endpoint.",
            "default": [],
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0aa6910f/ie5dAn55wDh7Y1adCFGyE_85a45d82c6d141c2a28d92367596dfac.png"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "image": {
            "$ref": "#/components/schemas/Image",
            "description": "The edited image, in the source aspect ratio unless aspect_ratio was set."
          }
        },
        "type": "object"
      },
      "Image": {
        "title": "Image",
        "description": "Represents an image file.",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "properties": {
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          },
          "width": {
            "title": "Width",
            "description": "The width of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ]
          },
          "height": {
            "title": "Height",
            "description": "The height of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ]
          },
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "paths": {
    "/bria/fibo-edit-1.5/virtual-try-on/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
