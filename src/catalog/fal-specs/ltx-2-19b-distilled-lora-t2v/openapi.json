            "type": "integer",
            "minimum": 9,
            "title": "Number of Frames",
            "maximum": 481
          },
          "video_quality": {
            "description": "The quality of the generated video.",
            "default": "high",
            "type": "string",
            "title": "Video Quality",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ]
