          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx219bDistilledTextToVideoLoraInput": {
        "x-fal-order-properties": [
          "prompt",
          "num_frames",
          "video_size",
          "generate_audio",
          "use_multiscale",
