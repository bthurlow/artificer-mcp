      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8936f9/MqecW0ic5_aJ01aOHjOt__da41267b8c59467bbbbaa3d80016ec07.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/distilled/text-to-video/lora",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/distilled/text-to-video/lora/api",
