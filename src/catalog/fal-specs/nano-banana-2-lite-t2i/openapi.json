{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for google/nano-banana-2-lite",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the google/nano-banana-2-lite queue.",
    "x-fal-metadata": {
      "endpointId": "google/nano-banana-2-lite",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa065ef/5nRcoeLuJhcbIysKu4EDf.jpg",
      "playgroundUrl": "https://fal.ai/models/google/nano-banana-2-lite",
      "documentationUrl": "https://fal.ai/models/google/nano-banana-2-lite/api",
      "about": "Gemini 3.1 Flash Lite Image (Nano Banana Lite) generates images from\ntext descriptions at ultra-low latency."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "NanoBanana2LiteInput": {
        "properties": {
          "aspect_ratio": {
            "default": "auto",
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "3:2",
                  "4:3",
                  "5:4",
                  "1:1",
                  "4:5",
                  "3:4",
                  "2:3",
                  "9:16",
                  "4:1",
                  "1:4",
                  "8:1",
                  "1:8"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspect Ratio",
            "description": "The aspect ratio of the generated image. Supports extreme ratios: 4:1, 1:4, 8:1, 1:8. Use \"auto\" to let the model decide based on the prompt."
          },
          "num_images": {
            "minimum": 1,
            "default": 1,
            "type": "integer",
            "description": "The number of images to generate.",
            "title": "Number of Images",
            "maximum": 4
          },
          "prompt": {
            "minLength": 3,
            "maxLength": 50000,
            "type": "string",
            "description": "The text prompt to generate an image from.",
            "title": "Prompt",
            "examples": [
              "An action shot of a black lab swimming in an inground suburban swimming pool. The camera is placed meticulously on the water line, dividing the image in half, revealing both the dogs head above water holding a tennis ball in it's mouth, and it's paws paddling underwater."
            ]
          },
          "thinking_level": {
            "anyOf": [
              {
                "enum": [
                  "minimal",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thinking Level",
            "description": "When set, enables model thinking with the given level ('minimal' or 'high') and includes thoughts in the generation. Omit to disable."
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "The seed for the random number generator."
          },
          "limit_generations": {
            "default": true,
            "type": "boolean",
            "description": "Experimental parameter to limit the number of generations from each round of prompting to 1. Set to `True` to to disregard any instructions in the prompt regarding the number of images to generate and ignore any intermediate images generated by the model. This may affect generation quality.",
            "title": "Limit Generations"
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png",
            "type": "string",
            "description": "The format of the generated image.",
            "title": "Output Format"
          },
          "system_prompt": {
            "default": "",
            "type": "string",
            "description": "Optional system instruction that steers the model's persona and output style across the request. Leave blank to omit; when provided, it is sent as the system instruction to Gemini (or as a system message on OpenAI-compatible providers).",
            "title": "System Prompt",
            "maxLength": 50000
          },
          "safety_tolerance": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "default": "4",
            "type": "string",
            "description": "The safety tolerance level for content moderation. 1 is the most strict (blocks most content), 6 is the least strict.",
            "title": "Safety Tolerance"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "system_prompt",
          "aspect_ratio",
          "num_images",
          "seed",
          "output_format",
          "safety_tolerance",
          "sync_mode",
          "limit_generations",
          "thinking_level"
        ],
        "type": "object",
        "title": "NanoBananaLiteTextToImageInput",
        "required": [
          "prompt"
        ]
      },
      "NanoBanana2LiteOutput": {
        "properties": {
          "description": {
            "type": "string",
            "description": "The description of the generated images.",
            "title": "Description"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array",
            "description": "The generated images.",
            "title": "Images",
            "examples": [
              [
                {
                  "content_type": "image/png",
                  "file_name": "nano-banana-lite-t2i-output.png",
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/nano-banana-2-t2i-output.png"
                }
              ]
            ]
          }
        },
        "x-fal-order-properties": [
          "images",
          "description"
        ],
        "type": "object",
        "title": "NanoBananaLiteTextToImageOutput",
        "required": [
          "images",
          "description"
        ]
      },
      "ImageFile": {
        "properties": {
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageFile",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/google/nano-banana-2-lite/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/google/nano-banana-2-lite/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/google/nano-banana-2-lite": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NanoBanana2LiteInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/google/nano-banana-2-lite/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NanoBanana2LiteOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
