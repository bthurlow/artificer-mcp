            "type": "number",
            "title": "Camera LoRA Scale"
          },
          "guidance_scale": {
            "maximum": 10,
            "minimum": 1,
            "description": "The guidance scale to use.",
            "default": 3,
            "type": "number",
            "title": "Guidance Scale"
          },
