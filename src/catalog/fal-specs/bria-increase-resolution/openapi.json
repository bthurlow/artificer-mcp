{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bria/increase-resolution",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bria/increase-resolution queue.",
    "x-fal-metadata": {
      "endpointId": "bria/increase-resolution",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa97138/FU8x6VmXCuO3RZBxwkC6y.jpg",
      "playgroundUrl": "https://fal.ai/models/bria/increase-resolution",
      "documentationUrl": "https://fal.ai/models/bria/increase-resolution/api",
      "about": "Increase Resolution"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "IncreaseResolutionInput": {
        "required": [
          "image_url"
        ],
        "x-fal-order-properties": [
          "image_url",
          "desired_increase",
          "preserve_alpha",
          "preserve_color",
          "output_type",
          "sync_mode"
        ],
        "properties": {
          "output_type": {
            "default": "png",
            "enum": [
              "png",
              "jpeg"
            ],
            "description": "Image format. JPEG carries no alpha, so preserve_alpha does not apply.",
            "type": "string",
            "title": "Output Type"
          },
          "preserve_alpha": {
            "default": true,
            "description": "Reattach the source alpha channel to the result.",
            "type": "boolean",
            "title": "Preserve Alpha"
          },
          "preserve_color": {
            "default": false,
            "description": "Correct the upscaled result's color cast against the source image.",
            "type": "boolean",
            "title": "Preserve Color"
          },
          "sync_mode": {
            "default": false,
            "description": "Return the image inline instead of as a URL.",
            "type": "boolean",
            "title": "Sync Mode"
          },
          "image_url": {
            "examples": [
              "https://bria-test-images.s3.amazonaws.com/increase_res/playground/sample_input_1000x1250.png"
            ],
            "description": "URL of the image to upscale.",
            "type": "string",
            "title": "Image Url"
          },
          "desired_increase": {
            "default": 2,
            "enum": [
              2,
              4
            ],
            "description": "Upscale factor. Each factor is its own SwinIR checkpoint.",
            "type": "integer",
            "title": "Desired Increase"
          }
        },
        "type": "object",
        "title": "IncreaseResolutionInput"
      },
      "IncreaseResolutionOutput": {
        "required": [
          "image"
        ],
        "x-fal-order-properties": [
          "image"
        ],
        "properties": {
          "image": {
            "examples": [
              {
                "height": 2500,
                "url": "https://bria-test-images.s3.amazonaws.com/increase_res/playground/sample_upscaled_2x_2000x2500.png",
                "content_type": "image/png",
                "width": 2000
              }
            ],
            "description": "The upscaled image.",
            "$ref": "#/components/schemas/Image"
          }
        },
        "type": "object",
        "title": "IncreaseResolutionOutput"
      },
      "Image": {
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "description": "Represents an image file.",
        "properties": {
          "height": {
            "examples": [
              1024
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image in pixels.",
            "title": "Height"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name"
          },
          "width": {
            "examples": [
              1024
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image in pixels.",
            "title": "Width"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type"
          }
        },
        "type": "object",
        "title": "Image"
      }
    }
  },
  "paths": {
    "/bria/increase-resolution/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/increase-resolution/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bria/increase-resolution": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncreaseResolutionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/increase-resolution/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncreaseResolutionOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
