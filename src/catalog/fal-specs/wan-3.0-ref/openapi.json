            "title": "Duration"
          },
          "seed": {
            "type": "integer",
            "description": "The seed used for generation.",
            "title": "Seed"
          }
        },
        "x-fal-order-properties": [
          "video",
          "seed",
          "duration",
          "actual_prompt"
        ],
        "required": [
          "video",
          "seed",
          "duration"
