      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8936f6/lAxk4cHPDAO8Vi-zFWrYF_79d59ee30f374e16a7d2a2a2daa87e71.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/distilled/text-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/distilled/text-to-video/api",
      "about": "Generate a video from a text prompt using distilled LoRA."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
