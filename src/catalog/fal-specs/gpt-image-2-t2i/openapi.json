{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for openai/gpt-image-2",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the openai/gpt-image-2 queue.",
    "x-fal-metadata": {
      "endpointId": "openai/gpt-image-2",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a970c4a/BkrYELYOiaZMXCw-pgRcB_QlgOenEx.png",
      "playgroundUrl": "https://fal.ai/models/openai/gpt-image-2",
      "documentationUrl": "https://fal.ai/models/openai/gpt-image-2/api",
      "about": "GPT Image 2 is OpenAI's next-generation image generation model (alpha).\nIt supports flexible resolutions up to 4K and multiple model variants.\n\nUse it as a text-to-image API through fal!"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "GptImage2Input": {
        "properties": {
          "quality": {
            "type": "string",
            "title": "Quality",
            "description": "Quality for the generated image. Use 'auto' to let the model pick the best quality for the prompt.",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "default": "high"
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "Authorized callers may set false to request relaxed screening.",
            "type": "boolean",
            "default": true
          },
          "output_compression": {
            "title": "Output Compression",
            "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer",
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "output_format": {
            "type": "string",
            "title": "Output Format",
            "description": "Output format for the images",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png"
          },
          "background": {
            "type": "string",
            "title": "Background",
            "description": "Background for the generated image",
            "enum": [
              "auto",
              "transparent",
              "opaque"
            ],
            "default": "auto"
          },
          "image_size": {
            "title": "Image Size",
            "description": "The size of the generated image. Supports preset names, explicit {width, height}, or 'auto' to let the model pick the best size. Concrete sizes must have both dimensions as multiples of 16, max edge 3840px, aspect ratio <= 3:1, total pixels between 655,360 and 8,294,400.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ]
              }
            ],
            "default": "landscape_4_3"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false
          },
          "image_passthrough": {
            "title": "Image Passthrough",
            "description": "Send reference images and masks without resizing or re-encoding, and return the provider's original image bytes and format. Requests use the direct OpenAI API. Masks must be PNGs with an alpha channel: transparent regions are edited, and dimensions must match the first reference.",
            "type": "boolean",
            "default": false
          },
          "num_images": {
            "maximum": 10,
            "examples": [
              1
            ],
            "title": "Number of Images",
            "minimum": 1,
            "description": "Number of images to generate",
            "type": "integer",
            "default": 1
          },
          "prompt": {
            "examples": [
              "create a realistic image taken with iphone at these coordinates 41°43′32″N 49°56′49″W 15 April 1912"
            ],
            "minLength": 1,
            "title": "Prompt",
            "description": "The prompt for image generation",
            "type": "string",
            "maxLength": 32000
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "background",
          "quality",
          "num_images",
          "output_format",
          "output_compression",
          "image_passthrough",
          "sync_mode",
          "enable_safety_checker"
        ],
        "title": "TextToImageRequest",
        "type": "object",
        "required": [
          "prompt"
        ]
      },
      "GptImage2Output": {
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "file_name": "EnWrO3XWjPE0nxBDpaQrj.png",
                  "width": 1024,
                  "content_type": "image/png",
                  "url": "https://v3b.fal.media/files/b/0a869129/EnWrO3XWjPE0nxBDpaQrj.png",
                  "height": 1024
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "title": "Images",
            "description": "The generated images.",
            "type": "array"
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "title": "ImageResponse",
        "type": "object",
        "required": [
          "images"
        ]
      },
      "ImageSize": {
        "properties": {
          "width": {
            "maximum": 14142,
            "exclusiveMinimum": 0,
            "title": "Width",
            "description": "The width of the generated image.",
            "type": "integer",
            "default": 512
          },
          "height": {
            "maximum": 14142,
            "exclusiveMinimum": 0,
            "title": "Height",
            "description": "The height of the generated image.",
            "type": "integer",
            "default": 512
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "title": "ImageSize",
        "type": "object"
      },
      "ImageFile": {
        "properties": {
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "title": "Width",
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "height": {
            "title": "Height",
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "title": "ImageFile",
        "type": "object",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/openai/gpt-image-2/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GptImage2Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-2/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GptImage2Output"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
