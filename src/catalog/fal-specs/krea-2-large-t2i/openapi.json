{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for krea/v2/large/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the krea/v2/large/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "krea/v2/large/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9c2fb3/ATU9JDQwjBy0xRtTwPbft_7338811c31e94f11b04ef25761fe530f.jpg",
      "playgroundUrl": "https://fal.ai/models/krea/v2/large/text-to-image",
      "documentationUrl": "https://fal.ai/models/krea/v2/large/text-to-image/api",
      "about": "Generate images with Krea's krea-2 large model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V2LargeTextToImageInput": {
        "x-fal-order-properties": [
          "prompt",
          "aspect_ratio",
          "creativity",
          "seed",
          "image_style_references",
          "styles",
          "moodboards",
          "enable_safety_checker"
        ],
        "properties": {
          "aspect_ratio": {
            "default": "1:1",
            "examples": [
              "1:1"
            ],
            "description": "Aspect ratio of the generated image.",
            "title": "Aspect Ratio",
            "enum": [
              "1:1",
              "4:3",
              "3:2",
              "16:9",
              "2.35:1",
              "4:5",
              "2:3",
              "9:16"
            ],
            "type": "string"
          },
          "creativity": {
            "default": "medium",
            "description": "Controls how loosely the model interprets the prompt. Higher values produce more creative results that may drift from the prompt; lower values stay closer to the prompt.",
            "title": "Creativity",
            "enum": [
              "raw",
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "styles": {
            "items": {
              "$ref": "#/components/schemas/Style"
            },
            "maxItems": 10,
            "default": [],
            "description": "Optional list of Krea preset styles (LoRA-based) to apply. Each entry references a style by `id` from the Krea styles catalog. At most 10 entries.",
            "title": "Styles",
            "type": "array"
          },
          "seed": {
            "description": "Random seed for reproducible generation.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "maxLength": 5000,
            "examples": [
              "A Van Gogh-tinged Provençal farmhouse under starry nights."
            ],
            "minLength": 1,
            "description": "Text description of the image to generate.",
            "title": "Prompt",
            "type": "string"
          },
          "moodboards": {
            "items": {
              "$ref": "#/components/schemas/Moodboard"
            },
            "maxItems": 1,
            "default": [],
            "description": "Optional moodboard to apply to the generation. Krea currently accepts at most one moodboard per request. Each entry references a moodboard by `id` (UUID).",
            "title": "Moodboards",
            "type": "array"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "image_style_references": {
            "items": {
              "$ref": "#/components/schemas/ImageStyleReference"
            },
            "maxItems": 10,
            "default": [],
            "description": "Optional list of reference images that guide the style of the generated image. At most 10 entries.",
            "title": "Image Style References",
            "type": "array"
          }
        },
        "required": [
          "prompt"
        ],
        "description": "Input for Krea-2 Large image generation.",
        "title": "Krea2LargeInput",
        "type": "object"
      },
      "V2LargeTextToImageOutput": {
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "examples": [
              [
                {
                  "url": "https://v3.fal.media/files/panda/krea_v2_example.png"
                }
              ]
            ],
            "description": "The generated images.",
            "title": "Images",
            "type": "array"
          },
          "seed": {
            "examples": [
              12345
            ],
            "description": "The seed used to generate the image.",
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "images",
          "seed"
        ],
        "title": "Krea2Output",
        "type": "object"
      },
      "Style": {
        "x-fal-order-properties": [
          "id",
          "strength"
        ],
        "properties": {
          "strength": {
            "default": 1,
            "maximum": 2,
            "minimum": -2,
            "title": "Strength",
            "description": "How strongly the style influences the generated image. Negative values push away from the style.",
            "type": "number"
          },
          "id": {
            "description": "Krea style identifier (a LoRA-based preset style) returned by the Krea styles catalog.",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "Style",
        "type": "object"
      },
      "Moodboard": {
        "x-fal-order-properties": [
          "id",
          "strength"
        ],
        "properties": {
          "strength": {
            "default": 0.23,
            "maximum": 1,
            "minimum": 0,
            "title": "Strength",
            "description": "How strongly the moodboard influences the generated image.",
            "type": "number"
          },
          "id": {
            "description": "Krea moodboard identifier (UUID).",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "Moodboard",
        "type": "object"
      },
      "ImageStyleReference": {
        "x-fal-order-properties": [
          "image_url",
          "strength"
        ],
        "properties": {
          "strength": {
            "default": 1,
            "maximum": 2,
            "minimum": -2,
            "title": "Strength",
            "description": "How strongly the reference influences the generated image. Negative values push away from the reference.",
            "type": "number"
          },
          "image_url": {
            "description": "Publicly accessible URL of a reference image.",
            "title": "Image Url",
            "type": "string"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "ImageStyleReference",
        "type": "object"
      },
      "Image": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "height": {
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels.",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels.",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "url"
        ],
        "title": "Image",
        "description": "Represents an image file.",
        "type": "object"
      }
    }
  },
  "paths": {
    "/krea/v2/large/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/krea/v2/large/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/krea/v2/large/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V2LargeTextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/krea/v2/large/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2LargeTextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
