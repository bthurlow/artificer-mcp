{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-22b/text-to-video/lora",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-22b/text-to-video/lora queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-22b/text-to-video/lora",
      "category": "text-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9289c7/bS0a9Lmjo40XfRJfTOEOX__tmp_b008-gold-spiral-stair.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/text-to-video/lora",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/text-to-video/lora/api",
      "about": "Generate a video from a text prompt."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx2322bTextToVideoLoraInput": {
        "properties": {
          "enable_safety_checker": {
            "description": "Whether to enable the safety checker.",
            "title": "Enable Safety Checker",
            "type": "boolean",
            "default": true
          },
          "video_quality": {
            "description": "The quality of the generated video.",
            "title": "Video Quality",
            "type": "string",
            "default": "high",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ]
          },
          "audio_modality_scale": {
            "description": "The modality scale for the audio. Controls the ratio between video and audio modalities.",
            "maximum": 10,
            "title": "Audio Modality Scale",
            "type": "number",
            "default": 3,
            "minimum": 0
          },
          "audio_stg_scale": {
            "description": "The Spatiotemporal Guidance (STG) scale for the audio. Higher values result in more consistent and focused audio content.",
            "maximum": 20,
            "title": "Audio STG Scale",
            "type": "number",
            "default": 0,
            "minimum": 0
          },
          "distill_lora_first_pass_scale": {
            "description": "The scale of the distill LoRA to use for the first pass. Set to 0 to disable.",
            "maximum": 1,
            "title": "Distill Lora First Pass Scale",
            "type": "number",
            "default": 0.2,
            "minimum": 0
          },
          "use_restart_sampling": {
            "description": "Whether to use restart sampling. This will inject a small amount of noise during each denoising step, which can help improve the quality of the generated video.",
            "title": "Use Restart Sampling",
            "type": "boolean",
            "default": false
          },
          "generate_audio": {
            "description": "Whether to generate audio for the video.",
            "title": "Generate Audio",
            "type": "boolean",
            "default": true
          },
          "scheduler": {
            "description": "The scheduler to use.",
            "examples": [
              "ltx2"
            ],
            "title": "Scheduler",
            "type": "string",
            "default": "ltx2",
            "enum": [
              "ltx2",
              "linear_quadratic",
              "beta"
            ]
          },
          "seed": {
            "description": "The seed for the random number generator.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "enable_prompt_expansion": {
            "description": "Whether to enable prompt expansion.",
            "title": "Enable Prompt Expansion",
            "type": "boolean",
            "default": true
          },
          "video_write_mode": {
            "description": "The write mode of the generated video.",
            "title": "Video Write Mode",
            "type": "string",
            "default": "balanced",
            "enum": [
              "fast",
              "balanced",
              "small"
            ]
          },
          "use_multiscale": {
            "description": "Whether to use multi-scale generation. If True, the model will generate the video at a smaller scale first, then use the smaller video to guide the generation of a video at or above your requested size. This results in better coherence and details.",
            "title": "Use Multi-Scale",
            "type": "boolean",
            "default": true
          },
          "video_output_type": {
            "description": "The output type of the generated video.",
            "title": "Video Output Type",
            "type": "string",
            "default": "X264 (.mp4)",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
            ]
          },
          "prompt": {
            "description": "The prompt to generate the video from.",
            "title": "Prompt",
            "type": "string",
            "examples": [
              "A cowboy walking through a dusty town at high noon, camera following from behind, cinematic depth, realistic lighting, western mood, 4K film grain."
            ]
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "type": "boolean",
            "default": false
          },
          "fps": {
            "description": "The frames per second of the generated video.",
            "maximum": 60,
            "title": "FPS",
            "type": "number",
            "default": 24,
            "minimum": 1
          },
          "num_frames": {
            "description": "The number of frames to generate.",
            "maximum": 481,
            "title": "Number of Frames",
            "type": "integer",
            "default": 121,
            "minimum": 9
          },
          "camera_lora": {
            "description": "The camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "examples": [
              "none"
            ],
            "title": "Camera LoRA",
            "type": "string",
            "default": "none",
            "enum": [
              "dolly_in",
              "dolly_out",
              "dolly_left",
              "dolly_right",
              "jib_up",
              "jib_down",
              "static",
              "none"
            ]
          },
          "acceleration": {
            "description": "The acceleration level to use.",
            "examples": [
              "regular"
            ],
            "title": "Acceleration",
            "type": "string",
            "default": "regular",
            "enum": [
              "none",
              "regular",
              "high",
              "full"
            ]
          },
          "loras": {
            "description": "The LoRAs to use for the generation.",
            "items": {
              "$ref": "#/components/schemas/LoRAInput"
            },
            "title": "LoRAs",
            "type": "array"
          },
          "video_rescaling_scale": {
            "description": "The rescaling scale for the video. Controls the ratio between classifier-free guidance and spatiotemporal guidance.",
            "maximum": 1,
            "title": "Video Rescaling Scale",
            "type": "number",
            "default": 0.7,
            "minimum": 0
          },
          "video_stg_scale": {
            "description": "The Spatiotemporal Guidance (STG) scale for the video. Higher values result in more consistent and focused video content.",
            "maximum": 20,
            "title": "Video STG Scale",
            "type": "number",
            "default": 0,
            "minimum": 0
          },
          "distill_lora_second_pass_scale": {
            "description": "The scale of the distill LoRA to use for the second and subsequent passes.",
            "maximum": 1,
            "title": "Distill Lora Second Pass Scale",
            "type": "number",
            "default": 0.5,
            "minimum": 0
          },
          "audio_rescaling_scale": {
            "description": "The rescaling scale for the audio. Controls the ratio between classifier-free guidance and spatiotemporal guidance.",
            "maximum": 1,
            "title": "Audio Rescaling Scale",
            "type": "number",
            "default": 0.7,
            "minimum": 0
          },
          "audio_cfg_scale": {
            "description": "The Classifier-Free Guidance (CFG) scale for the audio. Higher values result in more consistent and focused audio content.",
            "maximum": 20,
            "title": "Audio CFG Scale",
            "type": "number",
            "default": 7,
            "minimum": 1
          },
          "video_cfg_scale": {
            "description": "The Classifier-Free Guidance (CFG) scale for the video. Higher values result in more consistent and focused video content.",
            "maximum": 20,
            "title": "Video CFG Scale",
            "type": "number",
            "default": 3,
            "minimum": 1
          },
          "camera_lora_scale": {
            "description": "The scale of the camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "maximum": 1,
            "title": "Camera LoRA Scale",
            "type": "number",
            "default": 1,
            "minimum": 0
          },
          "video_modality_scale": {
            "description": "The modality scale for the video. Controls the ratio between video and audio modalities.",
            "maximum": 10,
            "title": "Video Modality Scale",
            "type": "number",
            "default": 3,
            "minimum": 0
          },
          "video_size": {
            "description": "The size of the generated video.",
            "title": "Video Size",
            "default": "landscape_16_9",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ]
          },
          "negative_prompt": {
            "description": "The negative prompt to generate the video from.",
            "title": "Negative Prompt",
            "type": "string",
            "default": "news broadcast, 3d animation, computer graphics, pc game, console game, video game, cartoon, childish, watermark, logo, text, on screen text, subtitles, titles, signature, slowmo, static"
          },
          "num_inference_steps": {
            "description": "The number of inference steps to use.",
            "maximum": 50,
            "title": "Number of Inference Steps",
            "type": "integer",
            "default": 40,
            "minimum": 8
          },
          "gradient_estimation_gamma": {
            "description": "The gamma of gradient estimation during denoising. Set to 0 to disable.",
            "maximum": 10,
            "title": "Gradient Estimation Gamma",
            "type": "number",
            "default": 2,
            "minimum": 0
          }
        },
        "title": "LTX23LoRATextToVideoInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
