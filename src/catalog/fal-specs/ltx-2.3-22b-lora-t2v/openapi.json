          }
        }
      }
    },
    "/fal-ai/ltx-2.3-22b/text-to-video/lora/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
