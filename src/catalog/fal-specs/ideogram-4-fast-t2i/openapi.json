{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for ideogram/v4/fast",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the ideogram/v4/fast queue.",
    "x-fal-metadata": {
      "endpointId": "ideogram/v4/fast",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa0cdc0/4AWx22ZkcZYZBZ73YKkdT.jpg",
      "playgroundUrl": "https://fal.ai/models/ideogram/v4/fast",
      "documentationUrl": "https://fal.ai/models/ideogram/v4/fast/api",
      "about": "Generate an image with the fast (CFG-distilled, NVFP4) Ideogram-4 sampler."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V4FastInput": {
        "required": [
          "prompt"
        ],
        "type": "object",
        "title": "DistilledTextToImageInput",
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format"
        ],
        "properties": {
          "image_size": {
            "description": "The resolution of the generated image.",
            "default": "square_hd",
            "title": "Image Size",
            "x-fal": {
              "min_width": 512,
              "min_height": 512,
              "max_width": 2048,
              "max_height": 2048,
              "multiple_of": 16
            },
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ]
          },
          "expansion_model": {
            "examples": [
              "Medium"
            ],
            "type": "string",
            "default": "Medium",
            "title": "Expansion Model",
            "enum": [
              "None",
              "Medium"
            ],
            "description": "Which model expands the prompt. 'None' disables expansion; 'Medium' uses the fast magic prompt model."
          },
          "prompt": {
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ],
            "type": "string",
            "title": "Prompt",
            "description": "The prompt to generate an image from."
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked."
          },
          "seed": {
            "description": "The seed to use for generation. If not provided, a random seed will be used.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_format": {
            "type": "string",
            "default": "jpeg",
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png"
            ],
            "description": "The format of the generated image."
          },
          "sync_mode": {
            "type": "boolean",
            "default": false,
            "title": "Sync Mode",
            "description": "If `True`, the image is returned as a data URI and is not stored."
          },
          "rendering_speed": {
            "type": "string",
            "default": "BALANCED",
            "title": "Rendering Speed",
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps."
          },
          "num_images": {
            "description": "Number of images to generate.",
            "minimum": 1,
            "type": "integer",
            "default": 1,
            "title": "Number of Images",
            "maximum": 4
          }
        }
      },
      "V4FastOutput": {
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "title": "IdeogramV4Output",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ],
            "description": "The generated images.",
            "type": "array",
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          },
          "has_nsfw_concepts": {
            "description": "Whether the generated images contain NSFW concepts.",
            "type": "array",
            "title": "Has Nsfw Concepts",
            "items": {
              "type": "boolean"
            }
          },
          "timings": {
            "type": "object",
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            }
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "The prompt used for generating the image."
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        "
          }
        }
      },
      "ImageSize": {
        "type": "object",
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "description": "The width of the generated image.",
            "type": "integer",
            "default": 512,
            "title": "Width",
            "exclusiveMinimum": 0,
            "maximum": 14142
          },
          "height": {
            "description": "The height of the generated image.",
            "type": "integer",
            "default": 512,
            "title": "Height",
            "exclusiveMinimum": 0,
            "maximum": 14142
          }
        }
      },
      "ImageFile": {
        "required": [
          "url"
        ],
        "type": "object",
        "title": "ImageFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "description": "The width of the image",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "height": {
            "description": "The height of the image",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          }
        }
      }
    }
  },
  "paths": {
    "/ideogram/v4/fast/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/fast/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/fast": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V4FastInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/fast/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V4FastOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
