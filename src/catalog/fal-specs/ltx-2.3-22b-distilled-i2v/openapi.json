            "description": "The size of the file in bytes."
          },
          "fps": {
            "title": "Fps",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The FPS of the video"
          },
          "duration": {
            "title": "Duration",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
