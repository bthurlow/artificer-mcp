      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx2322bDistilledImageToVideoInput": {
        "type": "object",
        "required": [
          "prompt",
          "image_url"
        ],
        "properties": {
          "video_output_type": {
            "type": "string",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
            ],
            "default": "X264 (.mp4)",
            "description": "The output type of the generated video.",
            "title": "Video Output Type"
          },
          "image_url": {
            "type": "string",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/ltxv-2-i2v-input.jpg"
            ],
            "title": "Image URL",
            "description": "The URL of the image to generate the video from."
          },
          "end_image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Image URL",
            "description": "The URL of the image to use as the end of the video."
          },
          "num_frames": {
            "type": "integer",
            "maximum": 481,
            "minimum": 9,
            "default": 121,
            "description": "The number of frames to generate.",
            "title": "Number of Frames"
          },
          "acceleration": {
            "type": "string",
            "enum": [
              "none",
              "regular",
              "high",
              "full"
            ],
            "examples": [
              "none"
            ],
            "default": "none",
            "description": "The acceleration level to use.",
            "title": "Acceleration"
          },
          "interpolation_direction": {
            "type": "string",
            "enum": [
              "forward",
              "backward"
            ],
            "default": "forward",
            "description": "The direction to interpolate the image sequence in. 'Forward' goes from the start image to the end image, 'Backward' goes from the end image to the start image.",
            "title": "Interpolation Direction"
          },
          "camera_lora": {
            "type": "string",
            "enum": [
              "dolly_in",
              "dolly_out",
              "dolly_left",
              "dolly_right",
              "jib_up",
              "jib_down",
              "static",
              "none"
            ],
            "examples": [
              "none"
            ],
            "default": "none",
            "description": "The camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "title": "Camera LoRA"
          },
          "distill_lora_second_pass_scale": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "default": 0.5,
            "description": "The scale of the distill LoRA to use for the second and subsequent passes.",
            "title": "Distill Lora Second Pass Scale"
          },
          "video_quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "default": "high",
            "description": "The quality of the generated video.",
            "title": "Video Quality"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable the safety checker.",
            "title": "Enable Safety Checker"
          },
          "negative_prompt": {
            "type": "string",
            "default": "news broadcast, 3d animation, computer graphics, pc game, console game, video game, cartoon, childish, watermark, logo, text, on screen text, subtitles, titles, signature, slowmo, static",
            "description": "The negative prompt to generate the video from.",
            "title": "Negative Prompt"
          },
          "prompt": {
            "type": "string",
            "examples": [
              "A woman stands still amid a busy neon-lit street at night. The camera slowly dollies in toward her face as people blur past, their motion emphasizing her calm presence. City lights flicker and reflections shift across her denim jacket."
            ],
            "title": "Prompt",
            "description": "The prompt used for the generation."
          },
          "video_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "auto",
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "default": "auto",
            "description": "The size of the generated video.",
            "title": "Video Size"
          },
          "video_write_mode": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "small"
            ],
            "default": "balanced",
            "description": "The write mode of the generated video.",
            "title": "Video Write Mode"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "The seed for the random number generator."
          },
          "enable_prompt_expansion": {
            "type": "boolean",
            "default": true,
            "description": "Whether to enable prompt expansion.",
            "title": "Enable Prompt Expansion"
          },
          "end_image_strength": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "default": 1,
            "description": "The strength of the end image to use for the video generation.",
            "title": "End Image Strength"
          },
          "image_strength": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "default": 1,
            "description": "The strength of the image to use for the video generation.",
            "title": "Image Strength"
          },
          "use_multiscale": {
            "type": "boolean",
            "default": true,
            "description": "Whether to use multi-scale generation. If True, the model will generate the video at a smaller scale first, then use the smaller video to guide the generation of a video at or above your requested size. This results in better coherence and details.",
            "title": "Use Multi-Scale"
          },
          "camera_lora_scale": {
            "type": "number",
            "maximum": 1,
            "minimum": 0,
            "default": 1,
            "description": "The scale of the camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "title": "Camera LoRA Scale"
          },
          "generate_audio": {
            "type": "boolean",
            "default": true,
            "description": "Whether to generate audio for the video.",
            "title": "Generate Audio"
          },
          "sync_mode": {
            "type": "boolean",
            "default": false,
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode"
          },
          "fps": {
            "type": "number",
            "maximum": 60,
            "minimum": 1,
            "default": 24,
            "description": "The frames per second of the generated video.",
            "title": "FPS"
          },
          "scheduler": {
            "type": "string",
            "enum": [
              "ltx2",
              "linear_quadratic",
              "beta"
            ],
            "examples": [
              "ltx2"
            ],
            "default": "ltx2",
            "description": "The scheduler to use.",
            "title": "Scheduler"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "image_url",
          "end_image_url",
          "num_frames",
          "video_size",
          "generate_audio",
          "use_multiscale",
          "fps",
          "scheduler",
          "acceleration",
          "camera_lora",
          "camera_lora_scale",
          "negative_prompt",
          "seed",
          "enable_prompt_expansion",
          "enable_safety_checker",
          "video_output_type",
          "video_quality",
          "video_write_mode",
          "sync_mode",
          "distill_lora_second_pass_scale",
          "interpolation_direction",
          "image_strength",
          "end_image_strength"
        ],
        "title": "LTX23DistilledImageToVideoInput"
      },
