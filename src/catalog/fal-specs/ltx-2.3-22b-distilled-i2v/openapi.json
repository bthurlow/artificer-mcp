{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-22b/distilled/image-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-22b/distilled/image-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-22b/distilled/image-to-video",
      "category": "image-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9289cb/yE3z6Q_sJBywhLxYsyNnB__tmp_b047-ice--phoenix.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/image-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/image-to-video/api",
      "about": "Generate a video from an image and text prompt using distilled LoRA."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
