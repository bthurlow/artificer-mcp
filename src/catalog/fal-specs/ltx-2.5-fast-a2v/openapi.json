{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for lightricks/ltx-2.5/audio-to-video/fast",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the lightricks/ltx-2.5/audio-to-video/fast queue.",
    "x-fal-metadata": {
      "endpointId": "lightricks/ltx-2.5/audio-to-video/fast",
      "category": "audio-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5ebdc/MKczu_IE0mraWaSReg-gx.jpg",
      "playgroundUrl": "https://fal.ai/models/lightricks/ltx-2.5/audio-to-video/fast",
      "documentationUrl": "https://fal.ai/models/lightricks/ltx-2.5/audio-to-video/fast/api",
      "about": "Audio To Video Fast"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx25AudioToVideoFastInput": {
        "required": [
          "audio_url"
        ],
        "type": "object",
        "properties": {
          "image_url": {
            "description": "URL of an image to use as the first frame of the video. If not provided, prompt is required.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image URL",
            "examples": [
              "https://v3b.fal.media/files/b/0a90dfd2/G1zBOgd-17yqZ-2S5TN4j_M3nzt3Sp.png"
            ]
          },
          "audio_url": {
            "description": "URL of the audio file to generate a video from. Duration must be between 2 and 20 seconds; pro models support a maximum of 10 seconds. Must be publicly accessible or base64 data URI.",
            "type": "string",
            "title": "Audio URL",
            "examples": [
              "https://v3b.fal.media/files/b/0a90dfe7/3a-DUXzO79XWIYwUDfHZX_output.mp3"
            ]
          },
          "guidance_scale": {
            "description": "Guidance scale for video generation. Higher values make the output more closely follow the prompt. Defaults to 5 for text-to-video, or 9 when providing an image.",
            "anyOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidance Scale"
          },
          "aspect_ratio": {
            "description": "The aspect ratio of the generated video. If 'auto', the aspect ratio will be determined automatically based on the input image, or defaults to 16:9 if no image is provided.",
            "default": "auto",
            "type": "string",
            "enum": [
              "auto",
              "16:9",
              "9:16"
            ],
            "title": "Aspect Ratio"
          },
          "prompt": {
            "description": "Text description of how the video should be generated. Required if image_url is not provided. When image_url is provided, this describes how the image should be animated.",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "examples": [
              "A woman whispering to the microphone"
            ]
          }
        },
        "title": "LTXV23AudioToVideoRequest",
        "x-fal-order-properties": [
          "audio_url",
          "image_url",
          "prompt",
          "guidance_scale",
          "aspect_ratio"
        ]
      },
      "Ltx25AudioToVideoFastOutput": {
        "required": [
          "video"
        ],
        "type": "object",
        "properties": {
          "video": {
            "description": "The generated video file",
            "$ref": "#/components/schemas/VideoFile",
            "examples": [
              {
                "file_name": "qqP0ClY8E3d83X8y0zLse_shyIe9XU.mp4",
                "url": "https://v3b.fal.media/files/b/0a90dfec/qqP0ClY8E3d83X8y0zLse_shyIe9XU.mp4",
                "content_type": "video/mp4"
              }
            ]
          }
        },
        "title": "LTXV23AudioToVideoResponse",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "VideoFile": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "num_frames": {
            "description": "The number of frames in the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Num Frames"
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "fps": {
            "description": "The FPS of the video",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fps"
          },
          "height": {
            "description": "The height of the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "duration": {
            "description": "The duration of the video",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "width": {
            "description": "The width of the video",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "title": "VideoFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
          "duration",
          "num_frames"
        ]
      }
    }
  },
  "paths": {
    "/lightricks/ltx-2.5/audio-to-video/fast/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/lightricks/ltx-2.5/audio-to-video/fast/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lightricks/ltx-2.5/audio-to-video/fast": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ltx25AudioToVideoFastInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/lightricks/ltx-2.5/audio-to-video/fast/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ltx25AudioToVideoFastOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
