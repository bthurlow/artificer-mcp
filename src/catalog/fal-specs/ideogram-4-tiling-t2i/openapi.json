{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for ideogram/v4/tiling",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the ideogram/v4/tiling queue.",
    "x-fal-metadata": {
      "endpointId": "ideogram/v4/tiling",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9dc187/wgqbs05r1GarIV7-_tmEh_aa72f164e692496a9cbc07285ac20409.jpg",
      "playgroundUrl": "https://fal.ai/models/ideogram/v4/tiling",
      "documentationUrl": "https://fal.ai/models/ideogram/v4/tiling/api",
      "about": "Generate a seamlessly tileable image using Ideogram-4."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V4TilingInput": {
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "acceleration",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_url",
          "mask_url",
          "strength",
          "tiling_mode"
        ],
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "The seed to use for generation. If not provided, a random seed will be used."
          },
          "tiling_mode": {
            "default": "both",
            "description": "Tiling direction: 'both' (omnidirectional), 'horizontal' (left-right only), or 'vertical' (top-bottom only).",
            "title": "Tiling Mode",
            "type": "string",
            "enum": [
              "both",
              "horizontal",
              "vertical"
            ]
          },
          "image_size": {
            "default": "square_hd",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "title": "Image Size",
            "description": "The resolution of the generated seamlessly tileable image."
          },
          "rendering_speed": {
            "default": "BALANCED",
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
            "title": "Rendering Speed",
            "type": "string",
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ]
          },
          "enable_safety_checker": {
            "default": true,
            "title": "Enable Safety Checker",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "type": "boolean"
          },
          "expansion_model": {
            "default": "Medium",
            "examples": [
              "Large"
            ],
            "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
            "title": "Expansion Model",
            "type": "string",
            "enum": [
              "None",
              "Medium",
              "Large"
            ]
          },
          "acceleration": {
            "default": "none",
            "examples": [
              "none"
            ],
            "description": "The acceleration level to use for the image generation.",
            "title": "Acceleration",
            "type": "string",
            "enum": [
              "none",
              "low",
              "regular",
              "high"
            ]
          },
          "strength": {
            "default": 0.8,
            "minimum": 0,
            "description": "How much to transform the input image. Only used when `image_url` is provided.",
            "title": "Strength",
            "maximum": 1,
            "type": "number"
          },
          "mask_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mask Image URL",
            "description": "Optional URL of a mask image for inpainting tiling. White regions are regenerated, black regions are preserved. Requires `image_url`."
          },
          "prompt": {
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ],
            "title": "Prompt",
            "description": "The prompt to generate an image from.",
            "type": "string"
          },
          "output_format": {
            "default": "jpeg",
            "description": "The format of the generated image.",
            "title": "Output Format",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ]
          },
          "sync_mode": {
            "default": false,
            "title": "Sync Mode",
            "description": "If `True`, the image is returned as a data URI and is not stored.",
            "type": "boolean"
          },
          "num_images": {
            "default": 1,
            "minimum": 1,
            "description": "Number of images to generate.",
            "title": "Number of Images",
            "maximum": 4,
            "type": "integer"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image URL",
            "description": "Optional URL of an image. When provided without `mask_url`, performs image-to-image tiling; with `mask_url`, performs inpainting tiling."
          }
        },
        "title": "TilingInput",
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "V4TilingOutput": {
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "seed": {
            "title": "Seed",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer"
          },
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ],
            "title": "Images",
            "description": "The generated images.",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The prompt used for generating the image.",
            "type": "string"
          },
          "has_nsfw_concepts": {
            "title": "Has Nsfw Concepts",
            "description": "Whether the generated images contain NSFW concepts.",
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          }
        },
        "title": "IdeogramV4Output",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "default": 512,
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Height",
            "maximum": 14142,
            "type": "integer"
          },
          "width": {
            "default": 512,
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Width",
            "maximum": 14142,
            "type": "integer"
          }
        },
        "title": "ImageSize",
        "type": "object"
      },
      "ImageFile": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          }
        },
        "title": "ImageFile",
        "required": [
          "url"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/ideogram/v4/tiling/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/tiling/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/tiling": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V4TilingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/tiling/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V4TilingOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
