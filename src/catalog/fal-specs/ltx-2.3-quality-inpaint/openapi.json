{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-quality/inpaint",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-quality/inpaint queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-quality/inpaint",
      "category": "video-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9ecd3d/7azLYGxLaKMGc-hFuaNi-_16b4824b15554f9ab8604903510749a4.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-quality/inpaint",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-quality/inpaint/api",
      "about": "Inpaint masked regions of a source video."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx23QualityInpaintInput": {
        "title": "LTX23QualityInpaintInput",
        "x-fal-order-properties": [
          "prompt",
          "video_url",
          "mask_video_url",
          "video_strength",
          "num_frames",
          "frames_per_second",
          "num_inference_steps",
          "guidance_scale",
          "generate_audio",
          "negative_prompt",
          "seed",
          "enable_prompt_expansion",
          "enable_safety_checker",
          "video_quality",
          "video_write_mode",
          "sync_mode"
        ],
        "type": "object",
        "properties": {
          "mask_video_url": {
            "title": "Mask Video URL",
            "type": "string",
            "description": "The mask video. White regions are regenerated; black regions are preserved from the source video."
          },
          "guidance_scale": {
            "title": "Guidance Scale",
            "minimum": 1,
            "default": 1,
            "type": "number",
            "maximum": 20,
            "description": "Classifier-free guidance scale. The default is tuned for fast, high-quality generation."
          },
          "sync_mode": {
            "title": "Sync Mode",
            "default": false,
            "type": "boolean",
            "description": "If True, the media is returned as a data URI inline in the response. Useful for short-lived requests and tests."
          },
          "prompt": {
            "title": "Prompt",
            "type": "string",
            "examples": [
              "Replace the masked region with matching cinematic background detail."
            ],
            "description": "The prompt describing what to generate inside the masked area."
          },
          "video_quality": {
            "title": "Video Quality",
            "default": "high",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "description": "The quality preset of the generated video."
          },
          "enable_prompt_expansion": {
            "title": "Enable Prompt Expansion",
            "default": true,
            "type": "boolean",
            "description": "Whether to enable prompt expansion."
          },
          "video_strength": {
            "title": "Video Strength",
            "minimum": 0,
            "default": 1,
            "type": "number",
            "maximum": 1,
            "description": "Strength of the IC-LoRA video guide for the preserved content. Higher values keep the source video structure more strongly."
          },
          "video_url": {
            "title": "Video URL",
            "type": "string",
            "description": "The source video to inpaint."
          },
          "negative_prompt": {
            "title": "Negative Prompt",
            "default": "color distortion, overexposure, static, blurry details, subtitles, style, artwork, painting, frame, still, dim overall tone, worst quality, low quality, JPEG compression artifacts, ugly, mutilated, extra fingers, poorly drawn hands, poorly drawn face, deformed, disfigured, malformed limbs, fused fingers, motionless frame, cluttered background, three legs, crowded background, walking backwards",
            "type": "string",
            "description": "The negative prompt to steer generation away from."
          },
          "num_frames": {
            "title": "Number of Frames",
            "minimum": 9,
            "default": 121,
            "type": "integer",
            "maximum": 481,
            "description": "The number of frames to generate."
          },
          "num_inference_steps": {
            "title": "Number of Inference Steps",
            "minimum": 8,
            "default": 15,
            "type": "integer",
            "maximum": 30,
            "description": "Number of inference steps. Defaults to 15 and can be increased up to 30."
          },
          "frames_per_second": {
            "title": "FPS",
            "minimum": 1,
            "default": 24,
            "type": "number",
            "maximum": 60,
            "description": "Frames per second of the generated video."
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility. If None, a random seed is chosen."
          },
          "generate_audio": {
            "title": "Generate Audio",
            "default": true,
            "type": "boolean",
            "description": "Whether to include audio in the returned video. When disabled, the final MP4 is returned without an audio track."
          },
          "video_write_mode": {
            "title": "Video Write Mode",
            "default": "balanced",
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "small"
            ],
            "description": "The write mode of the generated video."
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean",
            "description": "Whether to enable the safety checker."
          }
        },
        "required": [
          "prompt",
          "video_url",
          "mask_video_url"
        ],
        "description": "Video inpainting: regenerate masked regions of a source video."
      },
      "Ltx23QualityInpaintOutput": {
        "title": "LTX23QualityOutput",
        "x-fal-order-properties": [
          "video",
          "seed",
          "prompt"
        ],
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video."
          },
          "seed": {
            "title": "Seed",
            "type": "integer",
            "description": "The seed actually used for generation."
          },
          "prompt": {
            "title": "Prompt",
            "type": "string",
            "description": "The prompt used for generation (after any expansion)."
          }
        },
        "required": [
          "video",
          "seed",
          "prompt"
        ],
        "description": "Standard output for every endpoint on this app."
      },
      "File": {
        "title": "File",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object",
        "properties": {
          "file_name": {
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "content_type": {
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file."
          },
          "file_size": {
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes."
          }
        },
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/fal-ai/ltx-2.3-quality/inpaint/requests/{request_id}/status": {
      "get": {
        "parameters": [
