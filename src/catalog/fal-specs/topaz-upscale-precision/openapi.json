{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for topaz/upscale/image/precision",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the topaz/upscale/image/precision queue.",
    "x-fal-metadata": {
      "endpointId": "topaz/upscale/image/precision",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5f4d2/jP4o7RDGaEMhvRaykFtct.jpg",
      "playgroundUrl": "https://fal.ai/models/topaz/upscale/image/precision",
      "documentationUrl": "https://fal.ai/models/topaz/upscale/image/precision/api",
      "about": "# Topaz Precision Image Upscale (Gigapixel)\n\nClassic (non-generative) upscaling that stays faithful to the\nsource pixels.\n\n## Models\n- **Standard V2** — general-purpose, fits most photos.\n- **High Fidelity V2** — preserves fine detail in professional\nshots.\n- **Low Resolution V2** — recovers compressed, low-quality sources.\n- **CGI** — artwork and rendered graphics.\n- **Text Refine** — keeps text and shapes crisp.\n- **Faces** — Face Recovery 3, restores facial detail."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "UpscaleImagePrecisionInput": {
        "type": "object",
        "properties": {
          "denoise": {
            "description": "Denoising level (0.0-1.0). Default varies by model.",
            "title": "Denoise",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "fix_compression": {
            "description": "Compression artifact removal level (0.0-1.0). Not supported by the CGI model.",
            "title": "Fix Compression",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "face_enhancement_strength": {
            "type": "number",
            "minimum": 0,
            "description": "Strength of the face enhancement. 0.0 means no enhancement, 1.0 means maximum enhancement. Ignored if face enhancement is disabled.",
            "maximum": 1,
            "default": 0.8,
            "title": "Face Enhancement Strength"
          },
          "model": {
            "enum": [
              "Standard V2",
              "High Fidelity V3",
              "High Fidelity V2",
              "Low Resolution V2",
              "CGI",
              "Text Refine",
              "Faces"
            ],
            "type": "string",
            "description": "Precision upscaling model. Standard V2 fits most photos; High Fidelity V3/V2 preserve detail in professional shots; Low Resolution V2 recovers compressed sources; CGI targets art and rendered graphics; Text Refine keeps text and shapes crisp; Faces restores facial detail with Face Recovery 3.",
            "title": "Model",
            "default": "Standard V2"
          },
          "image_url": {
            "type": "string",
            "description": "Url of the image to be upscaled",
            "minLength": 1,
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/codeformer/codeformer_poor_1.jpeg"
            ],
            "title": "Image Url"
          },
          "crop_to_fill": {
            "type": "boolean",
            "title": "Crop To Fill",
            "default": false
          },
          "upscale_factor": {
            "type": "number",
            "minimum": 1,
            "description": "Factor to upscale the image by (e.g. 2.0 doubles width and height)",
            "maximum": 4,
            "default": 2,
            "title": "Upscale Factor"
          },
          "face_enhancement_creativity": {
            "type": "number",
            "minimum": 0,
            "description": "Creativity level for face enhancement. 0.0 means no creativity, 1.0 means maximum creativity. Ignored if face enhancement is disabled.",
            "maximum": 1,
            "default": 0,
            "title": "Face Enhancement Creativity"
          },
          "subject_detection": {
            "enum": [
              "All",
              "Foreground",
              "Background"
            ],
            "type": "string",
            "description": "Subject detection mode for the image enhancement.",
            "title": "Subject Detection",
            "default": "All"
          },
          "sharpen": {
            "description": "Sharpening level (0.0-1.0). Default varies by model.",
            "title": "Sharpen",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "strength": {
            "description": "Enhancement strength (0.01-1.0). Applies to Text Refine model only.",
            "title": "Strength",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png"
            ],
            "type": "string",
            "description": "Output format of the upscaled image.",
            "title": "Output Format",
            "default": "jpeg"
          },
          "face_enhancement": {
            "type": "boolean",
            "description": "Whether to apply face enhancement to the image.",
            "title": "Face Enhancement",
            "default": true
          }
        },
        "x-fal-order-properties": [
          "image_url",
          "model",
          "upscale_factor",
          "crop_to_fill",
          "output_format",
          "subject_detection",
          "face_enhancement",
          "face_enhancement_creativity",
          "face_enhancement_strength",
          "sharpen",
          "denoise",
          "fix_compression",
          "strength"
        ],
        "title": "ImagePrecisionUpscaleRequest",
        "required": [
          "image_url"
        ]
      },
      "UpscaleImagePrecisionOutput": {
        "type": "object",
        "properties": {
          "image": {
            "description": "The upscaled image.",
            "$ref": "#/components/schemas/File"
          }
        },
        "x-fal-order-properties": [
          "image"
        ],
        "title": "ImageUpscaleOutput",
        "required": [
          "image"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "title": "File",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/topaz/upscale/image/precision/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/precision/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/precision": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpscaleImagePrecisionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/precision/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpscaleImagePrecisionOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
