{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for bytedance/seedream/v5/lite/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bytedance/seedream/v5/lite/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "bytedance/seedream/v5/lite/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8f9a87/jRElAKkVlihQHtusciuoI_b73a05e10c45441bb15bce9cbed1bf25.jpg",
      "playgroundUrl": "https://fal.ai/models/bytedance/seedream/v5/lite/text-to-image",
      "documentationUrl": "https://fal.ai/models/bytedance/seedream/v5/lite/text-to-image/api",
      "about": "Generate images using Bytedance's Seedream 5.0 Lite model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "SeedreamV5LiteTextToImageInput": {
        "required": [
          "prompt"
        ],
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_images",
          "max_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "watermark",
          "sequential_image_generation",
          "return_byteplus_urls"
        ],
        "title": "SeedDream50LiteT2IInput",
        "properties": {
          "max_images": {
            "maximum": 15,
            "default": 1,
            "description": "Maximum images per generation in sequential mode. Ignored when sequential generation is disabled. Combined input references and outputs per generation cannot exceed 15.",
            "title": "Max Images",
            "minimum": 1,
            "type": "integer"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false,
            "title": "Sync Mode",
            "type": "boolean"
          },
          "image_size": {
            "description": "The size of the generated image. Custom dimensions within the provider's pixel and aspect limits are sent unchanged. Other sizes use compatible scaling. The provider's native pixel range is 2560x1440 to 4096x4096, with aspect ratio between 1/16 and 16.",
            "default": "auto_2K",
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/SeedreamLiteImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto_2K",
                  "auto_3K",
                  "auto_4K"
                ]
              }
            ]
          },
          "return_byteplus_urls": {
            "description": "If set to true returns seedance-2 trusted URLs. Please note these urls expire in 24 hours.",
            "default": false,
            "title": "Return Byteplus Urls",
            "type": "boolean"
          },
          "output_format": {
            "description": "The file format of the generated images.",
            "default": "jpeg",
            "title": "Output Format",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ]
          },
          "sequential_image_generation": {
            "description": "Generate related images with `auto`, or one image per generation with `disabled`. When omitted, values of `max_images` above one enable `auto`.",
            "title": "Sequential Image Generation",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "disabled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "watermark": {
            "description": "Whether to add the provider's visible watermark.",
            "default": false,
            "title": "Watermark",
            "type": "boolean"
          },
          "prompt": {
            "description": "The text prompt used to generate the image",
            "examples": [
              "Realistic DSLR photograph of anthropomorphic Penkingese dog enjoying a bowl of ramen on the Great Wall of China with the words \"Seedream 5.0 Lite available on fal\" visible at the top."
            ],
            "title": "Prompt",
            "type": "string"
          },
          "num_images": {
            "maximum": 6,
            "default": 1,
            "description": "Number of separate model generations to be run with the prompt.",
            "title": "Num Images",
            "minimum": 1,
            "type": "integer"
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "default": true,
            "examples": [
              true
            ],
            "title": "Enable Safety Checker",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "SeedreamV5LiteTextToImageOutput": {
        "required": [
          "images",
          "seed"
        ],
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "title": "SeedDream50LiteT2IOutput",
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "description": "Generated images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8fbf48/fv693UaOADKqnujJRZN90_4518fc5e1fed4fb29963b22a8cc3d5a6.png"
                }
              ]
            ],
            "title": "Images",
            "type": "array"
          },
          "seed": {
            "description": "Seed used for generation.",
            "examples": [
              42
            ],
            "title": "Seed",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "SeedreamLiteImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "title": "SeedreamLiteImageSize",
        "properties": {
          "height": {
            "maximum": 16384,
            "default": 512,
            "exclusiveMinimum": 0,
            "title": "Height",
            "description": "The height of the generated image.",
            "type": "integer"
          },
          "width": {
            "maximum": 16384,
            "default": 512,
            "exclusiveMinimum": 0,
            "title": "Width",
            "description": "The width of the generated image.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Image": {
        "properties": {
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image in pixels.",
            "title": "Height",
            "examples": [
              1024
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image in pixels.",
            "title": "Width",
            "examples": [
              1024
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          }
        },
        "required": [
          "url"
        ],
        "description": "Represents an image file.",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "title": "Image",
        "type": "object"
      }
    }
  },
  "paths": {
    "/bytedance/seedream/v5/lite/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedreamV5LiteTextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedreamV5LiteTextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
