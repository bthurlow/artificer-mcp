{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2/edit queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/panda/zYjw3YqOcfDQymX7cvMBl_3d76809c48f74eb9abe3e17e1bdd5d2d.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2/edit",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2/edit/api",
      "about": "Image-to-image editing with FLUX.2 [dev] from Black Forest Labs. Precise modifications using natural language descriptions and hex color control."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2EditInput": {
        "required": [
          "prompt",
          "image_urls"
        ],
        "title": "Flux2EditImageInput",
        "x-fal-order-properties": [
          "prompt",
          "guidance_scale",
          "seed",
          "num_inference_steps",
          "image_size",
          "num_images",
          "acceleration",
          "enable_prompt_expansion",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_urls"
        ],
        "properties": {
          "num_inference_steps": {
            "title": "Number of Inference Steps",
            "default": 28,
            "maximum": 50,
            "description": "The number of inference steps to perform.",
            "minimum": 4,
            "type": "integer"
          },
          "enable_prompt_expansion": {
            "title": "Enable Prompt Expansion",
            "default": false,
            "description": "If set to true, the prompt will be expanded for better results.",
            "type": "boolean"
          },
          "guidance_scale": {
            "title": "Guidance Scale",
            "default": 2.5,
            "maximum": 20,
            "description": "Guidance Scale is a measure of how close you want the model to stick to your prompt when looking for a related image to show you.",
            "minimum": 0,
            "type": "number"
          },
          "num_images": {
            "title": "Number of Images",
            "default": 1,
            "maximum": 4,
            "description": "The number of images to generate.",
            "minimum": 1,
            "type": "integer"
          },
          "acceleration": {
            "title": "Acceleration",
            "examples": [
              "regular"
            ],
            "default": "regular",
            "description": "The acceleration level to use for the image generation.",
            "enum": [
              "none",
              "regular",
              "high"
            ],
            "type": "string"
          },
          "output_format": {
            "title": "Output Format",
            "default": "png",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "type": "string"
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "default": true,
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "type": "boolean"
          },
          "image_size": {
            "title": "Image Size",
            "examples": [
              {
                "width": 2016,
                "height": 1152
              }
            ],
            "description": "The size of the image to generate. The width and height must be between 512 and 2048 pixels.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "title": "Image URLs",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/example_inputs/flux2_dev_edit_input.png"
              ]
            ],
            "description": "The URLs of the images for editing. A maximum of 4 images are allowed, if more are provided, only the first 4 will be used.",
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "description": "The seed to use for the generation. If not provided, a random seed will be used.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "title": "Prompt",
            "examples": [
              "Change his clothes to casual suit and tie"
            ],
            "description": "The prompt to edit the image.",
            "type": "string"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "default": false,
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Flux2EditOutput": {
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The prompt used for generating the image.",
            "title": "Prompt"
          },
          "has_nsfw_concepts": {
            "type": "array",
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts",
            "items": {
              "type": "boolean"
            }
          },
          "images": {
            "type": "array",
            "examples": [
              [
                {
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/flux2_dev_edit_output.png"
                }
              ]
            ],
            "description": "The edited images",
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          },
          "timings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings"
          },
          "seed": {
            "type": "integer",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "title": "Seed"
          }
        },
        "title": "Flux2EditImageOutput"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 512,
            "description": "The width of the generated image.",
            "title": "Width",
            "maximum": 14142
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 512,
            "description": "The height of the generated image.",
            "title": "Height",
            "maximum": 14142
          }
        },
        "title": "ImageSize"
      },
      "ImageFile": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "description": "The width of the image",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "height": {
            "description": "The height of the image",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ImageFile"
      }
    }
  },
  "paths": {
    "/fal-ai/flux-2/edit/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/edit/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Flux2EditInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2/edit/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flux2EditOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
