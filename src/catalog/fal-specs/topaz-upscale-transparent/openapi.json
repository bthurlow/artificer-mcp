{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for topaz/upscale/image/transparent",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the topaz/upscale/image/transparent queue.",
    "x-fal-metadata": {
      "endpointId": "topaz/upscale/image/transparent",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa5f55d/DsvCTt3MX3AZXIIibQFbG.jpg",
      "playgroundUrl": "https://fal.ai/models/topaz/upscale/image/transparent",
      "documentationUrl": "https://fal.ai/models/topaz/upscale/image/transparent/api",
      "about": "# Topaz Transparent Image Upscale\n\nUpscales an image while preserving its alpha channel. Output is always\nPNG so transparency is not flattened.\n\nTopaz's Transparency Upscale model always returns a fixed 4x-scaled\nimage regardless of the requested `upscale_factor`; billing reflects\nthat actual (4x) output size rather than the requested factor."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "UpscaleImageTransparentInput": {
        "properties": {
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker"
          },
          "output_format": {
            "type": "string",
            "default": "png",
            "description": "Transparent upscaling always outputs PNG to preserve the alpha channel.",
            "const": "png",
            "title": "Output Format"
          },
          "image_url": {
            "type": "string",
            "description": "Url of the image to process",
            "title": "Image Url",
            "minLength": 1,
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/codeformer/codeformer_poor_1.jpeg"
            ]
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "output_format",
          "enable_safety_checker"
        ],
        "title": "ImageTransparentUpscaleRequest",
        "required": [
          "image_url"
        ]
      },
      "UpscaleImageTransparentOutput": {
        "properties": {
          "image": {
            "description": "The upscaled image.",
            "$ref": "#/components/schemas/File"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "image"
        ],
        "title": "ImageUpscaleOutput",
        "required": [
          "image"
        ]
      },
      "File": {
        "properties": {
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "title": "File",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/topaz/upscale/image/transparent/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/transparent/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/transparent": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpscaleImageTransparentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/topaz/upscale/image/transparent/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpscaleImageTransparentOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
