{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for ideogram/v4/image-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the ideogram/v4/image-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "ideogram/v4/image-to-image",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9dc0d8/Sk7dDmlNxtuNqrIC5PGqo_cb68a0ee29c44a729d67bd251546ba63.jpg",
      "playgroundUrl": "https://fal.ai/models/ideogram/v4/image-to-image",
      "documentationUrl": "https://fal.ai/models/ideogram/v4/image-to-image/api",
      "about": "Generate an image from an input image using Ideogram-4."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V4ImageToImageInput": {
        "properties": {
          "image_url": {
            "type": "string",
            "description": "URL of the input image for image-to-image generation.",
            "title": "Image URL",
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/svd/rocket.png"
            ]
          },
          "image_size": {
            "title": "Image Size",
            "default": "auto",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ],
                "type": "string"
              }
            ],
            "description": "The output image size. Use 'auto' to match the input image size (capped at ~25MP, up to 8192px per side)."
          },
          "num_images": {
            "minimum": 1,
            "maximum": 4,
            "type": "integer",
            "description": "Number of images to generate.",
            "title": "Number of Images",
            "default": 1
          },
          "strength": {
            "minimum": 0,
            "default": 0.8,
            "maximum": 1,
            "type": "number",
            "description": "How much to transform the input image. 1.0 ignores the input image entirely; lower values stay closer to it.",
            "title": "Strength"
          },
          "prompt": {
            "type": "string",
            "description": "The prompt to generate an image from.",
            "title": "Prompt",
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ]
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "The seed to use for generation. If not provided, a random seed will be used."
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the image is returned as a data URI and is not stored.",
            "title": "Sync Mode"
          },
          "acceleration": {
            "enum": [
              "none",
              "low",
              "regular",
              "high"
            ],
            "default": "none",
            "type": "string",
            "description": "The acceleration level to use for the image generation.",
            "title": "Acceleration",
            "examples": [
              "none"
            ]
          },
          "rendering_speed": {
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "default": "BALANCED",
            "type": "string",
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
            "title": "Rendering Speed"
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "type": "string",
            "description": "The format of the generated image.",
            "title": "Output Format"
          },
          "enable_safety_checker": {
            "default": true,
            "type": "boolean",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker"
          },
          "expansion_model": {
            "enum": [
              "None",
              "Medium",
              "Large"
            ],
            "examples": [
              "Large"
            ],
            "default": "Medium",
            "type": "string",
            "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
            "title": "Expansion Model"
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "acceleration",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_url",
          "strength"
        ],
        "type": "object",
        "title": "ImageToImageInput",
        "required": [
          "prompt",
          "image_url"
        ]
      },
      "V4ImageToImageOutput": {
        "properties": {
          "seed": {
            "type": "integer",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "title": "Seed"
          },
          "timings": {
            "type": "object",
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            }
          },
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array",
            "description": "The generated images.",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ]
          },
          "prompt": {
            "type": "string",
            "description": "The prompt used for generating the image.",
            "title": "Prompt"
          }
        },
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "title": "IdeogramV4Output",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ]
      },
      "ImageSize": {
        "properties": {
          "height": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Height"
          },
          "width": {
            "default": 512,
            "maximum": 14142,
            "type": "integer",
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "title": "Width"
          }
        },
        "type": "object",
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ]
      },
      "ImageFile": {
        "properties": {
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object",
        "title": "ImageFile",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/ideogram/v4/image-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V4ImageToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V4ImageToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
