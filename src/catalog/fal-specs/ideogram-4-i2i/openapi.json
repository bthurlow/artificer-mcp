{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for ideogram/v4/image-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the ideogram/v4/image-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "ideogram/v4/image-to-image",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9dc0d8/Sk7dDmlNxtuNqrIC5PGqo_cb68a0ee29c44a729d67bd251546ba63.jpg",
      "playgroundUrl": "https://fal.ai/models/ideogram/v4/image-to-image",
      "documentationUrl": "https://fal.ai/models/ideogram/v4/image-to-image/api",
      "about": "Generate an image from an input image using Ideogram-4."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V4ImageToImageInput": {
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "acceleration",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_url",
          "strength"
        ],
        "properties": {
          "seed": {
            "description": "The seed to use for generation. If not provided, a random seed will be used.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "image_size": {
            "description": "The output image size. Use 'auto' to match the input image size (capped at ~25MP, up to 8192px per side).",
            "default": "auto",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ]
              }
            ],
            "title": "Image Size"
          },
          "strength": {
            "maximum": 1,
            "minimum": 0,
            "description": "How much to transform the input image. 1.0 ignores the input image entirely; lower values stay closer to it.",
            "default": 0.8,
            "type": "number",
            "title": "Strength"
          },
          "expansion_model": {
            "type": "string",
            "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
            "default": "Medium",
            "enum": [
              "None",
              "Medium",
              "Large"
            ],
            "title": "Expansion Model",
            "examples": [
              "Large"
            ]
          },
          "num_images": {
            "maximum": 4,
            "minimum": 1,
            "description": "Number of images to generate.",
            "default": 1,
            "type": "integer",
            "title": "Number of Images"
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "default": true,
            "type": "boolean",
            "title": "Enable Safety Checker"
          },
          "output_format": {
            "description": "The format of the generated image.",
            "default": "jpeg",
            "enum": [
              "jpeg",
              "png"
            ],
            "title": "Output Format",
            "type": "string"
          },
          "rendering_speed": {
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
            "default": "BALANCED",
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "title": "Rendering Speed",
            "type": "string"
          },
          "prompt": {
            "description": "The prompt to generate an image from.",
            "type": "string",
            "title": "Prompt",
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ]
          },
          "acceleration": {
            "description": "The acceleration level to use for the image generation.",
            "default": "none",
            "enum": [
              "none",
              "low",
              "regular",
              "high"
            ],
            "title": "Acceleration",
            "examples": [
              "none"
            ],
            "type": "string"
          },
          "image_url": {
            "description": "URL of the input image for image-to-image generation.",
            "type": "string",
            "title": "Image URL",
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/svd/rocket.png"
            ]
          },
          "sync_mode": {
            "description": "If `True`, the image is returned as a data URI and is not stored.",
            "default": false,
            "type": "boolean",
            "title": "Sync Mode"
          }
        },
        "required": [
          "prompt",
          "image_url"
        ],
        "type": "object",
        "title": "ImageToImageInput"
      },
      "V4ImageToImageOutput": {
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "images": {
            "description": "The generated images.",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "type": "array",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ]
          },
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer",
            "title": "Seed"
          },
          "has_nsfw_concepts": {
            "description": "Whether the generated images contain NSFW concepts.",
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "title": "Has Nsfw Concepts"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "type": "string",
            "title": "Prompt"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings"
          }
        },
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "title": "IdeogramV4Output"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "maximum": 14142,
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "default": 512,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "maximum": 14142,
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "default": 512,
            "title": "Width",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "ImageSize"
      },
      "ImageFile": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "height": {
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "width": {
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "ImageFile"
      }
    }
  },
  "paths": {
    "/ideogram/v4/image-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V4ImageToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V4ImageToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
