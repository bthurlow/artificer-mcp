{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for ideogram/v4/image-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the ideogram/v4/image-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "ideogram/v4/image-to-image",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9dc0d8/Sk7dDmlNxtuNqrIC5PGqo_cb68a0ee29c44a729d67bd251546ba63.jpg",
      "playgroundUrl": "https://fal.ai/models/ideogram/v4/image-to-image",
      "documentationUrl": "https://fal.ai/models/ideogram/v4/image-to-image/api",
      "about": "Generate an image from an input image using Ideogram-4."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V4ImageToImageInput": {
        "required": [
          "prompt",
          "image_url"
        ],
        "properties": {
          "expansion_model": {
            "examples": [
              "Large"
            ],
            "default": "Medium",
            "type": "string",
            "description": "Which model expands the prompt. 'None' disables prompt expansion and skips its fee; 'Medium' is fast; 'Large' uses Ideogram's Magic Prompt for the highest quality.",
            "enum": [
              "None",
              "Medium",
              "Large"
            ],
            "title": "Expansion Model"
          },
          "prompt": {
            "examples": [
              "A red panda perched on a mossy branch in a misty forest at sunrise"
            ],
            "description": "The prompt to generate an image from.",
            "title": "Prompt",
            "type": "string"
          },
          "image_size": {
            "default": "auto",
            "description": "The output image size. Use 'auto' to match the input image size (capped at ~25MP, up to 8192px per side).",
            "title": "Image Size",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ],
                "type": "string"
              }
            ]
          },
          "strength": {
            "default": 0.8,
            "type": "number",
            "minimum": 0,
            "description": "How much to transform the input image. 1.0 ignores the input image entirely; lower values stay closer to it.",
            "maximum": 1,
            "title": "Strength"
          },
          "output_format": {
            "title": "Output Format",
            "description": "The format of the generated image.",
            "enum": [
              "jpeg",
              "png"
            ],
            "type": "string",
            "default": "jpeg"
          },
          "acceleration": {
            "examples": [
              "none"
            ],
            "title": "Acceleration",
            "description": "The acceleration level to use for the image generation.",
            "enum": [
              "none",
              "low",
              "regular",
              "high"
            ],
            "type": "string",
            "default": "none"
          },
          "num_images": {
            "title": "Number of Images",
            "minimum": 1,
            "description": "Number of images to generate.",
            "maximum": 4,
            "type": "integer",
            "default": 1
          },
          "sync_mode": {
            "description": "If `True`, the image is returned as a data URI and is not stored.",
            "title": "Sync Mode",
            "type": "boolean",
            "default": false
          },
          "image_url": {
            "examples": [
              "https://storage.googleapis.com/falserverless/model_tests/svd/rocket.png"
            ],
            "description": "URL of the input image for image-to-image generation.",
            "title": "Image URL",
            "type": "string"
          },
          "rendering_speed": {
            "default": "BALANCED",
            "type": "string",
            "description": "The rendering speed to use. Faster speeds use fewer denoising steps.",
            "enum": [
              "TURBO",
              "BALANCED",
              "QUALITY"
            ],
            "title": "Rendering Speed"
          },
          "seed": {
            "description": "The seed to use for generation. If not provided, a random seed will be used.",
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker",
            "type": "boolean",
            "default": true
          }
        },
        "title": "ImageToImageInput",
        "x-fal-order-properties": [
          "prompt",
          "expansion_model",
          "image_size",
          "rendering_speed",
          "acceleration",
          "num_images",
          "seed",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "image_url",
          "strength"
        ],
        "type": "object"
      },
      "V4ImageToImageOutput": {
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts",
            "type": "array"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          },
          "prompt": {
            "description": "The prompt used for generating the image.",
            "title": "Prompt",
            "type": "string"
          },
          "seed": {
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "title": "Seed",
            "type": "integer"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9c92b2/JLDtkHeeec2BL7ZX3PyvI_KzumHcSa.jpg"
                }
              ]
            ],
            "description": "The generated images.",
            "title": "Images",
            "type": "array"
          }
        },
        "title": "IdeogramV4Output",
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object"
      },
      "ImageSize": {
        "properties": {
          "height": {
            "title": "Height",
            "exclusiveMinimum": 0,
            "description": "The height of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "default": 512
          },
          "width": {
            "title": "Width",
            "exclusiveMinimum": 0,
            "description": "The width of the generated image.",
            "maximum": 14142,
            "type": "integer",
            "default": 512
          }
        },
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "ImageFile": {
        "required": [
          "url"
        ],
        "properties": {
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "description": "The width of the image",
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "height": {
            "description": "The height of the image",
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ImageFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/ideogram/v4/image-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V4ImageToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ideogram/v4/image-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V4ImageToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
