{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2/klein/9b",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2/klein/9b queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2/klein/9b",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8a7f3c/90FKDpwtSCZTqOu0jUI-V_64c1a6ec0f9343908d9efa61b7f2444b.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2/klein/9b/api",
      "about": "Text-to-image with FLUX.2 [klein] 9B distilled model. Fast 4-step generation."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2Klein9bInput": {
        "title": "Klein9BDistilledInput",
        "required": [
          "prompt"
        ],
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "num_inference_steps",
          "image_size",
          "num_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format"
        ],
        "properties": {
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
            "default": true,
            "type": "boolean"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI. Output is not stored when this is True.",
            "default": false,
            "type": "boolean"
          },
          "num_inference_steps": {
            "title": "Number of Inference Steps",
            "minimum": 4,
            "maximum": 8,
            "default": 4,
            "description": "The number of inference steps to perform.",
            "type": "integer"
          },
          "num_images": {
            "title": "Number of Images",
            "minimum": 1,
            "maximum": 4,
            "default": 1,
            "description": "The number of images to generate.",
            "type": "integer"
          },
          "seed": {
            "title": "Seed",
            "description": "The seed to use for the generation. If not provided, a random seed will be used.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "image_size": {
            "title": "Image Size",
            "description": "The size of the image to generate.",
            "default": "landscape_4_3",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              }
            ]
          },
          "output_format": {
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "png",
            "description": "The format of the generated image.",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The prompt to generate an image from.",
            "examples": [
              "A bright, surreal scene on a vast white salt flat under a clear blue sky, featuring two fluffy white alpacas standing in the foreground. Behind them sits a sleek white supercar with its scissor doors open, creating a dramatic futuristic silhouette. The sunlight is strong and crisp, casting sharp shadows on the ground and giving the image a clean, high-contrast cinematic look. Minimalist composition, playful luxury vibe, ultra sharp detail, wide-angle perspective, high resolution."
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Flux2Klein9bOutput": {
        "title": "Klein9BDistilledT2IOutput",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "properties": {
          "has_nsfw_concepts": {
            "items": {
              "type": "boolean"
            },
            "description": "Whether the generated images contain NSFW concepts.",
            "title": "Has Nsfw Concepts",
            "type": "array"
          },
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            },
            "description": "The generated images",
            "title": "Images",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8a6905/DuNRy1OODaGrlUGEfl9SX.png"
                }
              ]
            ],
            "type": "array"
          },
          "timings": {
            "title": "Timings",
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "seed": {
            "title": "Seed",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The prompt used for generating the image.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ImageSize": {
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "title": "Height",
            "description": "The height of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "description": "The width of the generated image.",
            "maximum": 14142,
            "default": 512,
            "exclusiveMinimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ImageFile": {
        "title": "ImageFile",
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "title": "Height",
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          }
        },
        "type": "object"
      }
    }
  },
