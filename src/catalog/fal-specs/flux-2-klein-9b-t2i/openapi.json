                }
              ]
            ],
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          }
        },
        "type": "object",
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "title": "Klein9BDistilledT2IOutput"
      },
      "ImageSize": {
        "properties": {
          "width": {
            "title": "Width",
            "default": 512,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The width of the generated image."
          },
          "height": {
            "title": "Height",
            "default": 512,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The height of the generated image."
