{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/vidu/q3/image-to-video/turbo",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/vidu/q3/image-to-video/turbo queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/vidu/q3/image-to-video/turbo",
      "category": "image-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8d6e07/fD4jASVWB2HcQCVy2wpCd_857d6e5041134ad3a094285c4adb2e94.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/vidu/q3/image-to-video/turbo",
      "documentationUrl": "https://fal.ai/models/fal-ai/vidu/q3/image-to-video/turbo/api",
      "about": "Vidu Q3 Turbo Image to Video API: Generate a video from a single image using the Q3 Turbo model with faster generation speed."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "ViduQ3ImageToVideoTurboInput": {
        "properties": {
          "end_image_url": {
            "description": "URL of the image to use as the ending frame. When provided, generates a transition video between start and end frames.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Image Url"
          },
          "image_url": {
            "examples": [
              "https://prod-ss-images.s3.cn-northwest-1.amazonaws.com.cn/vidu-maas/template/image2video.png"
            ],
            "description": "URL or base64 image to use as the starting frame",
            "title": "Image Url",
            "type": "string"
          },
          "prompt": {
            "default": "",
            "description": "Text prompt for video generation, max 2000 characters",
            "title": "Prompt",
            "type": "string",
            "maxLength": 2000,
            "examples": [
              "The astronaut waved and the camera moved up."
            ]
          },
          "resolution": {
            "default": "720p",
            "description": "Output video resolution. Note: 360p is not available when end_image_url is provided.",
            "title": "Resolution",
            "type": "string",
            "enum": [
              "360p",
              "540p",
              "720p",
              "1080p"
            ]
          },
          "audio": {
            "default": true,
            "description": "Whether to use direct audio-video generation. When true, outputs video with sound (including dialogue and sound effects).",
            "title": "Audio",
            "type": "boolean"
          },
          "duration": {
            "default": 5,
            "description": "Duration of the video in seconds (1-16 for Q3 models)",
            "title": "Duration",
            "type": "integer",
            "maximum": 16,
            "minimum": 1
          },
          "seed": {
            "description": "Random seed for reproducibility. If None, a random seed is chosen.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "Q3ImageToVideoRequest",
        "required": [
          "image_url"
        ],
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_url",
          "end_image_url",
          "duration",
          "seed",
          "resolution",
          "audio"
        ]
      },
      "ViduQ3ImageToVideoTurboOutput": {
        "properties": {
          "video": {
            "examples": [
              {
                "url": "https://v3b.fal.media/files/b/0a8c9189/n9z3uUDPqmU2msAtqr25-_output.mp4"
              }
            ],
            "$ref": "#/components/schemas/File",
            "description": "The generated video from image using the Q3 model"
          }
        },
        "title": "Q3ImageToVideoOutput",
        "required": [
          "video"
        ],
        "type": "object",
        "x-fal-order-properties": [
          "video"
        ]
      },
      "File": {
        "properties": {
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "file_size": {
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          }
        },
        "title": "File",
        "required": [
          "url"
        ],
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      }
    }
  },
  "paths": {
    "/fal-ai/vidu/q3/image-to-video/turbo/requests/{request_id}/status": {
      "get": {
        "parameters": [
