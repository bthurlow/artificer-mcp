              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/vidu/q3/image-to-video/turbo/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
