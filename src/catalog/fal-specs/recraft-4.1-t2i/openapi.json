{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/recraft/v4.1/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/recraft/v4.1/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/recraft/v4.1/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9a2972/dIomIOjaf_WjuINZkjGWQ_e2a8500d97f74dfdad75ba8cbd41d6e5.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/recraft/v4.1/text-to-image",
      "documentationUrl": "https://fal.ai/models/fal-ai/recraft/v4.1/text-to-image/api",
      "about": "Recraft V4 1"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "RecraftV41TextToImageInput": {
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "colors",
          "background_color",
          "enable_safety_checker"
        ],
        "properties": {
          "prompt": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Prompt",
            "examples": [
              "Tilt-shift miniature effect on a real Portuguese fishing village at golden hour, colorful boats in the harbor appearing toy-like, selective focus band across the middle, saturated primary colors of blue red and yellow boats against white buildings, 90mm tilt-shift lens, the familiar made fantastical, Wes Anderson color sensibility"
            ],
            "type": "string"
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean"
          },
          "image_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "title": "Image Size",
            "examples": [
              "landscape_16_9"
            ],
            "default": "square_hd"
          },
          "colors": {
            "description": "An array of preferable colors",
            "items": {
              "$ref": "#/components/schemas/RGBColor"
            },
            "title": "Colors",
            "default": [],
            "type": "array"
          },
          "background_color": {
            "description": "The preferable background color of the generated images.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/RGBColor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "RecraftV4TextToImageInput",
        "required": [
          "prompt"
        ],
        "type": "object"
      },
      "RecraftV41TextToImageOutput": {
        "x-fal-order-properties": [
          "images"
        ],
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "title": "Images",
            "examples": [
              [
                {
                  "file_name": "image.webp",
                  "content_type": "image/webp",
                  "file_size": 272628,
                  "url": "https://storage.googleapis.com/falserverless/example_outputs/recraft-v4/standard-output.webp"
                }
              ]
            ],
            "type": "array"
          }
        },
        "title": "RecraftV4TextToImageOutput",
        "required": [
          "images"
        ],
        "type": "object"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "description": "The width of the generated image.",
            "maximum": 14142,
            "title": "Width",
            "default": 512,
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "integer",
            "description": "The height of the generated image.",
            "maximum": 14142,
            "title": "Height",
            "default": 512,
            "exclusiveMinimum": 0
          }
        },
        "title": "ImageSize",
        "type": "object"
      },
      "RGBColor": {
        "x-fal-order-properties": [
          "r",
          "g",
          "b"
        ],
        "properties": {
          "g": {
            "title": "G",
            "description": "Green color value",
            "maximum": 255,
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          "b": {
            "title": "B",
            "description": "Blue color value",
            "maximum": 255,
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          "r": {
            "title": "R",
            "description": "Red color value",
            "maximum": 255,
            "type": "integer",
            "default": 0,
            "minimum": 0
          }
        },
        "title": "RGBColor",
        "type": "object"
      },
      "File": {
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "properties": {
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "title": "File",
        "required": [
          "url"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/fal-ai/recraft/v4.1/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecraftV41TextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/recraft/v4.1/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecraftV41TextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
