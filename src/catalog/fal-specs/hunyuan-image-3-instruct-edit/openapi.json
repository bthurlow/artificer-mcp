      "HunyuanImageV3InstructEditInput": {
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_images",
          "guidance_scale",
          "enable_prompt_expansion",
          "seed",
          "enable_safety_checker",
          "sync_mode",
          "output_format",
          "image_urls"
        ],
        "type": "object",
        "properties": {
          "output_format": {
            "description": "The format of the generated image.",
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "png",
            "title": "Output Format"
          },
          "prompt": {
            "description": "The text prompt to generate an image from.",
            "type": "string",
            "examples": [
              "Turn this artwork into a realistic image"
            ],
            "title": "Prompt"
          },
          "seed": {
            "description": "Random seed for reproducible results. If None, a random seed is used.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "image_size": {
            "description": "The desired size of the generated image. If auto, image size will be determined by the model.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "auto",
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "default": "auto",
            "title": "Image Size"
          },
          "enable_prompt_expansion": {
            "description": "If set to true, the prompt will be expanded through the model's internal recaptioning step.",
            "type": "boolean",
            "default": true,
            "title": "Enable Prompt Expansion"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "type": "boolean",
            "default": false,
            "title": "Sync Mode"
          },
          "num_images": {
            "maximum": 4,
            "description": "The number of images to generate.",
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "title": "Num Images"
          },
          "guidance_scale": {
            "maximum": 20,
            "description": "Controls how much the model adheres to the prompt. Higher values mean stricter adherence.",
            "type": "number",
            "exclusiveMinimum": 1,
            "default": 3.5,
            "title": "Guidance Scale"
          },
          "enable_safety_checker": {
            "description": "If set to true, the safety checker will be enabled.",
            "type": "boolean",
            "default": true,
            "title": "Enable Safety Checker"
          },
          "image_urls": {
            "description": "The URLs of the images to use as a reference for the generation. A maximum of 3 images are supported.",
            "type": "array",
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8c3cf9/voXcX8hd5maRSrSvZalXh_jAMqrScj.png"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Image Urls"
          }
        },
        "required": [
          "prompt",
          "image_urls"
        ],
        "title": "HunyuanImageEditRequest"
      },
