{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/kling-image/v3/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/kling-image/v3/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/kling-image/v3/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8cfd08/Ji4e0i6Afbeql3Wr5UTz6_ab60b14661424612bf19059e97e996a5.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/kling-image/v3/text-to-image",
      "documentationUrl": "https://fal.ai/models/fal-ai/kling-image/v3/text-to-image/api",
      "about": "Generate images from text using Kling V3 Standard model.\n\nText-to-image generation with optional element control (face).\nResolution up to 2K with multiple aspect ratio options."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "KlingImageV3TextToImageInput": {
        "title": "V3TextToImageRequest",
        "x-fal-order-properties": [
          "prompt",
          "negative_prompt",
          "elements",
          "resolution",
          "num_images",
          "aspect_ratio",
          "output_format",
          "sync_mode",
          "enable_safety_checker"
        ],
        "description": "Request model for Kling V3 Text-to-Image Generation.",
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "description": "Aspect ratio of generated images.",
            "type": "string",
            "title": "Aspect Ratio",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "3:2",
              "2:3",
              "21:9"
            ]
          },
          "negative_prompt": {
            "anyOf": [
              {
                "maxLength": 2500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Negative text prompt. It is recommended to supplement negative prompt information through negative sentences directly within positive prompts.",
            "title": "Negative Prompt"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "type": "boolean",
            "title": "Enable Safety Checker"
          },
          "elements": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ElementInput"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional: Elements (characters/objects) to include in the image for face control. Each element can have a frontal image and optionally reference images.",
            "title": "Elements"
          },
          "output_format": {
            "default": "png",
            "description": "The format of the generated image.",
            "type": "string",
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          },
          "num_images": {
            "minimum": 1,
            "default": 1,
            "description": "Number of images to generate (1-9).",
            "type": "integer",
            "title": "Num Images",
            "maximum": 9
          },
          "prompt": {
            "maxLength": 2500,
            "description": "Text prompt for image generation. Max 2500 characters.",
            "type": "string",
            "title": "Prompt",
            "examples": [
              "Extremely realistic image of a scholar's study filled with maps and curiosities, roaring fireplace, rain against round windows, stacks of handwritten journals, warm tungsten lighting, inviting atmosphere. The scholar is sitting on a chair."
            ]
          },
          "sync_mode": {
            "default": false,
            "description": "If `True`, the media will be returned as a data URI.",
            "type": "boolean",
            "title": "Sync Mode"
          },
          "resolution": {
            "default": "1K",
            "description": "Image generation resolution. 1K: standard, 2K: high-res.",
            "type": "string",
            "title": "Resolution",
            "enum": [
              "1K",
              "2K"
            ]
          }
        }
      },
      "KlingImageV3TextToImageOutput": {
        "title": "T2IV3ImageOutput",
        "x-fal-order-properties": [
          "images"
        ],
        "description": "Output model for Kling V3 Image Generation.",
        "type": "object",
        "required": [
          "images"
        ],
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8d0681/Qos5QbCS93YpsPzZ3i8zT_a889cacced76430d85d08c60ca3d023d.png",
                  "file_size": 1637946,
                  "file_name": "a889cacced76430d85d08c60ca3d023d.png",
                  "content_type": "image/png"
                }
              ]
            ],
            "description": "Generated images",
            "type": "array",
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        }
      },
      "ElementInput": {
        "x-fal-order-properties": [
          "frontal_image_url",
          "reference_image_urls"
        ],
        "description": "Element input for image generation with face/character control.\n\nCreate an element by providing frontal_image_url (and optionally reference_image_urls).\nAll fields are optional - provide what you have available.",
        "type": "object",
        "properties": {
          "frontal_image_url": {
            "anyOf": [
              {
                "x-fal": {
                  "timeout": 20,
                  "max_file_size": 10485760,
                  "min_height": 300,
                  "min_width": 300,
                  "max_aspect_ratio": 2.5,
                  "min_aspect_ratio": 0.4
                },
                "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                "type": "string",
                "_fal_ui_field": "image",
                "ui": {
                  "field": "image"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The frontal image of the element (main view). Optional.",
            "title": "Frontal Image Url"
          },
          "reference_image_urls": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "x-fal": {
                    "timeout": 20,
                    "max_file_size": 10485760,
                    "min_height": 300,
                    "min_width": 300,
                    "max_aspect_ratio": 2.5,
                    "min_aspect_ratio": 0.4
                  },
                  "limit_description": "Max file size: 10.0MB, Min width: 300px, Min height: 300px, Min aspect ratio: 0.40, Max aspect ratio: 2.50, Timeout: 20.0s",
                  "type": "string",
                  "_fal_ui_field": "image",
                  "ui": {
                    "field": "image"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Additional reference images from different angles. 0-3 images supported. Optional.",
            "title": "Reference Image Urls"
          }
        },
        "title": "ElementInput"
      },
      "Image": {
        "title": "Image",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "type": "string",
            "title": "Url"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image in pixels.",
            "title": "Width",
            "examples": [
              1024
            ]
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image in pixels.",
            "title": "Height",
            "examples": [
              1024
            ]
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "description": "Represents an image file."
      }
    }
  },
  "paths": {
    "/fal-ai/kling-image/v3/text-to-image/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/kling-image/v3/text-to-image/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/kling-image/v3/text-to-image": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KlingImageV3TextToImageInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/kling-image/v3/text-to-image/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KlingImageV3TextToImageOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
