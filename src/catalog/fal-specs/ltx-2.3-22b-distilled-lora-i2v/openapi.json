      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9289ce/20zCxq0nC6akyUyph0bID__tmp_b066-silk-cactus-bloom.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/image-to-video/lora",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/image-to-video/lora/api",
