            "type": "number",
            "default": 1,
            "title": "Scale",
            "minimum": 0
          },
          "path": {
            "description": "URL, HuggingFace repo ID (owner/repo) to lora weights.",
            "title": "Path",
            "type": "string"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "path",
          "weight_name",
          "scale"
        ],
        "required": [
          "path"
        ],
        "title": "LoRAInput"
      },
      "VideoFile": {
        "required": [
