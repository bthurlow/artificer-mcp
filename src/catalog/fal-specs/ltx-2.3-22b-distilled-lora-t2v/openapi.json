      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/text-to-video/lora",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-22b/distilled/text-to-video/lora/api",
      "about": "Generate a video from a text prompt using distilled LoRA."
    }
