                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "default": "landscape_16_9",
            "title": "Video Size",
            "description": "The size of the generated video."
          }
        },
        "required": [
          "loras",
          "prompt"
        ],
        "title": "LTX23LoRADistilledTextToVideoInput"
