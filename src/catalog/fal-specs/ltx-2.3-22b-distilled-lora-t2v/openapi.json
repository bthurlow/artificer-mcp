  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-22b/distilled/text-to-video/lora",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-22b/distilled/text-to-video/lora queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-22b/distilled/text-to-video/lora",
