            "enum": [
              "ltx2",
              "linear_quadratic",
              "beta"
            ],
            "title": "Scheduler",
            "description": "The scheduler to use."
          },
          "video_output_type": {
            "type": "string",
            "default": "X264 (.mp4)",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
