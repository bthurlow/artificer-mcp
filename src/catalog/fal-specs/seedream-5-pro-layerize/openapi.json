{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bytedance/seedream/v5/pro/layerize",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bytedance/seedream/v5/pro/layerize queue.",
    "x-fal-metadata": {
      "endpointId": "bytedance/seedream/v5/pro/layerize",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa54061/xMXvGqLxX4a1MzEv6H-jN.jpg",
      "playgroundUrl": "https://fal.ai/models/bytedance/seedream/v5/pro/layerize",
      "documentationUrl": "https://fal.ai/models/bytedance/seedream/v5/pro/layerize/api",
      "about": "Decompose an image into a base image and independently editable layers."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "SeedreamV5ProLayerizeInput": {
        "title": "SeedDream50ProLayerizeInput",
        "x-fal-order-properties": [
          "prompt",
          "image_url",
          "image_size",
          "sync_mode",
          "enable_safety_checker",
          "enhance_prompt_mode"
        ],
        "required": [
          "image_url"
        ],
        "type": "object",
        "properties": {
          "enhance_prompt_mode": {
            "default": "standard",
            "type": "string",
            "description": "Prompt optimization mode. `standard` prioritizes image quality; `fast` reduces generation time.",
            "enum": [
              "standard",
              "fast"
            ],
            "title": "Enhance Prompt Mode"
          },
          "prompt": {
            "default": "",
            "examples": [
              "Return name and description in english."
            ],
            "type": "string",
            "description": "Optional instructions describing which elements to separate. When empty, the model automatically separates the major elements. Normalized `<bbox>left top right bottom</bbox>` tags may be used for precise coordinate targeting.",
            "title": "Prompt"
          },
          "image_size": {
            "default": "auto",
            "examples": [
              "auto"
            ],
            "type": "string",
            "description": "Resolution tier for the output base image and layers. `auto` adapts to the input image while preserving each element's aspect ratio.",
            "enum": [
              "auto",
              "auto_1K",
              "auto_1.5K",
              "auto_2K"
            ],
            "title": "Image Size"
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode"
          },
          "image_url": {
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/kontext_example_input.webp"
            ],
            "type": "string",
            "description": "URL of the image to decompose into a base image and independently editable layers. The image must contain between 512x512 and 6000x6000 total pixels, have an aspect ratio between 1/16 and 16, and be no larger than 30 MB.",
            "title": "Image Url"
          },
          "enable_safety_checker": {
            "default": true,
            "examples": [
              true
            ],
            "type": "boolean",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker"
          }
        }
      },
      "SeedreamV5ProLayerizeOutput": {
        "title": "SeedDream50ProLayerizeOutput",
        "x-fal-order-properties": [
          "images",
          "layers"
        ],
        "required": [
          "images",
          "layers"
        ],
        "type": "object",
        "properties": {
          "layers": {
            "items": {
              "$ref": "#/components/schemas/SeedDream50ProLayer"
            },
            "type": "array",
            "description": "The base image followed by up to 16 separated layers, ordered by increasing z_index.",
            "title": "Layers"
          },
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0aa54c02/95ZvKubW63JnC9ubRbDo2_74290e95fb6d4bd4bac756f3e2667317.png"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array",
            "description": "The same images as `layers`, in the same order, flattened for gallery rendering.",
            "title": "Images"
          }
        }
      },
      "SeedDream50ProLayer": {
        "title": "SeedDream50ProLayer",
        "x-fal-order-properties": [
          "image",
          "z_index",
          "bounding_box",
          "name",
          "description"
        ],
        "required": [
          "image",
          "z_index"
        ],
        "type": "object",
        "properties": {
          "image": {
            "$ref": "#/components/schemas/Image",
            "description": "The generated base image or separated layer."
          },
          "z_index": {
            "maximum": 16,
            "minimum": 0,
            "type": "integer",
            "description": "Stacking order from bottom to top. The base image always has z_index 0.",
            "title": "Z Index"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Detailed model-generated description of the layer. Omitted for the base image.",
            "title": "Description"
          },
          "bounding_box": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SeedDream50ProLayerBoundingBox"
              },
              {
                "type": "null"
              }
            ],
            "description": "The layer's position in the base image coordinate system. Omitted for the base image."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Model-generated label for the layer. Omitted for the base image.",
            "title": "Name"
          }
        }
      },
      "Image": {
        "properties": {
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels.",
            "title": "Width"
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels.",
            "title": "Height"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "description": "Represents an image file.",
        "type": "object",
        "title": "Image"
      },
      "SeedDream50ProLayerBoundingBox": {
        "title": "SeedDream50ProLayerBoundingBox",
        "x-fal-order-properties": [
          "absolute",
          "normalized"
        ],
        "required": [
          "absolute",
          "normalized"
        ],
        "type": "object",
        "properties": {
          "normalized": {
            "minItems": 4,
            "items": {
              "type": "integer"
            },
            "type": "array",
            "description": "Layer bounds as [left, top, right, bottom] coordinates normalized to the integer range [0, 1000].",
            "maxItems": 4,
            "title": "Normalized"
          },
          "absolute": {
            "minItems": 4,
            "items": {
              "type": "integer"
            },
            "type": "array",
            "description": "Layer bounds as [left, top, right, bottom] pixel coordinates in the output base image coordinate system.",
            "maxItems": 4,
            "title": "Absolute"
          }
        }
      }
    }
  },
