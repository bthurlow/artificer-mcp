      "endpointId": "alibaba/qwen-audio-3-tts",
      "category": "text-to-speech",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aa349bc/YEHFJNX5VLA0_mQTdsH8F.jpg",
      "playgroundUrl": "https://fal.ai/models/alibaba/qwen-audio-3-tts",
      "documentationUrl": "https://fal.ai/models/alibaba/qwen-audio-3-tts/api",
      "about": "Synthesize speech from text with Qwen-Audio-3.0-TTS (Flash)."
    }
  },
  "components": {
