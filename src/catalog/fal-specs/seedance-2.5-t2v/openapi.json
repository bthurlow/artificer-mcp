                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedance-2.5/text-to-video": {
      "post": {
        "requestBody": {
          "required": true,
