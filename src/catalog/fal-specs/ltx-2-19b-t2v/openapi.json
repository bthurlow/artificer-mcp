                "num_frames": 161,
                "url": "https://v3b.fal.media/files/b/0a8824b1/sdm0KfmenrlywesfzY1Y1_if6euPp1.mp4",
                "duration": 6.44,
                "width": 1248,
                "height": 704,
                "fps": 25
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "video",
          "seed",
          "prompt"
        ],
        "title": "LTX2TextToVideoOutput"
      },
