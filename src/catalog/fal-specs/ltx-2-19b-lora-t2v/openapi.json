{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2-19b/text-to-video/lora",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2-19b/text-to-video/lora queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2-19b/text-to-video/lora",
      "category": "text-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8936e2/Ys99LaAscUTgLjNHdoXe9_2d41aa966d6b473c9a63abb61cb65d38.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/text-to-video/lora",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2-19b/text-to-video/lora/api",
      "about": "Generate a video from a text prompt."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx219bTextToVideoLoraInput": {
        "title": "LTX2LoRATextToVideoInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "num_frames",
          "video_size",
          "generate_audio",
          "use_multiscale",
          "fps",
          "guidance_scale",
          "num_inference_steps",
          "acceleration",
          "camera_lora",
          "camera_lora_scale",
          "negative_prompt",
          "seed",
          "enable_prompt_expansion",
          "enable_safety_checker",
          "video_output_type",
          "video_quality",
          "video_write_mode",
          "sync_mode",
          "loras"
        ],
        "required": [
          "loras",
          "prompt"
        ],
        "properties": {
          "prompt": {
            "title": "Prompt",
            "examples": [
              "A cowboy walking through a dusty town at high noon, camera following from behind, cinematic depth, realistic lighting, western mood, 4K film grain."
            ],
            "type": "string",
            "description": "The prompt to generate the video from."
          },
          "num_frames": {
            "title": "Number of Frames",
            "type": "integer",
            "default": 121,
            "minimum": 9,
            "description": "The number of frames to generate.",
            "maximum": 481
          },
          "use_multiscale": {
            "title": "Use Multi-Scale",
            "type": "boolean",
            "description": "Whether to use multi-scale generation. If True, the model will generate the video at a smaller scale first, then use the smaller video to guide the generation of a video at or above your requested size. This results in better coherence and details.",
            "default": true
          },
          "video_quality": {
            "title": "Video Quality",
            "type": "string",
            "description": "The quality of the generated video.",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "default": "high"
          },
          "video_write_mode": {
            "title": "Video Write Mode",
            "type": "string",
            "description": "The write mode of the generated video.",
            "enum": [
              "fast",
              "balanced",
              "small"
            ],
            "default": "balanced"
          },
          "generate_audio": {
            "title": "Generate Audio",
            "type": "boolean",
            "description": "Whether to generate audio for the video.",
            "default": true
          },
          "video_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ]
              }
            ],
            "description": "The size of the generated video.",
            "title": "Video Size",
            "default": "landscape_4_3"
          },
          "enable_prompt_expansion": {
            "title": "Enable Prompt Expansion",
            "type": "boolean",
            "description": "Whether to enable prompt expansion.",
            "default": true
          },
          "acceleration": {
            "title": "Acceleration",
            "type": "string",
            "examples": [
              "regular"
            ],
            "description": "The acceleration level to use.",
            "enum": [
              "none",
              "regular",
              "high",
              "full"
            ],
            "default": "regular"
          },
          "fps": {
            "title": "FPS",
            "type": "number",
            "description": "The frames per second of the generated video.",
            "minimum": 1,
            "maximum": 60,
            "default": 25
          },
          "guidance_scale": {
            "title": "Guidance Scale",
            "type": "number",
            "description": "The guidance scale to use.",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "type": "boolean",
            "description": "Whether to enable the safety checker.",
            "default": true
          },
          "negative_prompt": {
            "title": "Negative Prompt",
            "type": "string",
            "description": "The negative prompt to generate the video from.",
            "default": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, grainy texture, poor lighting, flickering, motion blur, distorted proportions, unnatural skin tones, deformed facial features, asymmetrical face, missing facial features, extra limbs, disfigured hands, wrong hand count, artifacts around text, inconsistent perspective, camera shake, incorrect depth of field, background too sharp, background clutter, distracting reflections, harsh shadows, inconsistent lighting direction, color banding, cartoonish rendering, 3D CGI look, unrealistic materials, uncanny valley effect, incorrect ethnicity, wrong gender, exaggerated expressions, wrong gaze direction, mismatched lip sync, silent or muted audio, distorted voice, robotic voice, echo, background noise, off-sync audio,incorrect dialogue, added dialogue, repetitive speech, jittery movement, awkward pauses, incorrect timing, unnatural transitions, inconsistent framing, tilted camera, flat lighting, inconsistent tone, cinematic oversaturation, stylized filters, or AI artifacts."
          },
          "video_output_type": {
            "title": "Video Output Type",
            "type": "string",
            "description": "The output type of the generated video.",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
            ],
            "default": "X264 (.mp4)"
          },
          "num_inference_steps": {
            "title": "Number of Inference Steps",
            "type": "integer",
            "description": "The number of inference steps to use.",
            "minimum": 8,
            "maximum": 50,
            "default": 40
          },
          "camera_lora_scale": {
            "title": "Camera LoRA Scale",
            "type": "number",
            "description": "The scale of the camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "minimum": 0,
            "maximum": 1,
            "default": 1
          },
          "sync_mode": {
            "title": "Sync Mode",
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The seed for the random number generator.",
            "title": "Seed"
          },
          "camera_lora": {
            "title": "Camera LoRA",
            "type": "string",
            "examples": [
              "none"
            ],
            "description": "The camera LoRA to use. This allows you to control the camera movement of the generated video more accurately than just prompting the model to move the camera.",
            "enum": [
              "dolly_in",
              "dolly_out",
              "dolly_left",
              "dolly_right",
              "jib_up",
              "jib_down",
              "static",
              "none"
            ],
            "default": "none"
          },
          "loras": {
            "title": "LoRAs",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoRAInput"
            },
            "description": "The LoRAs to use for the generation."
          }
        }
      },
      "Ltx219bTextToVideoLoraOutput": {
        "title": "LTX2TextToVideoOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "prompt"
        ],
        "required": [
          "video",
          "seed",
          "prompt"
        ],
        "properties": {
          "video": {
            "examples": [
              {
                "content_type": "video/mp4",
                "fps": 25,
                "url": "https://v3b.fal.media/files/b/0a8824b1/sdm0KfmenrlywesfzY1Y1_if6euPp1.mp4",
                "duration": 6.44,
                "file_name": "sdm0KfmenrlywesfzY1Y1_if6euPp1.mp4",
                "num_frames": 161,
                "width": 1248,
                "height": 704
              }
            ],
            "$ref": "#/components/schemas/VideoFile",
            "description": "The generated video."
          },
          "prompt": {
            "title": "Prompt",
            "examples": [
              "A cowboy walking through a dusty town at high noon, camera following from behind, cinematic depth, realistic lighting, western mood, 4K film grain."
            ],
            "type": "string",
            "description": "The prompt used for the generation."
          },
          "seed": {
            "title": "Seed",
            "examples": [
              149063119
            ],
            "type": "integer",
            "description": "The seed used for the random number generator."
          }
        }
      },
      "ImageSize": {
        "title": "ImageSize",
        "type": "object",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "title": "Width",
            "type": "integer",
            "description": "The width of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "default": 512
          },
          "height": {
            "title": "Height",
            "type": "integer",
            "description": "The height of the generated image.",
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "default": 512
          }
        }
      },
      "LoRAInput": {
        "title": "LoRAInput",
        "type": "object",
        "description": "LoRA weight configuration.",
        "x-fal-order-properties": [
          "path",
          "weight_name",
          "scale"
        ],
        "properties": {
          "weight_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the LoRA weight. Only used if `path` is a HuggingFace repository, and is only required when the repository contains multiple LoRA weights.",
            "title": "Weight Name"
          },
          "path": {
            "title": "Path",
            "type": "string",
            "description": "URL, HuggingFace repo ID (owner/repo) to lora weights."
          },
          "scale": {
            "title": "Scale",
            "type": "number",
            "description": "Scale factor for LoRA application (0.0 to 4.0).",
            "minimum": 0,
            "maximum": 4,
            "default": 1
          }
        },
        "required": [
          "path"
        ]
      },
      "VideoFile": {
        "title": "VideoFile",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
