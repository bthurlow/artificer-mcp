        "properties": {
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "content_type": {
            "examples": [
              "image/png"
