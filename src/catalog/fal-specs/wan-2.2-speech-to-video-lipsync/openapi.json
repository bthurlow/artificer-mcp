{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/wan/v2.2-14b/speech-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/wan/v2.2-14b/speech-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/wan/v2.2-14b/speech-to-video",
      "category": "audio-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f92da/lZ3wuzCEnyWGYXU79XYYR_HEKI5ejC.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/wan/v2.2-14b/speech-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/wan/v2.2-14b/speech-to-video/api",
      "about": "Endpoint for generating a video from a speech."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "WanV2214bSpeechToVideoInput": {
        "required": [
          "prompt",
          "image_url",
          "audio_url"
        ],
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed for reproducibility. If None, a random seed is chosen."
          },
          "resolution": {
            "default": "480p",
            "examples": [
              "480p"
            ],
            "title": "Resolution",
            "description": "Resolution of the generated video (480p, 580p, or 720p).",
            "type": "string",
            "enum": [
              "480p",
              "580p",
              "720p"
            ]
          },
          "video_write_mode": {
            "default": "balanced",
            "examples": [
              "balanced"
            ],
            "title": "Video Write Mode",
            "description": "The write mode of the output video. Faster write mode means faster results but larger file size, balanced write mode is a good compromise between speed and quality, and small write mode is the slowest but produces the smallest file size.",
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "small"
            ]
          },
          "video_quality": {
            "default": "high",
            "examples": [
              "high"
            ],
            "title": "Video Quality",
            "description": "The quality of the output video. Higher quality means better visual quality but larger file size.",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ]
          },
          "enable_safety_checker": {
            "default": false,
            "examples": [
              true
            ],
            "title": "Enable Safety Checker",
            "description": "If set to true, input data will be checked for safety before processing. Disabling it requires account authorization; unauthorized requests are always checked.",
            "type": "boolean"
          },
          "num_frames": {
            "default": 80,
            "minimum": 40,
            "title": "Number of Frames",
            "multipleOf": 4,
            "maximum": 120,
            "examples": [
              80
            ],
            "description": "Number of frames to generate. Must be between 40 to 120, (must be multiple of 4).",
            "type": "integer"
          },
          "guidance_scale": {
            "default": 3.5,
            "minimum": 1,
            "title": "Guidance Scale",
            "description": "Classifier-free guidance scale. Higher values give better adherence to the prompt but may decrease quality.",
            "examples": [
              3.5
            ],
            "type": "number",
            "maximum": 10
          },
          "prompt": {
            "examples": [
              "Summer beach vacation style, a white cat wearing sunglasses sits on a surfboard."
            ],
            "title": "Prompt",
            "description": "The text prompt used for video generation.",
            "type": "string"
          },
          "enable_output_safety_checker": {
            "default": false,
            "examples": [
              false
            ],
            "title": "Enable Output Safety Checker",
            "description": "If set to true, output video will be checked for safety after generation.",
            "type": "boolean"
          },
          "negative_prompt": {
            "default": "",
            "title": "Negative Prompt",
            "description": "Negative prompt for video generation.",
            "type": "string"
          },
          "image_url": {
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/wan_s2v_cat.png"
            ],
            "title": "Image URL",
            "description": "URL of the input image. If the input image does not match the chosen aspect ratio, it is resized and center cropped.",
            "type": "string"
          },
          "frames_per_second": {
            "default": 16,
            "anyOf": [
              {
                "minimum": 4,
                "type": "integer",
                "maximum": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Frames per Second",
            "description": "Frames per second of the generated video. Must be between 4 to 60. When using interpolation and `adjust_fps_for_interpolation` is set to true (default true,) the final FPS will be multiplied by the number of interpolated frames plus one. For example, if the generated frames per second is 16 and the number of interpolated frames is 1, the final frames per second will be 32. If `adjust_fps_for_interpolation` is set to false, this value will be used as-is.",
            "examples": [
              16
            ]
          },
          "shift": {
            "default": 5,
            "minimum": 1,
            "title": "Shift",
            "description": "Shift value for the video. Must be between 1.0 and 10.0.",
            "examples": [
              5
            ],
            "type": "number",
            "maximum": 10
          },
          "audio_url": {
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/wan_s2v_talk.wav"
            ],
            "title": "Audio URL",
            "description": "The URL of the audio file.",
            "type": "string"
          },
          "num_inference_steps": {
            "default": 27,
            "minimum": 2,
            "title": "Number of Inference Steps",
            "description": "Number of inference steps for sampling. Higher values give better quality but take longer.",
            "examples": [
              27
            ],
            "type": "integer",
            "maximum": 40
          }
        },
        "title": "WanS2VRequest",
        "x-fal-order-properties": [
          "prompt",
          "negative_prompt",
          "num_frames",
          "frames_per_second",
          "seed",
          "resolution",
          "num_inference_steps",
          "enable_safety_checker",
          "enable_output_safety_checker",
          "guidance_scale",
          "shift",
          "video_quality",
          "video_write_mode",
          "image_url",
          "audio_url"
        ],
        "type": "object"
      },
      "WanV2214bSpeechToVideoOutput": {
        "required": [
          "video"
        ],
        "properties": {
          "video": {
            "examples": [
              {
                "file_size": 4685303,
                "content_type": "application/octet-stream",
                "url": "https://v3.fal.media/files/panda/f7tXRCjvwEcVlmxHuw8kO_2c7ab2540af44eceaf5ffde4e8d094ed.mp4",
                "file_name": "2c7ab2540af44eceaf5ffde4e8d094ed.mp4"
              }
            ],
            "$ref": "#/components/schemas/File",
            "description": "The generated video file."
          }
        },
        "title": "WanS2VResponse",
        "x-fal-order-properties": [
          "video"
        ],
        "type": "object"
      },
      "File": {
        "required": [
          "url"
        ],
        "properties": {
          "file_size": {
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          },
          "content_type": {
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "file_name": {
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          }
        },
        "title": "File",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
