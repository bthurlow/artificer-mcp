{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for bytedance/seedream/v5/lite/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bytedance/seedream/v5/lite/edit queue.",
    "x-fal-metadata": {
      "endpointId": "bytedance/seedream/v5/lite/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9c2fb5/PIUPm_8kBdpdBoSkOebbz_bcfdbe1021324995bf3c36b05ab59c2c.jpg",
      "playgroundUrl": "https://fal.ai/models/bytedance/seedream/v5/lite/edit",
      "documentationUrl": "https://fal.ai/models/bytedance/seedream/v5/lite/edit/api",
      "about": "Edit images using Bytedance's SeedDream 5.0 Lite model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "SeedreamV5LiteEditInput": {
        "title": "SeedDream50LiteEditInput",
        "properties": {
          "output_format": {
            "title": "Output Format",
            "description": "The file format of the generated images.",
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "type": "string"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false,
            "type": "boolean"
          },
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "examples": [
              true
            ],
            "default": true,
            "type": "boolean"
          },
          "prompt": {
            "title": "Prompt",
            "description": "The text prompt used to edit the image",
            "examples": [
              "Replace the product in Figure 1 with that in Figure 2. Seamlessly render logo in Figure 3 into the product design, in frosted glass texture. Remove any extra text in Figure 1, and design a catchy tagline for the perfume."
            ],
            "type": "string"
          },
          "num_images": {
            "title": "Num Images",
            "description": "Number of separate model generations to be run with the prompt.",
            "minimum": 1,
            "maximum": 6,
            "default": 1,
            "type": "integer"
          },
          "watermark": {
            "title": "Watermark",
            "description": "Whether to add the provider's visible watermark.",
            "default": false,
            "type": "boolean"
          },
          "sequential_image_generation": {
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "disabled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Generate related images with `auto`, or one image per generation with `disabled`. When omitted, values of `max_images` above one enable `auto`.",
            "title": "Sequential Image Generation"
          },
          "max_images": {
            "title": "Max Images",
            "description": "Maximum images per generation in sequential mode. Ignored when sequential generation is disabled. Combined input references and outputs per generation cannot exceed 15.",
            "minimum": 1,
            "maximum": 15,
            "default": 1,
            "type": "integer"
          },
          "image_urls": {
            "title": "Image URLs",
            "description": "List of URLs of input images for editing. When more than 10 references are provided, only the last 10 are used.",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "https://v3b.fal.media/files/b/0a8f9936/KOsb_qPB_W0ZJ0Ee2OsnU_586e2892841d46f09049ee7199b303d3.png",
                "https://v3b.fal.media/files/b/0a8f994e/JroWTogO6jOTFk9b6B3XM_591ca38cef2f44bbba2843cbf80fb1b2.png",
                "https://v3b.fal.media/files/b/0a8f9960/Q6pzwXAiFaFPOpSScoE-D_0eca5db19e5242739f127efe49b38922.png"
              ]
            ],
            "type": "array"
          },
          "image_size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SeedreamLiteImageSize"
              },
              {
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto_2K",
                  "auto_3K",
                  "auto_4K"
                ],
                "type": "string"
              }
            ],
            "description": "The size of the generated image. Custom dimensions within the provider's pixel and aspect limits are sent unchanged. Other sizes use compatible scaling. The provider's native pixel range is 2560x1440 to 4096x4096, with aspect ratio between 1/16 and 16.",
            "title": "Image Size",
            "default": "auto_2K"
          }
        },
        "required": [
          "prompt",
          "image_urls"
        ],
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_images",
          "max_images",
          "sync_mode",
          "enable_safety_checker",
          "output_format",
          "watermark",
          "sequential_image_generation",
          "image_urls"
        ],
        "type": "object"
      },
      "SeedreamV5LiteEditOutput": {
        "title": "SeedDream50LiteEditOutput",
        "properties": {
          "images": {
            "title": "Images",
            "description": "Generated images",
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a8fbf56/wu9vcxO3xO6lkHv5zdiIs_7aa8564f6e4f4cc795ecb8e923deb2fb.png"
                }
              ]
            ],
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "description": "Seed used for generation.",
            "examples": [
              42
            ],
            "type": "integer"
          }
        },
        "required": [
          "images",
          "seed"
        ],
        "x-fal-order-properties": [
          "images",
          "seed"
        ],
        "type": "object"
      },
      "SeedreamLiteImageSize": {
        "title": "SeedreamLiteImageSize",
        "properties": {
          "height": {
            "title": "Height",
            "description": "The height of the generated image.",
            "maximum": 16384,
            "exclusiveMinimum": 0,
            "default": 512,
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "description": "The width of the generated image.",
            "maximum": 16384,
            "exclusiveMinimum": 0,
            "default": 512,
            "type": "integer"
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object"
      },
      "Image": {
        "title": "Image",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "properties": {
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          },
          "width": {
            "description": "The width of the image in pixels.",
            "examples": [
              1024
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "content_type": {
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "height": {
            "description": "The height of the image in pixels.",
            "examples": [
              1024
            ],
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "description": "Represents an image file."
      }
    }
  },
  "paths": {
    "/bytedance/seedream/v5/lite/edit/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/edit/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedreamV5LiteEditInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream/v5/lite/edit/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeedreamV5LiteEditOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
