{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bria/fibo-edit-1.5/product-holding",
    "version": "1.0.0",
    "description": "Bria Product Holding uses FIBO-Edit-1.5 to place a product in a person's hands or show the person carrying it. The endpoint accepts a person image and one to three product reference images, which can show packaging, another angle, or a companion item.\n\nAn optional instruction adds direction to the built-in product-holding instruction, such as which hand holds the product or whether its logo faces the camera. The output keeps the person image's aspect ratio unless an explicit aspect ratio is selected. A seed controls reproducibility, and sync mode can return the image directly in the response.\n\nUse cases include e-commerce lifestyle images, product listings, brand campaigns, and social commerce creative.",
    "x-fal-metadata": {
      "endpointId": "bria/fibo-edit-1.5/product-holding",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aaace30/icQi2Jfgz7oQDWifoEC_q.jpg",
      "playgroundUrl": "https://fal.ai/models/bria/fibo-edit-1.5/product-holding",
      "documentationUrl": "https://fal.ai/models/bria/fibo-edit-1.5/product-holding/api",
      "about": "Product Holding"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "FiboEdit15ProductHoldingInput": {
        "title": "ProductHoldingInputModel",
        "x-fal-order-properties": [
          "person_image_url",
          "product_image_urls",
          "instruction",
          "aspect_ratio",
          "seed",
          "sync_mode"
        ],
        "required": [
          "person_image_url",
          "product_image_urls"
        ],
        "properties": {
          "person_image_url": {
            "title": "Person Image Url",
            "description": "Photo of the person who will hold the product. Their identity, face, expression, clothing, pose and the background are preserved; only the arm and hand move.",
            "examples": [
              "https://labs-assets.bria.ai/fal-examples/fibo-edit-1.5/product-holding/person.jpg"
            ],
            "type": "string"
          },
          "seed": {
            "title": "Seed",
            "description": "Random seed. The same seed with the same inputs returns the same image.",
            "default": 5555,
            "type": "integer"
          },
          "aspect_ratio": {
            "title": "Aspect Ratio",
            "description": "Output aspect ratio. Left unset, the output keeps the ratio of the person image.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "4:5",
                  "5:4",
                  "9:16",
                  "16:9"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "instruction": {
            "title": "Instruction",
            "description": "Optional. A complete product-holding instruction already runs; this is appended to it. Use it for which hand, which way the label faces, or what must stay untouched.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Replace the paper coffee cup in her right hand with the can, logo facing the camera."
            ]
          },
          "product_image_urls": {
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Product Image Urls",
            "description": "One to three reference images of the product to place: extra angles, its packaging, or a companion item. They describe one holding scene rather than three separate products. The product's geometry, colors, materials, branding and label text are reproduced as given.",
            "examples": [
              [
                "https://labs-assets.bria.ai/fal-examples/fibo-edit-1.5/product-holding/product.jpg"
              ]
            ],
            "type": "array"
          },
          "sync_mode": {
            "title": "Sync Mode",
            "description": "Return the image inline in the response instead of as a hosted URL. Adds latency.",
            "default": false,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "FiboEdit15ProductHoldingOutput": {
        "title": "FiboEditOutputModel",
        "x-fal-order-properties": [
          "image",
          "images",
          "structured_instruction"
        ],
        "required": [
          "image",
          "structured_instruction"
        ],
        "properties": {
          "structured_instruction": {
            "title": "Structured Instruction",
            "description": "The structured instruction the model ran, expanded from the built-in instruction plus anything passed in `instruction`. Returned so you can see how the brief was interpreted.",
            "additionalProperties": true,
            "type": "object"
          },
          "images": {
            "title": "Images",
            "description": "Single-element list holding the same image, kept for callers of the earlier Fibo Edit endpoint.",
            "default": [],
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0aa6910f/ie5dAn55wDh7Y1adCFGyE_85a45d82c6d141c2a28d92367596dfac.png"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array"
          },
          "image": {
            "$ref": "#/components/schemas/Image",
            "description": "The edited image, in the source aspect ratio unless aspect_ratio was set."
          }
        },
        "type": "object"
      },
      "Image": {
        "title": "Image",
        "description": "Represents an image file.",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "properties": {
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          },
          "width": {
            "title": "Width",
            "description": "The width of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ]
          },
          "height": {
            "title": "Height",
            "description": "The height of the image in pixels.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ]
          },
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "paths": {
    "/bria/fibo-edit-1.5/product-holding/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/fibo-edit-1.5/product-holding/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bria/fibo-edit-1.5/product-holding": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FiboEdit15ProductHoldingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/bria/fibo-edit-1.5/product-holding/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiboEdit15ProductHoldingOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
