{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/elevenlabs/tts/eleven-v3",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/elevenlabs/tts/eleven-v3 queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/elevenlabs/tts/eleven-v3",
      "category": "text-to-audio",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91a8/oTkavdBnqhpPaT65B3FG8_euEcQphX.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/elevenlabs/tts/eleven-v3",
      "documentationUrl": "https://fal.ai/models/fal-ai/elevenlabs/tts/eleven-v3/api",
      "about": "Eleven V3"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "ElevenlabsTtsElevenV3Input": {
        "title": "TextToSpeechRequestV3",
        "properties": {
          "enable_safety_checker": {
            "title": "Enable Safety Checker",
            "description": "Check input content for safety. Disabling requires account authorization.",
            "default": true,
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "description": "The text to convert to speech",
            "type": "string",
            "maxLength": 5000,
            "examples": [
              "Hello! This is a test of the text to speech system, powered by ElevenLabs. How does it sound?"
            ],
            "minLength": 1
          },
          "timestamps": {
            "title": "Timestamps",
            "description": "Whether to return timestamps for each word in the generated speech",
            "default": false,
            "type": "boolean"
          },
          "voice": {
            "title": "Voice",
            "description": "The voice to use for speech generation",
            "default": "Rachel",
            "examples": [
              "Aria",
              "Roger",
              "Sarah",
              "Laura",
              "Charlie",
              "George",
              "Callum",
              "River",
              "Liam",
              "Charlotte",
              "Alice",
              "Matilda",
              "Will",
              "Jessica",
              "Eric",
              "Chris",
              "Brian",
              "Daniel",
              "Lily",
              "Bill"
            ],
            "type": "string"
          },
          "stability": {
            "title": "Stability",
            "minimum": 0,
            "default": 0.5,
            "description": "Voice stability (0-1)",
            "maximum": 1,
            "type": "number"
          },
          "language_code": {
            "title": "Language Code",
            "description": "Language code (ISO 639-1) used to enforce a language for the model.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_format": {
            "title": "Output Format",
            "description": "Output audio format (codec_sample_rate_bitrate). PCM is raw signed 16-bit little-endian audio, without a WAV header. PCM at 44.1 kHz requires an ElevenLabs Pro plan or above; MP3 at 192 kbps requires Creator or above.",
            "default": "mp3_44100_128",
            "enum": [
              "mp3_22050_32",
              "mp3_44100_32",
              "mp3_44100_64",
              "mp3_44100_96",
              "mp3_44100_128",
              "mp3_44100_192",
              "pcm_8000",
              "pcm_16000",
              "pcm_22050",
              "pcm_24000",
              "pcm_44100",
              "pcm_48000",
              "ulaw_8000",
              "alaw_8000",
              "opus_48000_32",
              "opus_48000_64",
              "opus_48000_96",
              "opus_48000_128",
              "opus_48000_192"
            ],
            "type": "string"
          },
          "apply_text_normalization": {
            "title": "Apply Text Normalization",
            "description": "This parameter controls text normalization with three modes: 'auto', 'on', and 'off'. When set to 'auto', the system will automatically decide whether to apply text normalization (e.g., spelling out numbers). With 'on', text normalization will always be applied, while with 'off', it will be skipped.",
            "default": "auto",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "description": "Request model for eleven_v3 which doesn't support previous_text/next_text",
        "x-fal-order-properties": [
          "text",
          "enable_safety_checker",
          "voice",
          "stability",
          "timestamps",
          "language_code",
          "apply_text_normalization",
          "output_format"
        ],
        "type": "object"
      },
      "ElevenlabsTtsElevenV3Output": {
        "title": "TTSOutput",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/File",
            "description": "The generated audio file",
            "examples": [
              {
                "url": "https://v3.fal.media/files/zebra/zJL_oRY8h5RWwjoK1w7tx_output.mp3"
              }
            ]
          },
          "timestamps": {
            "title": "Timestamps",
            "description": "Timestamps for each word in the generated speech. Only returned if `timestamps` is set to True in the request.",
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "audio"
        ],
        "x-fal-order-properties": [
          "audio",
          "timestamps"
        ],
        "type": "object"
      },
      "File": {
        "title": "File",
        "properties": {
          "content_type": {
            "title": "Content Type",
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "title": "Url",
            "description": "The URL where the file can be downloaded from.",
            "type": "string"
          },
          "file_size": {
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ]
          },
          "file_name": {
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ]
          }
        },
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "type": "object"
      }
    }
  },
  "paths": {
    "/fal-ai/elevenlabs/tts/eleven-v3/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/eleven-v3/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/eleven-v3": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElevenlabsTtsElevenV3Input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/elevenlabs/tts/eleven-v3/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElevenlabsTtsElevenV3Output"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
