{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltx-2.3-quality/audio-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltx-2.3-quality/audio-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltx-2.3-quality/audio-to-video",
      "category": "audio-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9c98bb/iw0BzMm847Vjzh0MWLarh_25gBsW6V.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/ltx-2.3-quality/audio-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/ltx-2.3-quality/audio-to-video/api",
      "about": "Generate an audio-driven video from audio and optional first frame."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Ltx23QualityAudioToVideoInput": {
        "required": [
          "prompt",
          "audio_url"
        ],
        "x-fal-order-properties": [
          "prompt",
          "audio_url",
          "image_url",
          "match_audio_length",
          "num_frames",
          "resolution",
          "frames_per_second",
          "num_inference_steps",
          "guidance_scale",
          "generate_audio",
          "image_strength",
          "negative_prompt",
          "seed",
          "enable_prompt_expansion",
          "enable_safety_checker",
          "video_quality",
          "video_write_mode",
          "sync_mode"
        ],
        "description": "Audio-to-video generation driven by an uploaded audio track.",
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility. If None, a random seed is chosen.",
            "title": "Seed"
          },
          "enable_safety_checker": {
            "description": "Whether to enable the safety checker.",
            "title": "Enable Safety Checker",
            "default": true,
            "type": "boolean"
          },
          "enable_prompt_expansion": {
            "description": "Whether to enable prompt expansion.",
            "title": "Enable Prompt Expansion",
            "default": true,
            "type": "boolean"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional URL of an image to use as the first frame. When omitted, generation runs from text and audio only.",
            "title": "Image URL",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/ltx-2-a2v-input-image.png"
            ]
          },
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "enum": [
                  "auto",
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9"
                ],
                "type": "string"
              }
            ],
            "description": "Final output size. 'auto' matches the input image aspect ratio when image_url is provided; otherwise it uses a landscape fallback.",
            "title": "Resolution",
            "default": "auto"
          },
          "match_audio_length": {
            "description": "When enabled, derives the number of frames from the audio duration and frames_per_second. When disabled, uses num_frames.",
            "title": "Match Audio Length",
            "default": true,
            "type": "boolean"
          },
          "guidance_scale": {
            "maximum": 20,
            "minimum": 1,
            "description": "Classifier-free guidance scale. The default is tuned for fast, high-quality generation.",
            "title": "Guidance Scale",
            "default": 1,
            "type": "number"
          },
          "frames_per_second": {
            "maximum": 60,
            "minimum": 1,
            "description": "Frames per second of the generated video.",
            "title": "FPS",
            "default": 24,
            "type": "number"
          },
          "generate_audio": {
            "description": "Whether to include audio in the returned video. When disabled, the final MP4 is returned without an audio track.",
            "title": "Generate Audio",
            "default": true,
            "type": "boolean"
          },
          "negative_prompt": {
            "description": "The negative prompt to steer generation away from.",
            "title": "Negative Prompt",
            "default": "color distortion, overexposure, static, blurry details, subtitles, style, artwork, painting, frame, still, dim overall tone, worst quality, low quality, JPEG compression artifacts, ugly, mutilated, extra fingers, poorly drawn hands, poorly drawn face, deformed, disfigured, malformed limbs, fused fingers, motionless frame, cluttered background, three legs, crowded background, walking backwards",
            "type": "string"
          },
          "sync_mode": {
            "description": "If True, the media is returned as a data URI inline in the response. Useful for short-lived requests and tests.",
            "title": "Sync Mode",
            "default": false,
            "type": "boolean"
          },
          "video_quality": {
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "description": "The quality preset of the generated video.",
            "title": "Video Quality",
            "default": "high",
            "type": "string"
          },
          "video_write_mode": {
            "enum": [
              "fast",
              "balanced",
              "small"
            ],
            "description": "The write mode of the generated video.",
            "title": "Video Write Mode",
            "default": "balanced",
            "type": "string"
          },
          "num_frames": {
            "maximum": 481,
            "minimum": 9,
            "description": "The number of frames to generate.",
            "title": "Number of Frames",
            "default": 121,
            "type": "integer"
          },
          "prompt": {
            "description": "The prompt to guide the audio-driven video generation.",
            "title": "Prompt",
            "type": "string",
            "examples": [
              "A person facing the camera sings with expressive natural motion, cinematic portrait lighting, realistic facial performance."
            ]
          },
          "image_strength": {
            "maximum": 1,
            "minimum": 0,
            "description": "Conditioning strength for the optional first frame. 1.0 keeps the image more strictly; lower values give the model more freedom.",
            "title": "Image Strength",
            "default": 0.7,
            "type": "number"
          },
          "num_inference_steps": {
            "maximum": 30,
            "minimum": 8,
            "description": "Number of inference steps. Defaults to 15 and can be increased up to 30.",
            "title": "Number of Inference Steps",
            "default": 15,
            "type": "integer"
          },
          "audio_url": {
            "description": "The URL of the audio track that drives generation.",
            "title": "Audio URL",
            "type": "string",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/ltx-2-a2v-input-audio.mp3"
            ]
          }
        },
        "title": "LTX23QualityAudioToVideoInput",
        "type": "object"
      },
      "Ltx23QualityAudioToVideoOutput": {
        "required": [
          "video",
          "seed",
          "prompt"
        ],
        "x-fal-order-properties": [
          "video",
          "seed",
          "prompt"
        ],
        "description": "Standard output for every endpoint on this app.",
        "properties": {
          "seed": {
            "description": "The seed actually used for generation.",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video."
          },
          "prompt": {
            "description": "The prompt used for generation (after any expansion).",
            "title": "Prompt",
            "type": "string"
          }
        },
        "title": "LTX23QualityOutput",
        "type": "object"
      },
      "ImageSize": {
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "title": "ImageSize",
        "properties": {
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The width of the generated image.",
            "title": "Width",
            "default": 512,
            "type": "integer"
          },
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 14142,
            "description": "The height of the generated image.",
            "title": "Height",
            "default": 512,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "File": {
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ],
        "title": "File",
        "properties": {
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "examples": [
              4404019
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "paths": {
