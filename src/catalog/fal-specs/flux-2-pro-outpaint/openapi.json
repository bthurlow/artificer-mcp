{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2-pro/outpaint",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-2-pro/outpaint queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-2-pro/outpaint",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9a3cce/-REF_qGgpSuwSJ0NGjEYo_d68ad106f4174e0d8fb68c3551e6bc86.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-2-pro/outpaint",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-2-pro/outpaint/api",
      "about": "Expand an image beyond its borders using BFL FLUX Outpainting.\n\nProvide a reference image plus per-side expansion amounts; FLUX\nOutpainting paints a coherent scene extension at the model level so the\nnew pixels match the existing content without seams or texture drift."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "Flux2ProOutpaintInput": {
        "type": "object",
        "title": "Flux2ProOutpaintInput",
        "properties": {
          "expand_right": {
            "type": "integer",
            "title": "Expand Right",
            "maximum": 2048,
            "description": "Pixels to expand on the right of the image.",
            "default": 0,
            "examples": [
              200
            ],
            "minimum": 0
          },
          "expand_left": {
            "type": "integer",
            "title": "Expand Left",
            "maximum": 2048,
            "description": "Pixels to expand on the left of the image.",
            "default": 0,
            "examples": [
              200
            ],
            "minimum": 0
          },
          "mode": {
            "type": "string",
            "enum": [
              "high",
              "fast"
            ],
            "description": "Quality/speed trade-off for outpainting. `high` (default) delivers the highest-fidelity results; `fast` is significantly faster and extends most scenes well but may produce lower fidelity.",
            "title": "Mode",
            "default": "high",
            "examples": [
              "high"
            ]
          },
          "image_url": {
            "type": "string",
            "title": "Image URL",
            "description": "The image URL to expand using outpainting.",
            "examples": [
              "https://v3b.fal.media/files/b/0a9a3ba3/s-Z4TGRh9EQwXWTWrvzaB_Nbqhm4Fl.png"
            ]
          },
          "sync_mode": {
            "type": "boolean",
            "title": "Sync Mode",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false
          },
          "enable_safety_checker": {
            "type": "boolean",
            "title": "Enable Safety Checker",
            "description": "Whether to enable the safety checker. Disabling it requires account authorization; unauthorized requests are always checked.",
            "default": true
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ],
            "description": "The format of the generated image.",
            "title": "Output Format",
            "default": "jpeg"
          },
          "auto_crop": {
            "type": "boolean",
            "title": "Auto Crop",
            "description": "Whether to automatically crop the reference image when the expanded canvas does not fully contain it.",
            "default": false
          },
          "expand_bottom": {
            "type": "integer",
            "title": "Expand Bottom",
            "maximum": 2048,
            "description": "Pixels to expand at the bottom of the image.",
            "default": 0,
            "examples": [
              200
            ],
            "minimum": 0
          },
          "expand_top": {
            "type": "integer",
            "title": "Expand Top",
            "maximum": 2048,
            "description": "Pixels to expand at the top of the image.",
            "default": 0,
            "examples": [
              0
            ],
            "minimum": 0
          }
        },
        "x-fal-order-properties": [
          "image_url",
          "expand_top",
          "expand_bottom",
          "expand_left",
          "expand_right",
          "auto_crop",
          "mode",
          "enable_safety_checker",
          "output_format",
          "sync_mode"
        ],
        "required": [
          "image_url"
        ]
      },
      "Flux2ProOutpaintOutput": {
        "type": "object",
        "title": "Flux2ProOutpaintOutput",
        "properties": {
          "images": {
            "type": "array",
            "title": "Images",
            "description": "The outpainted images.",
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0a9a3c6d/csgZL8-uzDQz2DIIzKVNZ_HJX1XzZU.jpg"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/ImageFile"
            }
          }
        },
        "x-fal-order-properties": [
          "images"
        ],
        "required": [
          "images"
        ]
      },
      "ImageFile": {
        "type": "object",
        "title": "ImageFile",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height",
            "description": "The height of the image"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ]
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ]
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width",
            "description": "The width of the image"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/fal-ai/flux-2-pro/outpaint/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2-pro/outpaint/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2-pro/outpaint": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Flux2ProOutpaintInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/flux-2-pro/outpaint/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flux2ProOutpaintOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
