{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/ltxv-13b-098-distilled",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/ltxv-13b-098-distilled queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/ltxv-13b-098-distilled",
