{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for bytedance/seedream/v5/flash/edit",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the bytedance/seedream/v5/flash/edit queue.",
    "x-fal-metadata": {
      "endpointId": "bytedance/seedream/v5/flash/edit",
      "category": "image-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aab903d/8fs77Yt08HBZklDGpbY70.jpg",
      "playgroundUrl": "https://fal.ai/models/bytedance/seedream/v5/flash/edit",
      "documentationUrl": "https://fal.ai/models/bytedance/seedream/v5/flash/edit/api",
      "about": "Edit images using Bytedance's Seedream 5.0 Flash model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "SeedreamV5FlashEditInput": {
        "title": "SeedDream50FlashEditInput",
        "x-fal-order-properties": [
          "prompt",
          "image_size",
          "num_images",
          "output_format",
          "sync_mode",
          "enable_safety_checker",
          "image_urls"
        ],
        "required": [
          "prompt",
          "image_urls"
        ],
        "type": "object",
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "examples": [
              true
            ],
            "type": "boolean",
            "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked.",
            "title": "Enable Safety Checker"
          },
          "prompt": {
            "examples": [
              "Replace the product in Figure 1 with that in Figure 2. Seamlessly render the logo in Figure 3 into the product design, in a frosted glass texture."
            ],
            "type": "string",
            "description": "The text prompt used to edit the image.",
            "title": "Prompt"
          },
          "image_size": {
            "default": "auto_2K",
            "examples": [
              "auto_2K"
            ],
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto_1K",
                  "auto_2K"
                ]
              }
            ],
            "x-fal": {
              "max_area": 4194304,
              "max_aspect_ratio": 16,
              "min_area": 1048576,
              "min_aspect_ratio": 0.0625
            },
            "description": "The size of the generated image. Total pixels must be between 1024x1024 and 2048x2048, with aspect ratio between 1/16 and 16.",
            "title": "Image Size"
          },
          "sync_mode": {
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode"
          },
          "image_urls": {
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/example_inputs/seedreamv45/seedream_v45_edit_input_1.png",
                "https://storage.googleapis.com/falserverless/example_inputs/seedreamv45/seedream_v45_edit_input_2.png",
                "https://storage.googleapis.com/falserverless/example_inputs/seedreamv45/seedream_v45_edit_input_3.png"
              ]
            ],
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "List of URLs of input reference images. Up to 10 images are supported; if more are sent, only the last 10 are used.",
            "title": "Image URLs"
          },
          "num_images": {
            "maximum": 6,
            "default": 1,
            "minimum": 1,
            "type": "integer",
            "description": "Number of separate model generations to run with the prompt.",
            "title": "Num Images"
          },
          "output_format": {
            "default": "jpeg",
            "examples": [
              "jpeg"
            ],
            "type": "string",
            "description": "The file format of the generated image.",
            "enum": [
              "jpeg",
              "png"
            ],
            "title": "Output Format"
          }
        }
      },
      "SeedreamV5FlashEditOutput": {
        "title": "SeedDream50ProEditOutput",
        "x-fal-order-properties": [
          "images"
        ],
        "required": [
          "images"
        ],
        "type": "object",
        "properties": {
          "images": {
            "examples": [
              [
                {
                  "url": "https://v3b.fal.media/files/b/0aa16df4/L8veDBOTxHhmpO5wQnioS_14c2d9c1736b4803a43796669c6d4fca.png"
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "type": "array",
            "description": "Generated images.",
            "title": "Images"
          }
        }
      },
      "ImageSize": {
        "title": "ImageSize",
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "maximum": 14142,
            "exclusiveMinimum": 0,
            "default": 512,
            "type": "integer",
            "description": "The width of the generated image.",
            "title": "Width"
          },
          "height": {
            "maximum": 14142,
            "exclusiveMinimum": 0,
            "default": 512,
            "type": "integer",
            "description": "The height of the generated image.",
            "title": "Height"
          }
        }
      },
      "Image": {
        "properties": {
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ],
            "description": "The width of the image in pixels.",
            "title": "Width"
          },
          "url": {
            "type": "string",
            "description": "The URL where the file can be downloaded from.",
            "title": "Url"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "image/png"
            ],
            "description": "The mime type of the file.",
            "title": "Content Type"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              4404019
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              1024
            ],
            "description": "The height of the image in pixels.",
            "title": "Height"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "required": [
          "url"
        ],
        "description": "Represents an image file.",
        "type": "object",
        "title": "Image"
      }
    }
  },
  "paths": {
