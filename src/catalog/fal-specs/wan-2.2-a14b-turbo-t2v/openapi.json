            "examples": [
              true
            ],
            "default": false
          },
          "video_quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ],
            "description": "The quality of the output video. Higher quality means better visual quality but larger file size.",
            "title": "Video Quality",
            "examples": [
              "high"
            ],
            "default": "high"
          },
          "seed": {
            "description": "Random seed for reproducibility. If None, a random seed is chosen.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "acceleration": {
            "type": "string",
            "enum": [
              "none",
              "regular"
