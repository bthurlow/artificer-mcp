{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for sonilo/v1.1/text-to-music",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the sonilo/v1.1/text-to-music queue.",
    "x-fal-metadata": {
      "endpointId": "sonilo/v1.1/text-to-music",
      "category": "text-to-audio",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9cce58/2fkn-QJvDeqArMhlb66vr_9e400a7a1fd841f38bed933eeb6aa3fe.jpg",
      "playgroundUrl": "https://fal.ai/models/sonilo/v1.1/text-to-music",
      "documentationUrl": "https://fal.ai/models/sonilo/v1.1/text-to-music/api",
      "about": "Text To Music"
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "V11TextToMusicInput": {
        "required": [
          "prompt"
        ],
        "title": "TextToMusicInput",
        "type": "object",
        "properties": {
          "duration": {
            "minimum": 1,
            "description": "Requested output duration in seconds (max 600). Also used for billing (one billable unit per second per sample, rounded up; each sample under 10s bills as 10s).",
            "title": "Duration",
            "type": "integer",
            "maximum": 600,
            "default": 90
          },
          "prompt": {
            "description": "Text prompt describing the music to generate.",
            "title": "Prompt",
            "type": "string",
            "examples": [
              "A blend of R&B warmth, soul depth, neo-soul texture, gospel spirit, pop clarity, and jazz sophistication."
            ]
          },
          "num_samples": {
            "minimum": 1,
            "description": "How many distinct music tracks to generate.",
            "title": "Num Samples",
            "type": "integer",
            "maximum": 3,
            "default": 1
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "duration",
          "num_samples"
        ]
      },
      "V11TextToMusicOutput": {
        "required": [
          "audio",
          "audios"
        ],
        "title": "TextToMusicOutput",
        "type": "object",
        "properties": {
          "audio": {
            "description": "The first generated music track, for quick preview/playback.",
            "$ref": "#/components/schemas/Audio",
            "examples": [
              {
                "content_type": "audio/mp4",
                "url": "https://fal.media/files/lion/SI-MFSBz0WtUMW4dAhhQs_jazz1.m4a",
                "file_name": "jazz1.m4a",
                "file_size": 3363482
              }
            ]
          },
          "audios": {
            "description": "All generated music tracks (AAC/m4a), one per sample.",
            "title": "Audios",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audio"
            },
            "examples": [
              [
                {
                  "content_type": "audio/mp4",
                  "url": "https://fal.media/files/lion/SI-MFSBz0WtUMW4dAhhQs_jazz1.m4a",
                  "file_name": "jazz1.m4a",
                  "file_size": 3363482
                }
              ]
            ]
          }
        },
        "x-fal-order-properties": [
          "audio",
          "audios"
        ]
      },
      "Audio": {
        "required": [
          "url"
        ],
        "title": "Audio",
        "type": "object",
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "title": "Content Type",
            "examples": [
              "image/png"
            ]
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "title": "File Name",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "title": "File Size",
            "examples": [
              4404019
            ]
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      }
    }
  },
  "paths": {
    "/sonilo/v1.1/text-to-music/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/sonilo/v1.1/text-to-music/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sonilo/v1.1/text-to-music": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V11TextToMusicInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/sonilo/v1.1/text-to-music/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V11TextToMusicOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
