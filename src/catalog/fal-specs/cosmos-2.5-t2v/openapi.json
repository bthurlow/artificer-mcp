{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/cosmos-predict-2.5/text-to-video",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/cosmos-predict-2.5/text-to-video queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/cosmos-predict-2.5/text-to-video",
      "category": "text-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a8fccfa/eYc-U5ezUgUhzx9Bw5rTM_8167b40fbaa04a2594d281b7fffcea68.jpg",
      "playgroundUrl": "https://fal.ai/models/fal-ai/cosmos-predict-2.5/text-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/cosmos-predict-2.5/text-to-video/api",
      "about": "Generate a video from a text prompt using Cosmos Predict 2.5 2B (post-trained)."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "CosmosPredict25TextToVideoInput": {
        "properties": {
          "video_quality": {
            "default": "high",
            "title": "Video Quality",
            "description": "The quality of the output video.",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "maximum"
            ]
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "type": "boolean",
            "default": false
          },
          "num_frames": {
            "description": "Number of frames to generate. Must be between 9 and 93.",
            "title": "Number of Frames",
            "minimum": 9,
            "maximum": 93,
            "type": "integer",
            "default": 93
          },
          "num_inference_steps": {
            "description": "Number of denoising steps. More steps yield higher quality but take longer.",
            "title": "Number of Inference Steps",
            "minimum": 1,
            "maximum": 50,
            "type": "integer",
            "default": 35
          },
          "prompt": {
            "title": "Prompt",
            "examples": [
              "A static, locked-off camera frames an industrial conveyor belt steadily transporting rough rocks through a dimly lit quarry processing facility. The belt runs horizontally across the center of the frame, its thick black rubber surface textured with dust and fine gravel. Jagged gray and brown stones of varying sizes tumble forward in a slow, continuous motion, their sharp edges catching the light. Subtle vibrations ripple through the belt’s surface as small pebbles bounce and shift. In the background, blurred steel beams, pipes, and muted industrial machinery create depth without distraction. Cool, diffused overhead lighting casts soft shadows and highlights the gritty textures, emphasizing dust particles in the air and the raw, rugged surfaces of the rocks."
            ],
            "type": "string",
            "description": "The text prompt describing the video to generate."
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducible generation."
          },
          "video_output_type": {
            "default": "X264 (.mp4)",
            "title": "Video Output Type",
            "description": "The format of the output video.",
            "type": "string",
            "enum": [
              "X264 (.mp4)",
              "VP9 (.webm)",
              "PRORES4444 (.mov)",
              "GIF (.gif)"
            ]
          },
          "guidance_scale": {
            "description": "Classifier-free guidance scale. Higher values increase prompt adherence.",
            "title": "Guidance Scale",
            "minimum": 1,
            "maximum": 20,
            "type": "number",
            "default": 7
          },
          "negative_prompt": {
            "description": "A negative prompt to guide generation away from undesired content.",
            "title": "Negative Prompt",
            "type": "string",
            "default": "The video captures a series of frames showing ugly scenes, static with no motion, motion blur, over-saturation, shaky footage, low resolution, grainy texture, pixelated images, poorly lit areas, underexposed and overexposed scenes, poor color balance, washed out colors, choppy sequences, jerky movements, low frame rate, artifacting, color banding, unnatural transitions, outdated special effects, fake elements, unconvincing visuals, poorly edited content, jump cuts, visual noise, and flickering. Overall, the video is of poor quality."
          }
        },
        "title": "TextToVideoInput",
        "x-fal-order-properties": [
          "prompt",
          "negative_prompt",
          "num_frames",
          "num_inference_steps",
          "guidance_scale",
          "seed",
          "sync_mode",
          "video_output_type",
          "video_quality"
        ],
        "type": "object",
        "required": [
          "prompt"
        ]
      },
      "CosmosPredict25TextToVideoOutput": {
        "properties": {
          "seed": {
            "title": "Seed",
            "type": "integer",
            "description": "The random seed used for generation."
          },
          "video": {
            "examples": [
              {
                "content_type": "video/mp4",
                "url": "https://v3b.fal.media/files/b/0a8fabc5/qAi19s0dSuQHDZ3O7D_HV_FkSwbls1.mp4"
              }
            ],
            "description": "The generated video file.",
            "$ref": "#/components/schemas/VideoFile"
          }
        },
        "title": "VideoOutput",
        "x-fal-order-properties": [
          "video",
          "seed"
        ],
        "type": "object",
        "required": [
          "video",
          "seed"
        ]
      },
      "VideoFile": {
        "properties": {
          "file_size": {
            "title": "File Size",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ]
          },
          "num_frames": {
            "title": "Num Frames",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The number of frames in the video"
          },
          "fps": {
            "title": "Fps",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The FPS of the video"
          },
          "duration": {
            "title": "Duration",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The duration of the video"
          },
          "file_name": {
            "title": "File Name",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ]
          },
          "width": {
            "title": "Width",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the video"
          },
          "content_type": {
            "title": "Content Type",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ]
          },
          "height": {
            "title": "Height",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the video"
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The URL where the file can be downloaded from."
          }
        },
        "title": "VideoFile",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height",
          "fps",
          "duration",
          "num_frames"
        ],
        "type": "object",
        "required": [
          "url"
        ]
      }
    }
  },
  "paths": {
    "/fal-ai/cosmos-predict-2.5/text-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          },
          {
            "name": "logs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Whether to include logs (`1`) in the response or not (`0`)."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/cosmos-predict-2.5/text-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Whether the request was cancelled successfully."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/cosmos-predict-2.5/text-to-video": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CosmosPredict25TextToVideoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            }
          }
        }
      }
    },
    "/fal-ai/cosmos-predict-2.5/text-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Request ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result of the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CosmosPredict25TextToVideoOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
